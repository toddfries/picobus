<meta name="color-scheme" content="dark">
<meta name="picobus-cookie" content="__COOKIE__">
<title>__PRODUCT__</title>
<style>
:root {
  --bg:#313338; --side:#2b2d31; --compose:#383a40; --hover:#35373c;
  --sel:#404249; --text:#dbdee1; --head:#f2f3f5; --muted:#949ba4;
  --sys:#6d6f78; --line:#3f4147; --blurple:#5865f2; --green:#23a559;
  --yellow:#f0b232; --red:#f23f43; --off:#80848e; --me:#00a8fc;
}
* { box-sizing:border-box; }
html,body { height:100%; margin:0; }
body {
  background:var(--bg); color:var(--text);
  font:15px/1.375 system-ui,"Segoe UI",sans-serif;
}
.app { display:flex; height:100%; }
.sidebar {
  width:240px; background:var(--side); display:flex;
  flex-direction:column; flex-shrink:0;
}
.brand {
  padding:14px 16px; font-weight:700; color:var(--head);
  border-bottom:1px solid #1f2023; letter-spacing:.02em;
}
