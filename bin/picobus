# picobus — hub socket, NDJSON bus, FastCGI, and the web UI, including
# first-run signup. Agents join by connecting and sending a register
# message. Roster and Love Equation scoring are not this program.

use strict;
use warnings;
use IO::Socket::UNIX;
use IO::Select;
use JSON::PP qw(encode_json decode_json);
use FCGI;
use POSIX qw(strftime);
use Errno qw(EAGAIN EWOULDBLOCK);
use Fcntl qw(F_GETFL F_SETFL O_NONBLOCK);
use FindBin;
use Digest::SHA qw(sha256_hex hmac_sha256_hex);
use MIME::Base64 qw(decode_base64);
$| = 1;

# ---------- config (env overrides; rc wrapper sets the service defaults) ----------
my $HUB_SOCK   = $ENV{HUB_SOCK}  // '/var/run/picoclaw/hub.sock';
my $HUB_GROUP  = $ENV{HUB_GROUP};    # optional; chown the hub socket to this group
my $FCGI_SOCK  = $ENV{FCGI_SOCK} // '/var/www/run/picoclaw/fcgi.sock';
my $MAX_LOG    = 50000;        # server history; the browser only gets one page
my $MAX_UPLOAD = 8 * 1024 * 1024;
my $SELECT_TO  = 0.5;          # seconds; keeps CPU near zero
# A thinking flag older than this is idle. The UI polls faster; this is the
# freeze backup when a gateway stops refreshing the bus.
my $ACTIVITY_STALE = 10;
if (defined $ENV{PICOBUS_ACTIVITY_STALE} && $ENV{PICOBUS_ACTIVITY_STALE} =~ /^[0-9]+$/) {
    $ACTIVITY_STALE = int($ENV{PICOBUS_ACTIVITY_STALE});
    $ACTIVITY_STALE = 1 if $ACTIVITY_STALE < 1;
}
my $UMASK      = 0117;         # socket perms 0660-ish after umask
my $STATE_DIR  = $ENV{PICOBUS_STATE} // '/var/picobus';
my $HUB_LOG    = $ENV{HUB_LOG}  // "$STATE_DIR/hub-events.ndjson";
my $CHAT_LOG     = $ENV{CHAT_LOG};
my $FILE_DIR     = $ENV{FILE_DIR};
my $SETUP_FILE   = $ENV{SETUP_FILE};
my $SECRETS_DIR  = $ENV{SECRETS_DIR};
my $SHARE_DIR    = $ENV{SHARE_DIR};
my $PICO_HOME    = $ENV{PICOCLAW_HOME};
my $PRODUCT       = $ENV{PICOBUS_PRODUCT} // 'picobus';
my $COOKIE_PREFIX = $ENV{PICOBUS_COOKIE}  // 'PICOBUS';
# ZHC publish: one existing /account/ session. No second password, no API-key form.
my $ZHC_GATE     = ($ENV{PICOBUS_ZHC_GATE} // '') eq '1';
my $ZHC_EMAIL    = $ENV{PICOBUS_ZHC_EMAIL} // 'todd@fdh.bz';
my $ZHC_COOKIE   = $ENV{PICOBUS_ZHC_COOKIE} // 'ZHCSESS_PROD';
my $ZHC_SESS_DIR = $ENV{PICOBUS_ZHC_SESSION_DIR} // '/var/www/tmp/php-sessions-zhc-prod';
my $ZHC_DB       = $ENV{PICOBUS_ZHC_DB} // '/var/www/data/escalate.sqlite';
# Set from the request path before a gated page or API is rendered.
my $ZHC_REQ_BUCKET = 'prod';
# -----------------------------------------

umask $UMASK;
unlink $HUB_SOCK if -e $HUB_SOCK;

my $hub = IO::Socket::UNIX->new(
    Local  => $HUB_SOCK,
    Type   => SOCK_STREAM,
    Listen => 32,
) or die "hub listen: $!\n";
$hub->blocking(0);
chmod 0660, $HUB_SOCK;
if (defined $HUB_GROUP && $HUB_GROUP ne '') {
    my $gid = getgrnam($HUB_GROUP);
    die "HUB_GROUP $HUB_GROUP: unknown group\n" unless defined $gid;
    my $uid = (stat $HUB_SOCK)[4];
    chown $uid, $gid, $HUB_SOCK or die "chown $HUB_SOCK :$HUB_GROUP: $!\n";
}

# OpenBSD: lock filesystem + promises after listen fd exists.
# HUB_NOSANDBOX=1 skips (debug only). Non-OpenBSD: no-op.
sub _parent_dir {
    my ($p) = @_;
    return unless defined $p && length $p;
    return $p if $p !~ m{/};
    $p =~ s{/[^/]+$}{};
    return length($p) ? $p : '/';
}

sub hub_sandbox {
    return if ($ENV{HUB_NOSANDBOX} // '') eq '1';
    return unless $^O eq 'openbsd';
    eval {
        require OpenBSD::Pledge;
        require OpenBSD::Unveil;
        OpenBSD::Pledge->import('pledge');
        OpenBSD::Unveil->import('unveil');
        1;
    } or return;
    my %dir;
    for my $p ($HUB_SOCK, $HUB_LOG, $FCGI_SOCK, $CHAT_LOG, $FILE_DIR, $SETUP_FILE, $SECRETS_DIR) {
        next unless defined $p && length $p;
        my $d = _parent_dir($p);
        $dir{$d} = 'rwc' if defined $d;
        $dir{$p} = 'rwc' if -d $p;
    }
    $dir{$FindBin::Bin} = 'rwc' if exists $dir{$FindBin::Bin};
    $dir{$FindBin::Bin} //= 'r';
    for my $p ($SHARE_DIR, '/usr/local/share/picobus') {
        next unless defined $p && length $p && -d $p;
        $dir{$p} = 'r';
        my $sh = "$p/shared";
        $dir{$sh} = 'r' if -d $sh;
        # Unveil is not recursive. Chrome icons live one directory down.
        my $dc = "$p/dc";
        $dir{$dc} = 'r' if -d $dc;
        my $icons = "$dc/icons";
        $dir{$icons} = 'r' if -d $icons;
    }
    if ($PICO_HOME) {
        mkdir $PICO_HOME, 0700 unless -d $PICO_HOME;
        $dir{$PICO_HOME} = 'rwc';
    }
    if ($ZHC_GATE) {
        if ($ZHC_SESS_DIR =~ m{\A/} && $ZHC_SESS_DIR !~ m{\.\.} && -d $ZHC_SESS_DIR) {
            $dir{$ZHC_SESS_DIR} = 'r';
        } else {
            die "ZHC session dir unavailable\n";
        }
        # Dev and qa are optional at startup. Prod keeps running if those
        # directories are not there yet. A request for a missing one is 401.
        for my $b (qw(dev qa)) {
            my $d = zhc_sess_dir_for($b);
            next unless defined $d && $d =~ m{\A/} && $d !~ m{\.\.} && -d $d;
            $dir{$d} = 'r';
        }
        if ($ZHC_DB =~ m{\A/} && $ZHC_DB !~ m{\.\.} && -f $ZHC_DB) {
            my $parent = _parent_dir($ZHC_DB);
            die "ZHC account db unavailable\n" unless $parent && -d $parent;
            $dir{$parent} = 'r' unless ($dir{$parent} // '') =~ /w/;
        } else {
            die "ZHC account db unavailable\n";
        }
    }
    for my $d (sort keys %dir) {
        unveil($d, $dir{$d}) or die "unveil $d: $!\n";
    }
    unveil() or die "unveil lock: $!\n";
    # fattr: chmod 0600 on secrets. error: unveil/pledge misses return EPERM
    # instead of killing the daemon (that was the Continue HTML-500).
    pledge(qw(stdio rpath wpath cpath unix fattr error)) or die "pledge: $!\n";
}

# Chat transcript + local file blobs (MinIO/S3 later; same URL shape).
$CHAT_LOG    //= (_parent_dir($HUB_LOG) || '.') . '/chat.ndjson';
$FILE_DIR    //= (_parent_dir($HUB_LOG) || '.') . '/files';
$SETUP_FILE  //= (_parent_dir($HUB_LOG) || '.') . '/setup.json';
$SECRETS_DIR //= (_parent_dir($HUB_LOG) || '.') . '/secrets';
if (!defined $SHARE_DIR || $SHARE_DIR eq '') {
    my $dev = "$FindBin::Bin/../share";
    $SHARE_DIR = (-d $dev) ? $dev : '/usr/local/share/picobus';
}
if (defined $SHARE_DIR && $SHARE_DIR =~ m{\.\.}) {
    require Cwd;
    my $abs = Cwd::abs_path($SHARE_DIR);
    $SHARE_DIR = $abs if defined $abs && $abs =~ m{\A/};
}
{
    my $state = _parent_dir($HUB_LOG);
    mkdir $state, 0755 if $state && !-d $state;
}
$PICO_HOME //= ($ENV{HOME} || '/root') . '/.picoclaw';
# umask is for the sockets. chmod restores the directory mode it would strip.
mkdir $FILE_DIR, 0755 unless -d $FILE_DIR;
chmod 0755, $FILE_DIR if -d $FILE_DIR;
# 0700 on purpose: session.key and llm secrets. Pico tokens must not
# live here. _picobus cannot search a 0700 parent, so picobus-pico
# dies at startup with "PICO_TOKEN_DIR required (Permission denied)".
# Tokens belong in $state/pico, a sibling of this directory.
mkdir $SECRETS_DIR, 0700 unless -d $SECRETS_DIR;
chmod 0700, $SECRETS_DIR if -d $SECRETS_DIR;
mkdir $PICO_HOME, 0700 unless -d $PICO_HOME;
chmod 0700, $PICO_HOME if defined $PICO_HOME && -d $PICO_HOME;

my $sel = IO::Select->new($hub);

# agent_id => { sock => $fh, buf => '' }
my %agents;
# reverse: fileno => agent_id
my %fd2id;
# channel_id => { id, kind => 'dm'|'group'|'system', name, members => [] }
my %channels;
my $HUB_BROADCAST = ($ENV{HUB_BROADCAST} // '') eq '1';
$channels{all} = {
    id      => 'all',
    kind    => 'system',
    name    => 'system',
    members => [],
};
my @log;   # chat history (capped); browser paginates, does not hold all of it

sub load_chat_log {
    return unless $CHAT_LOG && -f $CHAT_LOG;
    open my $fh, '<', $CHAT_LOG or return;
    while (my $line = <$fh>) {
        chomp $line;
        next unless length $line;
        my $obj = eval { decode_json($line) };
        next unless $obj && ref $obj eq 'HASH';
        push @log, $obj;
    }
    close $fh;
    shift @log while @log > $MAX_LOG;
}

load_chat_log();

sub append_ndjson {
    my ($path, $obj) = @_;
    return unless $path;
    open my $fh, '>>', $path or return;
    print $fh encode_json($obj), "\n";
    close $fh;
}

sub log_msg {
    my ($obj) = @_;
    $obj->{ts} //= strftime("%Y-%m-%dT%H:%M:%SZ", gmtime);
    push @log, $obj;
    shift @log while @log > $MAX_LOG;
    append_ndjson($CHAT_LOG, $obj);
    append_ndjson($HUB_LOG, $obj) if !$CHAT_LOG || $HUB_LOG ne $CHAT_LOG;
}

sub send_json {
    my ($fh, $obj) = @_;
    my $line = encode_json($obj) . "\n";
    # non-blocking best-effort; real production would queue
    syswrite($fh, $line) or return;
}

sub fanout_to_members {
    my ($obj, $members) = @_;
    my $from = $obj->{from} // '';
    for my $id (@$members) {
        next if $id eq '' || $id eq 'human' || $id eq $from;
        next unless $agents{$id} && $agents{$id}{sock};
        send_json($agents{$id}{sock}, $obj);
    }
}

sub ensure_dm_channel {
    my ($id) = @_;
    return unless defined $id && $id ne '' && $id ne 'human' && $id ne 'all';
    $channels{$id} ||= {
        id      => $id,
        kind    => 'dm',
        name    => $id,
        members => [ 'human', $id ],
    };
}

sub ensure_group_channel {
    my ($id, $name, $members) = @_;
    $id =~ s/[^\w:.\-]+/_/g;
    $id = "g:$id" unless $id =~ /^g:/;
    my @m = ('human');
    my %seen = ( human => 1 );
    for my $x (@{ $members || [] }) {
        next unless defined $x && $x ne '';
        next if $seen{$x}++;
        push @m, $x;
    }
    $channels{$id} = {
        id      => $id,
        kind    => 'group',
        name    => ($name || $id),
        members => \@m,
    };
    return $channels{$id};
}

sub refresh_team_group {
    my @m = ('human');
    my %seen = ( human => 1 );
    for my $id (keys %agents) {
        next if $id =~ /^anon-/ || $id eq '';
        next if $seen{$id}++;
        push @m, $id;
    }
    ensure_group_channel('g:team', 'team', \@m);
}

sub route_message {
    my ($obj) = @_;
    $obj->{to} = normalize_to($obj->{to});
    log_msg($obj);

    my $to = $obj->{to} // '';
    if (is_broadcast_to($to) || $to eq 'all') {
        # System log only. Work is never assigned via to=all unless lab flag.
        if ($HUB_BROADCAST) {
            fanout_to_members($obj, [ keys %agents ]);
        }
        return;
    }
    if (my $ch = $channels{$to}) {
        fanout_to_members($obj, $ch->{members} || []);
        return;
    }
    if (my $a = $agents{$to}) {
        ensure_dm_channel($to);
        send_json($a->{sock}, $obj);
        return;
    }
    send_json($agents{$obj->{from}}{sock}, {
        type => 'error', msg => "unknown target $to"
    }) if $obj->{from} && $agents{$obj->{from}};
}

sub handle_agent_line {
    my ($id, $line) = @_;
    my $obj = eval { decode_json($line) };
    return unless $obj && ref $obj eq 'HASH' && $obj->{type};

    if ($obj->{type} eq 'register') {
        $obj->{id} //= $id;
        bind_registered_agent($agents{$id}{sock}, $id, $obj->{id}, $agents{$id}{buf} // '');
        return;
    }
    if ($obj->{type} eq 'channel') {
        my $op = $obj->{op} // 'create';
        if ($op eq 'create') {
            my $ch = ensure_group_channel(
                $obj->{id} || ('g-' . int(time())),
                $obj->{name},
                $obj->{members} || [],
            );
            send_json($agents{$id}{sock}, { type => 'ack', channel => $ch->{id} })
                if $agents{$id};
        }
        return;
    }
    # Presence only. The connection id wins; a JSON from cannot spoof another berth.
    # Not fanned out and not written to the chat log.
    if (($obj->{type} // '') eq 'activity') {
        note_activity($id, $obj->{activity} // '');
        return;
    }
    $obj->{from} //= $id;
    route_message($obj);
}

sub note_activity {
    my ($id, $state) = @_;
    return unless defined $id && exists $agents{$id};
    return unless $state eq 'thinking' || $state eq 'idle';
    $agents{$id}{activity}    = $state;
    $agents{$id}{activity_at} = time();
}

sub activity_now {
    my ($id) = @_;
    my $a = $agents{$id} or return 'idle';
    return 'idle' unless ($a->{activity} // '') eq 'thinking';
    my $at = $a->{activity_at} // 0;
    return 'idle' if time() - $at >= $ACTIVITY_STALE;
    return 'thinking';
}

sub expire_stale_activity {
    my $now = time();
    for my $id (keys %agents) {
        my $a = $agents{$id} or next;
        next unless ($a->{activity} // '') eq 'thinking';
        my $at = $a->{activity_at} // 0;
        if ($now - $at >= $ACTIVITY_STALE) {
            $a->{activity} = 'idle';
        }
    }
}

# Take the berth name for this socket. A second socket for an id that is
# already up replaces it quietly: no extra online line, and the retired
# socket's later close is not an offline.
sub bind_registered_agent {
    my ($fh, $old_id, $new, $buf) = @_;
    return unless $fh && defined $new && $new ne '' && $new !~ /^(?:anon|gone)-/;
    my $fn = fileno($fh);
    return unless defined $fn;
    if (defined $old_id && $old_id ne $new && $old_id =~ /^anon-/) {
        delete $agents{$old_id};
    }
    my $already = 0;
    if (my $prev = $agents{$new}) {
        my $ps = $prev->{sock};
        if ($ps && defined fileno($ps)) {
            $already = 1;
            my $oldfn = fileno($ps);
            $fd2id{$oldfn} = "gone-$oldfn" if defined $oldfn && $oldfn != $fn;
        }
    }
    my $activity = $already ? $agents{$new}{activity} : undef;
    my $activity_at = $already ? $agents{$new}{activity_at} : undef;
    $agents{$new} = { sock => $fh, buf => (defined $buf ? $buf : '') };
    $agents{$new}{activity} = $activity if defined $activity;
    $agents{$new}{activity_at} = $activity_at if defined $activity_at;
    $fd2id{$fn} = $new;
    ensure_dm_channel($new);
    refresh_team_group();
    log_msg({ type => 'register', id => $new }) unless $already;
}

sub close_agent {
    my ($fh) = @_;
    my $fn = fileno($fh);
    my $id = delete $fd2id{$fn};
    if (defined $id && $id =~ /^anon-/) {
        delete $agents{$id};
    } elsif (defined $id && $id !~ /^gone-/) {
        my $cur = $agents{$id};
        if ($cur && $cur->{sock} && defined fileno($cur->{sock}) && fileno($cur->{sock}) == $fn) {
            delete $agents{$id};
            log_msg({ type => 'disconnect', id => $id });
        }
    }
    $sel->remove($fh);
    close $fh;
}

sub setup_secret {
    mkdir $SECRETS_DIR, 0700 unless -d $SECRETS_DIR;
    my $p = "$SECRETS_DIR/session.key";
    if (!-f $p) {
        my $k = sprintf('%08x%08x%08x%08x', map { int(rand(2**32)) } 1 .. 4);
        open my $fh, '>', $p or return 'dev-setup-key';
        print $fh $k;
        close $fh;
        chmod 0600, $p;
    }
    open my $fh, '<', $p or return 'dev-setup-key';
    my $k = <$fh>;
    close $fh;
    chomp $k;
    return $k || 'dev-setup-key';
}

sub load_setup {
    return unless $SETUP_FILE && -f $SETUP_FILE;
    open my $fh, '<', $SETUP_FILE or return;
    local $/;
    return eval { decode_json(<$fh>) };
}

sub setup_complete {
    my $s = load_setup();
    return $s && $s->{complete};
}

sub llm_configured {
    my $s = load_setup() || {};
    return 1 if $s->{llm_key};
    return 1 if -f "$SECRETS_DIR/security.yml";
    return 1 if -f '/root/.picoclaw/.security.yml';
    return 0;
}

sub bcrypt_hash {
    my ($pw) = @_;
    my @c = ('.', '/', 0 .. 9, 'A' .. 'Z', 'a' .. 'z');
    my $salt = join '', map { $c[ int rand @c ] } 1 .. 22;
    return crypt($pw, '$2b$10$' . $salt);
}

sub bcrypt_ok {
    my ($pw, $hash) = @_;
    return 0 unless $hash && $pw;
    my $c = crypt($pw, $hash);
    return defined $c && $c eq $hash;
}

# ALTCHA-compatible PoW (same protocol as zhc-altcha.php / altcha.org).
sub pow_challenge {
    my $max  = 100000;
    my $n    = 1 + int(rand($max));
    my $salt = sprintf('%08x%08x', time(), int(rand(2**32)));
    my $challenge = sha256_hex($salt . $n);
    my $sig       = hmac_sha256_hex($challenge, setup_secret());
    return {
        algorithm => 'SHA-256',
        challenge => $challenge,
        salt      => $salt,
        signature => $sig,
        maxnumber => $max,
    };
}

sub pow_ok {
    my ($challenge, $salt, $number, $sig) = @_;
    return 0 unless $challenge && $salt && defined $number && $sig;
    return 0 unless hmac_sha256_hex($challenge, setup_secret()) eq $sig;
    return sha256_hex($salt . $number) eq $challenge;
}

# Official ALTCHA widget posts `altcha` as base64(JSON{algorithm,challenge,number,salt,signature}).
sub parse_altcha {
    my ($obj) = @_;
    $obj ||= {};
    my ($ch, $salt, $n, $sig) = @$obj{qw(challenge salt number signature)};
    my $raw = $obj->{altcha} // '';
    if (length $raw) {
        my $txt = $raw;
        if ($txt !~ /^\s*\{/) {
            $txt = eval { decode_base64($raw) } // '';
        }
        if ($txt =~ /^\s*\{/) {
            my $p = eval { decode_json($txt) } || {};
            $ch   = $p->{challenge} // $ch;
            $salt = $p->{salt}      // $salt;
            $n    = $p->{number}    // $n;
            $sig  = $p->{signature} // $sig;
        }
    }
    return ($ch, $salt, $n, $sig);
}

sub http_date {
    return strftime('%a, %d %b %Y %H:%M:%S GMT', gmtime($_[0] || time));
}

sub share_file {
    my ($name) = @_;
    return unless $name && $name =~ /^[A-Za-z0-9._-]+$/;
    for my $root ($SHARE_DIR, '/usr/local/share/picobus') {
        next unless $root && length $root;
        my $p = "$root/shared/$name";
        return $p if -f $p;
    }
    return;
}

# /dc/chrome.js, /dc/chrome.css, /dc/icons/<name>.svg. No dot segments.
sub dc_asset_rel {
    my ($path) = @_;
    return unless defined $path;
    return $1 if $path =~ m{\A/dc/(chrome\.js|chrome\.css|icons/[a-z0-9]+(?:-[a-z0-9]+)*\.svg)\z};
    return;
}

sub dc_asset_file {
    my ($rel) = @_;
    return unless defined $rel && $rel !~ m{\.\.};
    for my $root ($SHARE_DIR, '/usr/local/share/picobus') {
        next unless defined $root && length $root;
        my $p = "$root/dc/$rel";
        my @st = lstat($p);
        next unless @st;
        next if -l _;
        next unless -f _;
        next if ($st[7] // 0) <= 0 || $st[7] > 262144;
        return $p;
    }
    return;
}

sub serve_dc_asset {
    my ($path) = @_;
    my $rel = dc_asset_rel($path);
    return 0 unless defined $rel;
    my $file = dc_asset_file($rel);
    my $s = '';
    my $n = 0;
    if ($file && open my $fh, '<:raw', $file) {
        $n = read($fh, $s, 262144);
        close $fh;
    }
    if (!$n) {
        fcgi_print('text/plain; charset=utf-8', "not found\n", '404 Not Found');
        return 1;
    }
    my $ct = 'application/octet-stream';
    $ct = 'text/css; charset=utf-8' if $rel =~ /\.css\z/;
    $ct = 'text/javascript; charset=utf-8' if $rel =~ /\.js\z/;
    $ct = 'image/svg+xml' if $rel =~ /\.svg\z/;
    fcgi_print($ct, $s);
    return 1;
}

sub write_llm_secrets {
    my ($base, $key, $mgmt) = @_;
    mkdir $SECRETS_DIR, 0700 unless -d $SECRETS_DIR;
    $base ||= 'https://openrouter.ai/api/v1';
    $base =~ s{/+$}{};
    my $alias = $ENV{PICOBUS_LLM_ALIAS} // 'default';
    if (open my $fh, '>', "$SECRETS_DIR/security.yml") {
        print $fh "model_list:\n  $alias:\n    api_keys:\n      - \"$key\"\n";
        print $fh "  openrouter-mgmt:\n    api_keys:\n      - \"$mgmt\"\n" if $mgmt;
        close $fh;
        chmod 0600, "$SECRETS_DIR/security.yml";
    }
    mkdir $PICO_HOME, 0700 unless -d $PICO_HOME;
    my $link = "$PICO_HOME/.security.yml";
    unlink $link if -l $link || -f $link;
    symlink "$SECRETS_DIR/security.yml", $link;
    my $model = 'nvidia/nemotron-3-ultra-550b-a55b:free';
    if (open my $cf, '>', "$PICO_HOME/config.json") {
        print $cf encode_json({
            agents => {
                defaults => {
                    model_name             => $alias,
                    workspace              => "$PICO_HOME/workspace",
                    restrict_to_workspace  => JSON::PP::true,
                    max_tokens             => 8192,
                },
            },
            model_list => [{
                name     => $alias,
                model    => $model,
                api_base => $base,
            }],
        });
        close $cf;
    }
    if (open my $mf, '>', "$SECRETS_DIR/llm.json") {
        print $mf encode_json({
            api_base     => $base,
            shared_key   => $mgmt ? JSON::PP::false : JSON::PP::true,
            has_mgmt_key => $mgmt ? JSON::PP::true : JSON::PP::false,
        });
        close $mf;
        chmod 0600, "$SECRETS_DIR/llm.json";
    }
}

sub save_setup {
    my ($obj) = @_;
    mkdir _parent_dir($SETUP_FILE), 0755;
    open my $fh, '>', $SETUP_FILE or return 0;
    print $fh encode_json($obj);
    close $fh;
    chmod 0600, $SETUP_FILE;
    return 1;
}

# ---------- FastCGI: Discord-alike UI + JSON API ----------
# POST: read CONTENT_LENGTH + STDIN (urlencoded forms AND JSON /api/send).
# QUERY_STRING still works for GET inject / ?format=json.

sub parse_urlencoded {
    my ($s) = @_;
    my %q;
    return \%q unless defined $s && length $s;
    for my $kv (split /[&;]/, $s) {
        next unless length $kv;
        my ($k, $v) = split /=/, $kv, 2;
        $v = '' unless defined $v;
        for ($k, $v) {
            tr/+/ /;
            s/%([0-9A-Fa-f]{2})/chr(hex($1))/ge;
        }
        $q{$k} = $v;
    }
    return \%q;
}

sub fcgi_path {
    my $uri = $ENV{REQUEST_URI} // '';
    $uri =~ s/\?.*//s;
    my $pi = $ENV{PATH_INFO}   // '';
    my $sn = $ENV{SCRIPT_NAME} // '';
    return $uri if $uri =~ m{/api/};
    return $pi  if $pi  =~ m{/api/};
    return $sn  if $sn  =~ m{/api/};
    return $uri if length $uri;
    return $pi  if length $pi;
    return length $sn ? $sn : '/';
}

# When set, handle_fcgi writes CGI bytes here instead of tied FCGI STDOUT.
my ($FCGI_BUF, $FCGI_STDIN_BUF);

sub fcgi_read_body {
    my ($cap) = @_;
    $cap ||= 65536;
    if (defined $FCGI_STDIN_BUF) {
        my $b = $FCGI_STDIN_BUF;
        $FCGI_STDIN_BUF = '';
        return $b;
    }
    my $len = $ENV{CONTENT_LENGTH};
    return '' unless defined $len && $len =~ /^\d+$/ && $len > 0;
    my $want = $len > $cap ? $cap : $len;
    my $buf = '';
    while (length($buf) < $want) {
        my $n = read(STDIN, my $chunk, $want - length($buf));
        last if !defined $n || $n == 0;
        $buf .= $chunk;
    }
    return $buf;
}

sub cgi_out {
    my ($headers, $body) = @_;
    $body //= '';
    if (zhc_gate() && $headers !~ /X-Content-Type-Options:/i) {
        $headers =~ s/\r\n\r\n/\r\nX-Content-Type-Options: nosniff\r\nX-Frame-Options: DENY\r\nReferrer-Policy: no-referrer\r\nX-Robots-Tag: noindex, nofollow\r\n\r\n/;
    }
    if (defined $FCGI_BUF) {
        $FCGI_BUF .= $headers . $body;
        return;
    }
    print $headers, $body;
}

sub fcgi_print {
    my ($ctype, $body, $status) = @_;
    $status //= '200 OK';
    cgi_out(
        "Status: $status\r\nCache-Control: no-store\r\nContent-Type: $ctype\r\n\r\n",
        $body
    );
}

sub json_out {
    my ($code, $obj, $hdr) = @_;
    $hdr ||= {};
    my %st = (
        200 => '200 OK',
        304 => '304 Not Modified',
        400 => '400 Bad Request',
        401 => '401 Unauthorized',
        403 => '403 Forbidden',
        404 => '404 Not Found',
        405 => '405 Method Not Allowed',
        413 => '413 Payload Too Large',
        503 => '503 Service Unavailable',
    );
    my $cc = $hdr->{cache} // 'no-store';
    my $extra = '';
    $extra .= 'ETag: "' . $hdr->{etag} . '"' . "\r\n" if $hdr->{etag};
    $extra .= 'Expires: ' . $hdr->{expires} . "\r\n" if $hdr->{expires};
    if ($code == 304) {
        cgi_out("Status: 304 Not Modified\r\nCache-Control: $cc\r\n${extra}\r\n");
        return;
    }
    my $body = encode_json($obj);
    cgi_out(
        "Status: " . ($st{$code} // "$code")
        . "\r\nCache-Control: $cc\r\n${extra}"
        . "Content-Type: application/json; charset=utf-8\r\n\r\n",
        $body
    );
}

sub normalize_to {
    my ($to) = @_;
    $to = '' unless defined $to;
    $to =~ s/^\s+|\s+$//g;
    my $lc = lc $to;
    return 'all' if $to eq '' || $lc eq 'all' || $lc eq 'broadcast'
        || $lc eq '#broadcast' || $lc eq 'everyone';
    $to =~ s/^@//;
    return $to;
}

sub inject_human_message {
    my ($to, $content, $files) = @_;
    $content = '' unless defined $content;
    $content =~ s/^\s+|\s+$//g;
    $files = [] unless $files && ref $files eq 'ARRAY';
    return 0 unless length $content || @$files;
    my $obj = {
        type    => 'message',
        from    => 'human',
        to      => normalize_to($to),
        content => $content,
        id      => 'h-' . time() . int(rand(1000)),
    };
    $obj->{files} = $files if @$files;
    route_message($obj);
    return 1;
}

sub hub_state_message {
    my ($m) = @_;
    my $out = {
        ts      => $m->{ts}      // '',
        type    => $m->{type}    // '',
        from    => $m->{from}    // '',
        to      => $m->{to}      // '',
        content => $m->{content} // $m->{msg} // '',
        id      => $m->{id}      // '',
    };
    if ($m->{files} && ref $m->{files} eq 'ARRAY' && @{$m->{files}}) {
        $out->{files} = $m->{files};
    }
    return $out;
}

sub is_broadcast_to {
    my ($to) = @_;
    $to = '' unless defined $to;
    $to =~ s/^@//;
    my $lc = lc $to;
    return 1 if $to eq '' || $lc eq 'all' || $lc eq 'broadcast'
        || $lc eq '#broadcast' || $lc eq 'everyone';
    return 0;
}

sub in_channel {
    my ($m, $chan) = @_;
    $chan ||= 'all';
    my $t   = $m->{type} // '';
    my $who = $m->{from} // '';
    my $to  = $m->{to}   // '';
    $to =~ s/^@//;
    if ($chan eq 'all') {
        return 1 if $t eq 'register' || $t eq 'disconnect' || $t eq 'error' || $t eq 'ack';
        return is_broadcast_to($to);
    }
    # Presence is a #system note, not a line in the berth transcript.
    return 0 if $t eq 'register' || $t eq 'disconnect';
    if (($channels{$chan}{kind} // '') eq 'group') {
        return 1 if $to eq $chan;
        return 0;
    }
    return 0 if ($channels{$to}{kind} // '') eq 'group';
    return 1 if $to eq $chan;
    return 1 if $who eq $chan && !is_broadcast_to($to);
    return 0;
}

# A file chip is always one line. Text wraps as newline count + 1, plus a meta line.
sub msg_lines {
    my ($m) = @_;
    my $n = 1;
    if ($m->{files} && ref $m->{files} eq 'ARRAY') {
        $n += scalar @{ $m->{files} };
    }
    my $c = $m->{content} // $m->{msg} // '';
    if (length $c) {
        $n += ($c =~ tr/\n//) + 1;
    }
    return $n < 1 ? 1 : $n;
}

# #system shows one online and one offline per real transition. A berth that
# re-registers while it is still up, and the old copies of that in the log,
# do not each get a line.
sub history_rows {
    my ($chan) = @_;
    $chan ||= 'all';
    my @rows = grep { in_channel($_, $chan) } @log;
    return @rows if $chan ne 'all';
    my %up;
    my @kept;
    for my $m (@rows) {
        my $t  = $m->{type} // '';
        my $id = $m->{id} // $m->{from} // '';
        if ($t eq 'register') {
            next if $id eq '' || $up{$id};
            $up{$id} = 1;
        } elsif ($t eq 'disconnect') {
            next if $id eq '' || !$up{$id};
            $up{$id} = 0;
        }
        push @kept, $m;
    }
    return @kept;
}

sub history_page {
    my ($chan, $page, $lines_per) = @_;
    $chan ||= 'all';
    $lines_per = 32 if !$lines_per || $lines_per < 8;
    $lines_per = 80 if $lines_per > 80;
    my @ch = history_rows($chan);
    my @lens = map { msg_lines($_) } @ch;

    # Pack whole messages (oldest = page 1). A message that does not fit the
    # room left on a page starts the next one, so leftover lines are wasted.
    # ceil(total_lines / budget) ignores that waste and is short by a page;
    # "last" and a click on the highest number then stay on the previous page.
    my @page_idx;
    my ($pno, $used) = (1, 0);
    for my $i (0 .. $#ch) {
        my $need = $lens[$i];
        if ($used && $used + $need > $lines_per) {
            $pno++;
            $used = 0;
        }
        push @{ $page_idx[$pno] }, $i;
        $used += $need;
    }
    my $pages = $pno;
    # page < 1 means last (the API passes -1 for an omitted page and "last").
    $page = $pages if !defined $page || $page < 1 || $page > $pages;
    my @slice = map { $ch[$_] } @{ $page_idx[$page] || [] };
    return {
        channel => $chan,
        page    => $page + 0,
        pages   => $pages + 0,
        lines   => $lines_per + 0,
        total   => scalar(@ch),
        seq     => scalar(@log),
        messages => [ map { hub_state_message($_) } @slice ],
    };
}

sub file_meta_path { "$FILE_DIR/$_[0].json" }
sub file_blob_path { "$FILE_DIR/$_[0].bin" }

sub new_file_id {
    my $id = sprintf('%08x%08x', time(), int(rand(2**32)));
    $id .= sprintf('%04x', int(rand(0x10000)));
    return $id;
}

sub save_upload {
    my ($name, $mime, $bytes) = @_;
    return unless defined $bytes && length $bytes;
    return if length($bytes) > $MAX_UPLOAD;
    $name = 'file' unless defined $name && $name =~ /\S/;
    $name =~ s{.*/}{};
    $name =~ s{[^\w.\- +()\[\]]+}{_}g;
    $name = substr($name, 0, 180);
    $mime ||= 'application/octet-stream';
    my $id = new_file_id();
    mkdir $FILE_DIR, 0755 unless -d $FILE_DIR;
    open my $bf, '>', file_blob_path($id) or return;
    binmode $bf;
    print $bf $bytes;
    close $bf;
    my $meta = {
        id    => $id,
        name  => $name,
        bytes => length($bytes),
        mime  => $mime,
        url   => (zhc_gate() ? zhc_req_prefix() . '/api/v1/dc/files/' : '/api/files/') . $id,
    };
    if (open my $mf, '>', file_meta_path($id)) {
        print $mf encode_json($meta);
        close $mf;
    }
    return $meta;
}

sub load_file_meta {
    my ($id) = @_;
    return unless $id && $id =~ /^[0-9a-fA-F]{8,}$/;
    open my $mf, '<', file_meta_path($id) or return;
    local $/;
    my $j = eval { decode_json(<$mf>) };
    close $mf;
    return $j;
}

sub agent_record {
    my ($id, $live) = @_;
    return {
        id        => $id,
        name      => $id,
        connected => $live ? \1 : \0,
        activity  => ($live ? activity_now($id) : 'idle'),
    };
}

sub hub_state {
    my @agents;
    for my $id (sort keys %agents) {
        next if $id =~ /^anon-/ || $id eq 'human' || $id eq '';
        push @agents, agent_record($id, 1);
    }
    my @chlist;
    for my $cid (sort keys %channels) {
        my $c = $channels{$cid};
        push @chlist, {
            id      => $c->{id},
            kind    => $c->{kind},
            name    => $c->{name},
            members => [ @{ $c->{members} || [] } ],
        };
    }
    return {
        agents   => \@agents,
        seq      => scalar(@log),
        channels => \@chlist,
    };
}

sub zhc_gate { return $ZHC_GATE; }

sub zhc_ct_eq {
    my ($a, $b) = @_;
    return 0 if !defined $a || !defined $b || length($a) != length($b);
    my $d = 0;
    for (my $i = 0; $i < length($a); $i++) {
        $d |= ord(substr($a, $i, 1)) ^ ord(substr($b, $i, 1));
    }
    return $d == 0;
}

# Every value of this bucket's session cookie, plus a flag when one is malformed.
# Last-match would treat a leftover admin cookie as the sign-in.
sub zhc_cookie_sids {
    my ($cookie) = @_;
    $cookie = $ZHC_COOKIE unless defined $cookie;
    return ([], 1) if !defined $cookie || $cookie !~ /^[A-Za-z0-9_]{1,64}\z/;
    my $raw = $ENV{HTTP_COOKIE} // '';
    my @sids;
    my $bad = 0;
    for my $part (split /;\s*/, $raw) {
        my ($k, $v) = split /=/, $part, 2;
        next unless defined $k && defined $v;
        $k =~ s/^\s+|\s+$//g;
        $v =~ s/^\s+|\s+$//g;
        next unless $k eq $cookie;
        if ($v =~ /\A[A-Za-z0-9,-]{16,128}\z/) {
            push @sids, $v unless grep { $_ eq $v } @sids;
        } else {
            $bad = 1;
        }
    }
    return (\@sids, $bad);
}

# One PHP serialize value. Returns (node, rest) or an empty list.
sub zhc_php_take {
    my ($rest) = @_;
    return if !defined $rest || $rest eq '';
    if ($rest =~ /\Ai:(-?\d+);/s) {
        return ({ t => 'i', i => $1 + 0 }, substr($rest, length($&)));
    }
    if ($rest =~ /\A(?:b:[01];|N;|d:[^;]*;)/s) {
        return ({ t => 'x' }, substr($rest, length($&)));
    }
    if ($rest =~ /\As:(\d+):"/s) {
        my $len = $1 + 0;
        my $hdr = length($&);
        return if $hdr + $len + 2 > length($rest);
        my $val = substr($rest, $hdr, $len);
        my $after = substr($rest, $hdr + $len);
        return unless $after =~ /\A";/s;
        return ({ t => 's', s => $val }, substr($after, 2));
    }
    if ($rest =~ /\Aa:(\d+):\{/s) {
        my $n = $1 + 0;
        return if $n > 10000;
        my $cur = substr($rest, length($&));
        for (1 .. $n) {
            my ($k, $r1) = zhc_php_take($cur);
            return unless $k;
            my ($v, $r2) = zhc_php_take($r1);
            return unless $v;
            $cur = $r2;
        }
        return unless $cur =~ /\A\}/s;
        return ({ t => 'x' }, substr($cur, 1));
    }
    if ($rest =~ /\AO:(\d+):"/s) {
        my $nlen = $1 + 0;
        my $hdr = length($&);
        return if $hdr + $nlen + 2 > length($rest);
        my $after = substr($rest, $hdr + $nlen);
        return unless $after =~ /\A":(\d+):\{/s;
        my $n = $1 + 0;
        return if $n > 10000;
        my $cur = substr($after, length($&));
        for (1 .. $n) {
            my ($k, $r1) = zhc_php_take($cur);
            return unless $k;
            my ($v, $r2) = zhc_php_take($r1);
            return unless $v;
            $cur = $r2;
        }
        return unless $cur =~ /\A\}/s;
        return ({ t => 'x' }, substr($cur, 1));
    }
    return;
}

# PHP session file. () on any failure. user_id is a product profile, not the account.
sub zhc_session_claims {
    my ($sid, $sess_dir) = @_;
    $sess_dir = $ZHC_SESS_DIR unless defined $sess_dir;
    return if !defined $sid || $sid !~ /\A[A-Za-z0-9,-]{16,128}\z/;
    return if $sess_dir !~ m{\A/} || $sess_dir =~ m{\.\.};
    my $path = $sess_dir . '/sess_' . $sid;
    my @st = lstat($path);
    return unless @st;
    return if -l _;
    return unless -f _;
    return if ($st[7] // 0) <= 0 || $st[7] > 65536;
    open my $fh, '<', $path or return;
    my $data = '';
    my $n = read($fh, $data, 65536);
    close $fh;
    return unless $n;
    my %kv;
    my $rest = $data;
    my $guard = 0;
    while (length($rest) && $guard++ < 64) {
        return unless $rest =~ /\A([A-Za-z_][A-Za-z0-9_]*)\|/s;
        my $key = $1;
        my ($val, $next) = zhc_php_take(substr($rest, length($key) + 1));
        return unless $val;
        $kv{$key} = $val;
        $rest = $next;
    }
    return if length $rest;
    my $idv = $kv{zhc_user_id};
    return unless $idv;
    my $uid;
    if ($idv->{t} eq 'i') {
        $uid = $idv->{i};
    } elsif ($idv->{t} eq 's' && ($idv->{s} // '') =~ /\A\d+\z/) {
        $uid = $idv->{s} + 0;
    }
    return unless $uid && $uid > 0;
    my $sess_email;
    if (exists $kv{email}) {
        return unless $kv{email}{t} eq 's';
        $sess_email = $kv{email}{s};
    }
    return ($uid, $sess_email);
}

# ('ok', row) | ('miss') | ('err'). Read-only. Never interpolates the id into SQL.
sub zhc_user_row {
    my ($id) = @_;
    return ('err') if !defined $id || $id !~ /\A\d+\z/ || $id < 1;
    return ('err') if $ZHC_DB !~ m{\A/} || $ZHC_DB =~ m{\.\.} || $ZHC_DB =~ /[?#]/ || !-f $ZHC_DB;
    require DBI;
    require DBD::SQLite;
    # immutable=1 reads the file without a WAL lock, so pledge can keep the
    # account directory read-only. A checkpoint in flight fails this one call.
    my $dbh = DBI->connect(
        'dbi:SQLite:dbname=file://' . $ZHC_DB . '?immutable=1',
        '', '', {
            RaiseError => 0,
            PrintError => 0,
            sqlite_open_flags => DBD::SQLite::OPEN_READONLY() | DBD::SQLite::OPEN_URI(),
        }
    );
    return ('err') unless $dbh;
    $dbh->do('PRAGMA query_only = ON');
    my $sth = $dbh->prepare(
        'SELECT email, email_verified FROM zhc_users WHERE id = ?'
    );
    if (!$sth || !$sth->execute($id)) {
        $dbh->disconnect;
        return ('err');
    }
    my $row = $sth->fetchrow_hashref;
    $sth->finish;
    $dbh->disconnect;
    return $row ? ('ok', $row) : ('miss');
}

# admin is the only role this cut grants. The configured address is compared
# here and nowhere else. A later instance changes the address, not the checks.
sub zhc_roles_for_row {
    my ($row) = @_;
    return () unless $row && ref($row) eq 'HASH';
    my $verified = ($row->{email_verified} // 0) + 0;
    return () if $verified != 1;
    my $allow = lc($ZHC_EMAIL // '');
    $allow =~ s/^\s+|\s+$//g;
    return () if $allow eq '' || $allow !~ /\A[^\s@]+@[^\s@]+\z/;
    my $email = lc($row->{email} // '');
    $email =~ s/^\s+|\s+$//g;
    return () unless zhc_ct_eq(sha256_hex($email), sha256_hex($allow));
    return ('admin');
}

sub zhc_authorize_sid {
    my ($sid, $sess_dir) = @_;
    my ($uid, $sess_email) = zhc_session_claims($sid, $sess_dir);
    return { ok => 0, code => 401, error => 'sign in required' } unless $uid;
    my $allow = lc($ZHC_EMAIL // '');
    $allow =~ s/^\s+|\s+$//g;
    if ($allow eq '' || $allow !~ /\A[^\s@]+@[^\s@]+\z/) {
        return { ok => 0, code => 503, error => 'unavailable' };
    }
    my ($st, $row) = zhc_user_row($uid);
    return { ok => 0, code => 503, error => 'unavailable' } if $st eq 'err';
    return { ok => 0, code => 403, error => 'forbidden' } if $st ne 'ok';
    my $admin = grep { $_ eq 'admin' } zhc_roles_for_row($row);
    return { ok => 0, code => 403, error => 'forbidden' } unless $admin;
    # A copied email must be this row's email, not a second copy of the grant.
    if (defined $sess_email) {
        my $se = lc $sess_email;
        $se =~ s/^\s+|\s+$//g;
        my $row_email = lc($row->{email} // '');
        $row_email =~ s/^\s+|\s+$//g;
        return { ok => 0, code => 403, error => 'forbidden' }
            unless zhc_ct_eq(sha256_hex($se), sha256_hex($row_email));
    }
    return { ok => 1, code => 200 };
}

sub zhc_authorize {
    my ($path) = @_;
    my $bucket = zhc_bucket_of(defined $path ? $path : '/');
    my $cookie = zhc_cookie_for($bucket);
    my $sess_dir = zhc_sess_dir_for($bucket);
    if (!defined $cookie || !defined $sess_dir
        || $sess_dir !~ m{\A/} || $sess_dir =~ m{\.\.} || !-d $sess_dir) {
        return { ok => 0, code => 401, error => 'sign in required' };
    }
    my ($sids, $bad) = zhc_cookie_sids($cookie);
    return { ok => 0, code => 401, error => 'sign in required' } if $bad || !@$sids;
    my $decision;
    for my $sid (@$sids) {
        $decision = zhc_authorize_sid($sid, $sess_dir);
        return $decision if !$decision->{ok};
    }
    return $decision;
}

# /dev and /qa are doors. The configured names are the prod pair; swap the suffix.
sub zhc_bucket_of {
    my ($path) = @_;
    $path = '/' unless defined $path && length $path;
    return 'dev' if $path eq '/dev' || $path =~ m{\A/dev/};
    return 'qa'  if $path eq '/qa'  || $path =~ m{\A/qa/};
    return 'prod';
}

sub zhc_prefix_for {
    my ($bucket) = @_;
    return '/dev' if ($bucket // '') eq 'dev';
    return '/qa'  if ($bucket // '') eq 'qa';
    return '';
}

sub zhc_req_prefix {
    return '' unless $ZHC_GATE;
    return zhc_prefix_for($ZHC_REQ_BUCKET);
}

sub zhc_cookie_for {
    my ($bucket) = @_;
    return $ZHC_COOKIE if !defined $bucket || $bucket eq 'prod';
    return undef unless defined $ZHC_COOKIE && $ZHC_COOKIE =~ /_PROD\z/;
    my $suf = $bucket eq 'dev' ? '_DEV' : $bucket eq 'qa' ? '_QA' : undef;
    return undef unless defined $suf;
    (my $name = $ZHC_COOKIE) =~ s/_PROD\z/$suf/;
    return $name;
}

sub zhc_sess_dir_for {
    my ($bucket) = @_;
    return $ZHC_SESS_DIR if !defined $bucket || $bucket eq 'prod';
    return undef unless defined $ZHC_SESS_DIR && $ZHC_SESS_DIR =~ /-prod\z/;
    my $suf = $bucket eq 'dev' ? '-dev' : $bucket eq 'qa' ? '-qa' : undef;
    return undef unless defined $suf;
    (my $dir = $ZHC_SESS_DIR) =~ s/-prod\z/$suf/;
    return $dir;
}

# One leading bucket only. /developer and /quality stay untouched.
sub zhc_strip_bucket {
    my ($path) = @_;
    $path = '/' unless defined $path && length $path;
    return $path unless $path =~ m{\A/(?:dev|qa)(?=/|\z)};
    $path =~ s{\A/(?:dev|qa)}{};
    return $path eq '' ? '/' : $path;
}

# Page at /dc. Chrome and icons under /dc/. API at /api/v1/dc/{state,history,send,files}.
sub zhc_public_path {
    my ($path) = @_;
    $path = '/' unless defined $path && length $path;
    return '/' if $path eq '/dc' || $path eq '/dc/' || $path eq '/dc/index.html';
    if ($path =~ m{\A/dc/(chrome\.js|chrome\.css)\z}) {
        return '/dc/' . $1;
    }
    if ($path =~ m{\A/dc/icons/([a-z0-9]+(?:-[a-z0-9]+)*\.svg)\z}) {
        return '/dc/icons/' . $1;
    }
    if ($path =~ m{\A/api/v1/dc/(state|history|send)/?\z}i) {
        return '/api/' . lc($1);
    }
    if ($path =~ m{\A/api/v1/dc/files/?\z}i) {
        return '/api/files';
    }
    if ($path =~ m{\A/api/v1/dc/files/([0-9a-fA-F]+)(?:/.*)?\z}i) {
        return '/api/files/' . lc($1);
    }
    return undef;
}

# Plain on purpose. A later cut may style these status pages.
# They stay a status, not the crew UI, including when the account check is down.
sub zhc_deny {
    my ($d, $path) = @_;
    my $code = $d->{code} || 401;
    my $err  = $d->{error} || 'forbidden';
    if (($path // '') =~ m{/api/}) {
        json_out($code, { ok => \0, error => $err });
        return;
    }
    my $title = $code == 401 ? 'Sign in required'
        : $code == 403 ? 'Forbidden' : 'Unavailable';
    my $acct = zhc_req_prefix() . '/account/';
    my $extra = $code == 401
        ? "<p>Sign in required.</p>\n<p><a href=\"$acct\">Sign in</a></p>\n"
        : "<p>$title.</p>\n";
    my $status = $code == 401 ? '401 Unauthorized'
        : $code == 403 ? '403 Forbidden' : '503 Service Unavailable';
    fcgi_print(
        'text/html; charset=utf-8',
        "<!DOCTYPE html>\n<html lang=\"en\"><head><meta charset=\"utf-8\">"
        . "<title>$title</title></head><body>\n$extra</body></html>\n",
        $status
    );
}

sub zhc_not_ours {
    my ($path) = @_;
    if (($path // '') =~ m{/api/}) {
        json_out(404, { ok => \0, error => 'not found' });
        return;
    }
    fcgi_print('text/plain; charset=utf-8', "not found\n", '404 Not Found');
}

# A web send may name one connected berth. #system and groups are not destinations.
sub zhc_target_ok {
    my ($to) = @_;
    $to = normalize_to($to);
    return 0 if is_broadcast_to($to) || $to eq 'human' || $to =~ /^g:/;
    return 0 if $channels{$to} && ($channels{$to}{kind} // '') eq 'group';
    return 0 unless $agents{$to} && $agents{$to}{sock};
    return 1;
}

sub handle_fcgi {
    my ($req) = @_;
    my $method = uc($ENV{REQUEST_METHOD} // 'GET');
    my $path   = fcgi_path();
    my $ctype  = $ENV{CONTENT_TYPE} // '';
    my $clen   = $ENV{CONTENT_LENGTH} // 0;
    my $q = parse_urlencoded($ENV{QUERY_STRING} // '');
    if (zhc_gate()) {
        $ZHC_REQ_BUCKET = zhc_bucket_of($path);
        my $decision = zhc_authorize($path);
        if (!$decision->{ok}) {
            zhc_deny($decision, $path);
            return;
        }
        my $mapped = zhc_public_path(zhc_strip_bucket($path));
        if (!defined $mapped) {
            zhc_not_ours($path);
            return;
        }
        $path = $mapped;
        if ($path =~ m{\A/api/setup\b}i
            || ($q->{setup} // '') ne ''
            || ($q->{action} // '') eq 'altcha_challenge') {
            json_out(404, { ok => \0, error => 'not found' });
            return;
        }
    }
    if (defined dc_asset_rel($path)) {
        if ($method ne 'GET' && $method ne 'HEAD') {
            fcgi_print('text/plain; charset=utf-8', "method not allowed\n", '405 Method Not Allowed');
            return;
        }
        serve_dc_asset($path);
        return;
    }
    my $is_upload = ($path =~ m{/api/files/?$}i && $method eq 'POST');
    my $max_body  = $is_upload ? $MAX_UPLOAD : 65536;
    if ($method eq 'POST' && $clen =~ /^\d+$/ && $clen > $max_body) {
        json_out(413, { ok => \0, error => 'payload too large' });
        return;
    }
    my $body = ($method eq 'POST' || $method eq 'PUT') ? fcgi_read_body($max_body) : '';
    if ($method eq 'POST' && $ctype !~ m{json}i) {
        my $pq = parse_urlencoded($body);
        $q->{$_} = $pq->{$_} for keys %$pq;
    }

    # Static chrome for the ZHC-like signup (also served from httpd /htdocs/shared).
    if ($path =~ m{^/shared/([A-Za-z0-9._-]+)$}) {
        my $file = share_file($1);
        if ($file && open my $fh, '<', $file) {
            local $/;
            my $s = <$fh>;
            close $fh;
            my $ct = 'application/octet-stream';
            $ct = 'text/css; charset=utf-8' if $file =~ /\.css$/i;
            $ct = 'text/javascript; charset=utf-8' if $file =~ /\.js$/i;
            $ct = 'text/plain; charset=utf-8' if $file =~ /\.txt$/i;
            cgi_out(
                "Status: 200 OK\r\nCache-Control: public, max-age=86400\r\nContent-Type: $ct\r\n\r\n",
                $s
            );
            return;
        }
        json_out(404, { ok => \0, error => 'missing shared file' }) if $path =~ m{\.json$}i;
        fcgi_print('text/plain; charset=utf-8', "not found\n", '404 Not Found');
        return;
    }

    if ($path =~ m{^/api/setup/challenge/?$}i
        || ($q->{setup} // '') eq 'challenge'
        || (($q->{action} // '') eq 'altcha_challenge' && $path =~ m{/api/}i)) {
        json_out(200, pow_challenge(), { expires => http_date(time + 600) });
        return;
    }
    if ($path =~ m{^/api/setup/status/?$}i) {
        json_out(200, {
            ok        => \1,
            complete  => setup_complete() ? \1 : \0,
            llm       => llm_configured() ? \1 : \0,
            need_setup => (setup_complete() && llm_configured()) ? \0 : \1,
        });
        return;
    }
    if ($path =~ m{^/api/setup/?$}i && $method eq 'POST'
        || (($q->{setup} // '') eq 'save' && $method eq 'POST')) {
        my $obj = {};
        if (($ctype || '') =~ /json/i) {
            $obj = eval { decode_json($body) } || {};
        } else {
            $obj = { %$q };
        }
        if (!pow_ok(parse_altcha($obj))) {
            json_out(400, { ok => \0, error => 'ALTCHA failed' });
            return;
        }
        my $user = $obj->{user} // '';
        my $pass = $obj->{password} // '';
        $user =~ s/^\s+|\s+$//g;
        if ($user !~ /^[a-zA-Z][a-zA-Z0-9._-]{1,31}$/) {
            json_out(400, { ok => \0, error => 'username: letters, 2–32 chars' });
            return;
        }
        if (length($pass) < 8) {
            json_out(400, { ok => \0, error => 'password at least 8 characters' });
            return;
        }
        my $base = $obj->{llm_base} || 'https://openrouter.ai/api/v1';
        my $key  = $obj->{llm_key} // '';
        $key =~ s/\s+//g;
        if ($key eq '') {
            json_out(400, { ok => \0, error => 'LLM API key required (or leave maintenance mode)' });
            return;
        }
        my $mgmt = $obj->{mgmt_key} // '';
        $mgmt =~ s/\s+//g;
        write_llm_secrets($base, $key, $mgmt);
        my $saved = save_setup({
            complete   => JSON::PP::true,
            user       => $user,
            pass_hash  => bcrypt_hash($pass),
            created    => strftime('%Y-%m-%dT%H:%M:%SZ', gmtime),
            llm_base   => $base,
            llm_key    => \1,
            mgmt_key   => $mgmt ? JSON::PP::true : JSON::PP::false,
            shared_key => $mgmt ? JSON::PP::false : JSON::PP::true,
        });
        if (!$saved) {
            json_out(500, { ok => \0, error => 'could not write setup.json' });
            return;
        }
        json_out(200, { ok => \1, shared_key => $mgmt ? \0 : \1 });
        return;
    }

    if (!zhc_gate() && $method eq 'POST' && !setup_complete()
        && $path =~ m{/api/(send|channels|files)}i) {
        json_out(503, { ok => \0, error => 'setup required' });
        return;
    }

    if ($path =~ m{^/api/files/([0-9a-fA-F]+)(?:/.*)?$}i) {
        my $id = $1;
        if ($method ne 'GET' && $method ne 'HEAD') {
            json_out(405, { ok => \0, error => 'GET required' });
            return;
        }
        my $meta = load_file_meta($id);
        if (!$meta) {
            json_out(404, { ok => \0, error => 'no such file' });
            return;
        }
        my $blob = file_blob_path($id);
        if (!-f $blob) {
            json_out(404, { ok => \0, error => 'missing blob' });
            return;
        }
        open my $bf, '<', $blob or do {
            json_out(404, { ok => \0, error => 'missing blob' });
            return;
        };
        binmode $bf;
        local $/;
        my $data = <$bf> // '';
        close $bf;
        my $name = $meta->{name} || 'file';
        $name =~ s/"//g;
        my $mime = $meta->{mime} || 'application/octet-stream';
        my $disp = ($q->{dl} || $q->{download}) ? 'attachment' : 'inline';
        cgi_out(
            "Status: 200 OK\r\nCache-Control: "
            . (zhc_gate() ? 'no-store' : 'private, max-age=3600') . "\r\n"
            . "Content-Type: $mime\r\n"
            . "Content-Length: " . length($data) . "\r\n"
            . "Content-Disposition: $disp; filename=\"$name\"\r\n\r\n",
            $data
        );
        return;
    }

    if ($path =~ m{^/api/files/?$}i && $method eq 'POST') {
        my $name = $q->{name} // '';
        if ($ctype =~ m{json}i) {
            json_out(400, { ok => \0, error => 'send raw file body, not json' });
            return;
        }
        my $meta = save_upload($name, $q->{mime} || $ctype, $body);
        if (!$meta) {
            json_out(400, { ok => \0, error => 'upload failed' });
            return;
        }
        json_out(200, { ok => \1, %$meta });
        return;
    }

    if ($path =~ m{^/api/channels/?$}i) {
        if ($method eq 'GET') {
            json_out(200, {
                ok       => \1,
                channels => [
                    map {
                        my $c = $channels{$_};
                        {
                            id      => $c->{id},
                            kind    => $c->{kind},
                            name    => $c->{name},
                            members => [ @{ $c->{members} || [] } ],
                        }
                    } sort keys %channels
                ],
            });
            return;
        }
        if ($method ne 'POST') {
            json_out(405, { ok => \0, error => 'GET or POST' });
            return;
        }
        my $obj = eval { decode_json($body) };
        if (!$obj || ref $obj ne 'HASH') {
            json_out(400, { ok => \0, error => 'invalid json' });
            return;
        }
        my $ch = ensure_group_channel($obj->{id}, $obj->{name}, $obj->{members});
        json_out(200, { ok => \1, channel => $ch });
        return;
    }

    if ($path =~ m{/api/history/?$}i) {
        my $chan  = normalize_to($q->{channel} // $q->{chan} // 'all');
        my $page  = $q->{page};
        $page = -1 if !defined $page || $page eq '' || $page eq 'last';
        $page = 0 + $page if $page =~ /^-?\d+$/;
        my $lines = 0 + ($q->{lines} || $q->{per} || 32);
        my $hist = history_page($chan, $page, $lines);
        my $etag = join('-', $hist->{seq}, $hist->{channel}, $hist->{page}, $hist->{pages}, $hist->{lines});
        my $inm  = $ENV{HTTP_IF_NONE_MATCH} // '';
        $inm =~ s/"//g;
        if ($inm && $inm eq $etag) {
            json_out(304, {}, {
                etag  => $etag,
                cache => ($hist->{page} < $hist->{pages}
                    ? 'private, max-age=86400'
                    : 'no-store'),
            });
            return;
        }
        json_out(200, $hist, {
            etag  => $etag,
            cache => ($hist->{page} < $hist->{pages}
                ? 'private, max-age=86400'
                : 'no-store'),
        });
        return;
    }

    my $want_json = ($path =~ m{/api/state/?$}i)
        || (($q->{format} // '') eq 'json');

    if (!zhc_gate() && $path =~ m{/api/send/?$}i
        && $method eq 'POST' && !setup_complete()) {
        json_out(503, { ok => \0, error => 'setup required' });
        return;
    }

    if ($path =~ m{/api/send/?$}i) {
        if ($method ne 'POST') {
            json_out(405, { ok => \0, error => 'POST required' });
            return;
        }
        my ($to, $content);
        if ($ctype =~ m{json}i) {
            my $obj = eval { decode_json($body) };
            if (!$obj || ref $obj ne 'HASH') {
                json_out(400, { ok => \0, error => 'invalid json' });
                return;
            }
            $to      = $obj->{to};
            $content = $obj->{content};
            if (zhc_gate() && !zhc_target_ok($to)) {
                json_out(400, { ok => \0, error => 'pick a live berth' });
                return;
            }
            my @files;
            if ($obj->{files} && ref $obj->{files} eq 'ARRAY') {
                for my $f (@{ $obj->{files} }) {
                    next unless $f && ref $f eq 'HASH' && $f->{id};
                    my $meta = load_file_meta($f->{id}) or next;
                    push @files, $meta;
                }
            }
            if (!inject_human_message($to, $content, \@files)) {
                json_out(400, { ok => \0, error => 'content required' });
                return;
            }
            json_out(200, { ok => \1, to => normalize_to($to) });
            return;
        } else {
            $to      = $q->{to};
            $content = $q->{content};
            if (zhc_gate() && !zhc_target_ok($to)) {
                json_out(400, { ok => \0, error => 'pick a live berth' });
                return;
            }
        }
        if (!inject_human_message($to, $content)) {
            json_out(400, { ok => \0, error => 'content required' });
            return;
        }
        json_out(200, { ok => \1, to => normalize_to($to) });
        return;
    }

    if ($q->{send} && defined $q->{content} && length $q->{content}) {
        if (zhc_gate() && !zhc_target_ok($q->{to})) {
            json_out(400, { ok => \0, error => 'pick a live berth' });
            return;
        }
        inject_human_message($q->{to}, $q->{content});
        if (!$want_json && $method eq 'POST') {
            my $loc = zhc_gate() ? zhc_req_prefix() . '/dc/' : '/';
            cgi_out("Status: 303 See Other\r\nLocation: $loc\r\nCache-Control: no-store\r\n\r\n");
            return;
        }
    }

    if ($want_json) {
        json_out(200, hub_state());
        return;
    }

    # /api/* is JSON only — never HTML (that was the "<!DOCTYPE" SyntaxError).
    if ($path =~ m{^/api/}i) {
        json_out(404, { ok => \0, error => 'not found' });
        return;
    }

    if (zhc_gate()) {
        fcgi_print('text/html; charset=utf-8', app_html());
        return;
    }

    if ($path =~ m{^/account/?$}i) {
        if (!setup_complete() || !llm_configured()) {
            fcgi_print('text/html; charset=utf-8', setup_html());
            return;
        }
        cgi_out("Status: 303 See Other\r\nLocation: /\r\nCache-Control: no-store\r\n\r\n");
        return;
    }

    if (!setup_complete() || !llm_configured()) {
        fcgi_print('text/html; charset=utf-8', setup_html());
        return;
    }
    fcgi_print('text/html; charset=utf-8', app_html());
}

sub apply_brand {
    my ($html) = @_;
    return '' unless defined $html;
    my $name = $PRODUCT;
    $name =~ s/&/&amp;/g;
    $name =~ s/</&lt;/g;
    $name =~ s/>/&gt;/g;
    my $cookie = $COOKIE_PREFIX;
    $cookie =~ s/[^A-Za-z0-9_]//g;
    $cookie = 'PICOBUS' unless length $cookie;
    my $pre  = $ZHC_GATE ? zhc_req_prefix() : '';
    my $api  = $ZHC_GATE ? $pre . '/api/v1/dc' : '/api';
    my $page = $ZHC_GATE ? $pre . '/dc/' : '/';
    my $acct = $pre . '/account/';
    $html =~ s/__PRODUCT__/$name/g;
    $html =~ s/__COOKIE__/$cookie/g;
    $html =~ s/__API__/$api/g;
    $html =~ s/__PAGE__/$page/g;
    $html =~ s/__ACCOUNT__/$acct/g;
    return $html;
}

sub setup_html {
    for my $p (
        ($SHARE_DIR ? "$SHARE_DIR/setup.html" : ()),
        "$FindBin::Bin/../share/setup.html",
        "/usr/local/share/picobus/setup.html",
        "$FindBin::Bin/setup.html",
    ) {
        next unless $p && -f $p;
        open my $fh, '<', $p or next;
        local $/;
        my $s = <$fh>;
        close $fh;
        return apply_brand($s) if defined $s && length $s;
    }
    return apply_brand(<<'SETUP_HTML');
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="picobus-cookie" content="__COOKIE__">
<title>Create account — __PRODUCT__</title>
<link rel="stylesheet" href="/shared/zhc-prefs.css">
</head>
<body>
<header class="zhc-app-chrome"><nav class="zhc-product-nav" aria-label="Main"><a href="/">Home</a></nav><div id="zhc-theme-slot"></div></header>
<main>
<h1>Create account</h1>
<p class="note">Complete ALTCHA under the password, then Continue.</p>
<form class="auth" id="f" onsubmit="return false">
<label for="user">Username</label>
<input id="user" name="user" autocomplete="username" required>
<label for="password">Password</label>
<input id="password" name="password" type="password" autocomplete="new-password" required minlength="8">
<div id="altcha-wrap">
<altcha-widget id="altcha-widget" name="altcha" challengeurl="/api/setup/challenge" auto="off" hidefooter></altcha-widget>
</div>
<label for="llm_base">LLM HTTP URL</label>
<input id="llm_base" name="llm_base" type="url" value="https://openrouter.ai/api/v1">
<label for="llm_key">CEO API key</label>
<input id="llm_key" name="llm_key" type="password" autocomplete="off" required>
<label for="mgmt_key">OpenRouter management key (optional)</label>
<input id="mgmt_key" name="mgmt_key" type="password" autocomplete="off">
<p id="err" class="err"></p>
<button type="button" class="btn" id="go">Continue</button>
</form>
</main>
<script src="/shared/altcha-http-shim.js"></script>
<script src="/shared/altcha-widget-v1.min.js" defer></script>
<script src="/shared/crew-prefs.js" defer></script>
<script>
(function(){
  var p='';
  function w(){ return document.getElementById('altcha-widget'); }
  function payload(){ var el=w(); return p || (el && el.value) || ''; }
  customElements.whenDefined('altcha-widget').then(function(){
    var el=w(); if(!el) return;
    el.addEventListener('verified', function(ev){ p=(ev.detail&&ev.detail.payload)||''; });
    el.addEventListener('statechange', function(ev){ if(ev.detail&&ev.detail.state==='verified'&&ev.detail.payload) p=ev.detail.payload; });
  });
  document.getElementById('go').onclick=function(){
    var err=document.getElementById('err'); err.textContent='';
    if(!payload()){ err.textContent='Complete the human check under your password first.'; return; }
    var f=document.getElementById('f');
    fetch('/api/setup',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({
      user:f.user.value,password:f.password.value,llm_base:f.llm_base.value,llm_key:f.llm_key.value,mgmt_key:f.mgmt_key.value,altcha:payload()
    })}).then(function(r){
      var ct=r.headers.get('content-type')||'';
      if(ct.indexOf('json')===-1) throw new Error('setup API returned HTML');
      return r.json();
    }).then(function(j){ if(!j.ok) throw new Error(j.error||'setup failed'); location.href='/'; })
      .catch(function(e){ err.textContent=String(e); });
  };
})();
</script>
</body>
</html>
SETUP_HTML
}

sub app_html {
    return apply_brand(<<'CHAT_HTML');
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>__PRODUCT__</title>
<script>
(function () {
  var b = location.pathname.match(/^\/(dev|qa)(\/|$)/);
  document.documentElement.setAttribute('data-zhc-bucket', b ? b[1] : 'prod');
  var k = 'ZHCTHEME_' + (b ? b[1].toUpperCase() : 'PROD');
  var m = document.cookie.match(new RegExp('(?:^|; )' + k + '=([^;]*)'));
  var v = m ? decodeURIComponent(m[1]) : 'system';
  if (v !== 'light' && v !== 'dark' && v !== 'system') v = 'system';
  var dark = v === 'dark' || (v === 'system' && matchMedia('(prefers-color-scheme: dark)').matches);
  document.documentElement.setAttribute('data-zhc-theme', dark ? 'dark' : 'light');
  document.documentElement.setAttribute('data-zhc-theme-pref', v);
})();
</script>
<link rel="stylesheet" href="__PAGE__chrome.css">
<script src="__PAGE__chrome.js" defer></script>
<style>
:root {
  --bg:#313338; --side:#2b2d31; --compose:#383a40; --hover:#35373c;
  --sel:#404249; --text:#dbdee1; --head:#f2f3f5; --muted:#949ba4;
  --sys:#6d6f78; --line:#3f4147; --blurple:#5865f2; --green:#23a559;
  --yellow:#f0b232; --red:#f23f43; --off:#80848e; --me:#00a8fc;
}
html[data-zhc-theme="dark"] { color-scheme: dark; }
