    return apply_brand(<<'CHAT_HTML');
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#313338">
<title>__PRODUCT__</title>
<link rel="manifest" href="/manifest.webmanifest">
<link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192">
<script>
if ('serviceWorker' in navigator) {
  navigator.serviceWorker.register('/sw.js').catch(function () {});
}
</script>
<script>
(function () {
  var b = location.pathname.match(/^\/(dev|qa)(\/|$)/);
  document.documentElement.setAttribute('data-zhc-bucket', b ? b[1] : 'prod');
  var k = 'ZHCTHEME_' + (b ? b[1].toUpperCase() : 'PROD');
  var m = document.cookie.match(new RegExp('(?:^|; )' + k + '=([^;]*)'));
  var v = m ? decodeURIComponent(m[1]) : 'system';
  if (v !== 'light' && v !== 'dark' && v !== 'system') v = 'system';
  var dark = v === 'dark' || (v === 'system' && matchMedia('(prefers-color-scheme: dark)').matches);
  document.documentElement.setAttribute('data-zhc-theme', dark ? 'dark' : 'light');
  document.documentElement.setAttribute('data-zhc-theme-pref', v);
})();
</script>
<link rel="stylesheet" href="__PAGE__chrome.css">
<script src="__PAGE__chrome.js" defer></script>
