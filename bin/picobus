$| = 1;

# ---------- config (env overrides; rc wrapper sets the service defaults) ----------
my $HUB_SOCK   = $ENV{HUB_SOCK}  // '/var/run/picoclaw/hub.sock';
my $HUB_GROUP  = $ENV{HUB_GROUP};    # optional; chown the hub socket to this group
my $FCGI_SOCK  = $ENV{FCGI_SOCK} // '/var/www/run/picoclaw/fcgi.sock';
my $MAX_LOG    = 50000;        # server history; the browser only gets one page
my $MAX_UPLOAD = 8 * 1024 * 1024;
my $SELECT_TO  = 0.5;          # seconds; keeps CPU near zero
# A thinking flag older than this is idle. The UI polls faster; this is the
# freeze backup when a gateway stops refreshing the bus.
my $ACTIVITY_STALE = 10;
if (defined $ENV{PICOBUS_ACTIVITY_STALE} && $ENV{PICOBUS_ACTIVITY_STALE} =~ /^[0-9]+$/) {
    $ACTIVITY_STALE = int($ENV{PICOBUS_ACTIVITY_STALE});
    $ACTIVITY_STALE = 1 if $ACTIVITY_STALE < 1;
}
my $UMASK      = 0117;         # socket perms 0660-ish after umask
my $STATE_DIR  = $ENV{PICOBUS_STATE} // '/var/picobus';
my $HUB_LOG    = $ENV{HUB_LOG}  // "$STATE_DIR/hub-events.ndjson";
my $CHAT_LOG     = $ENV{CHAT_LOG};
my $FILE_DIR     = $ENV{FILE_DIR};
my $SETUP_FILE   = $ENV{SETUP_FILE};
my $SECRETS_DIR  = $ENV{SECRETS_DIR};
my $SHARE_DIR    = $ENV{SHARE_DIR};
my $PICO_HOME    = $ENV{PICOCLAW_HOME};
my $PRODUCT       = $ENV{PICOBUS_PRODUCT} // 'picobus';
my $COOKIE_PREFIX = $ENV{PICOBUS_COOKIE}  // 'PICOBUS';
# ZHC publish: one existing /account/ session. No second password, no API-key form.
my $ZHC_GATE     = ($ENV{PICOBUS_ZHC_GATE} // '') eq '1';
my $ZHC_EMAIL    = $ENV{PICOBUS_ZHC_EMAIL} // 'todd@fdh.bz';
my $ZHC_COOKIE   = $ENV{PICOBUS_ZHC_COOKIE} // 'ZHCSESS_PROD';
my $ZHC_SESS_DIR = $ENV{PICOBUS_ZHC_SESSION_DIR} // '/var/www/tmp/php-sessions-zhc-prod';
my $ZHC_DB       = $ENV{PICOBUS_ZHC_DB} // '/var/www/data/escalate.sqlite';
# Set from the request path before a gated page or API is rendered.
my $ZHC_REQ_BUCKET = 'prod';
# Picobus humans. Defaults are filled in after SETUP_FILE is known.
# Absent uid map: do not check the peer. ZHC gate does not use these.
my $PRINCIPALS_FILE = $ENV{PRINCIPALS_FILE};
my $GRANTS_FILE     = $ENV{GRANTS_FILE};
my $SESSIONS_FILE   = $ENV{SESSIONS_FILE};
my $UID_MAP         = $ENV{PICOBUS_UID_MAP};
# -----------------------------------------

umask $UMASK;
unlink $HUB_SOCK if -e $HUB_SOCK;

my $hub = IO::Socket::UNIX->new(
    Local  => $HUB_SOCK,
    Type   => SOCK_STREAM,
    Listen => 32,
) or die "hub listen: $!\n";
$hub->blocking(0);
chmod 0660, $HUB_SOCK;
if (defined $HUB_GROUP && $HUB_GROUP ne '') {
    my $gid = getgrnam($HUB_GROUP);
    die "HUB_GROUP $HUB_GROUP: unknown group\n" unless defined $gid;
    my $uid = (stat $HUB_SOCK)[4];
    chown $uid, $gid, $HUB_SOCK or die "chown $HUB_SOCK :$HUB_GROUP: $!\n";
}

# OpenBSD: lock filesystem + promises after listen fd exists.
# HUB_NOSANDBOX=1 skips (debug only). Non-OpenBSD: no-op.
sub _parent_dir {
    my ($p) = @_;
    return unless defined $p && length $p;
    return $p if $p !~ m{/};
    $p =~ s{/[^/]+$}{};
    return length($p) ? $p : '/';
}

sub hub_sandbox {
    return if ($ENV{HUB_NOSANDBOX} // '') eq '1';
    return unless $^O eq 'openbsd';
    eval {
        require OpenBSD::Pledge;
        require OpenBSD::Unveil;
        OpenBSD::Pledge->import('pledge');
        OpenBSD::Unveil->import('unveil');
        1;
    } or return;
    my %dir;
    for my $p ($HUB_SOCK, $HUB_LOG, $FCGI_SOCK, $CHAT_LOG, $FILE_DIR, $SETUP_FILE, $SECRETS_DIR, $PRINCIPALS_FILE, $GRANTS_FILE, $SESSIONS_FILE, $UID_MAP) {
        next unless defined $p && length $p;
        my $d = _parent_dir($p);
        $dir{$d} = 'rwc' if defined $d;
        $dir{$p} = 'rwc' if -d $p;
    }
    $dir{$FindBin::Bin} = 'rwc' if exists $dir{$FindBin::Bin};
    $dir{$FindBin::Bin} //= 'r';
    for my $p ($SHARE_DIR, '/usr/local/share/picobus') {
        next unless defined $p && length $p && -d $p;
        $dir{$p} = 'r';
        my $sh = "$p/shared";
        $dir{$sh} = 'r' if -d $sh;
        # Unveil is not recursive. Chrome icons live one directory down.
        my $dc = "$p/dc";
        $dir{$dc} = 'r' if -d $dc;
        my $icons = "$dc/icons";
        $dir{$icons} = 'r' if -d $icons;
    }
    if ($PICO_HOME) {
        mkdir $PICO_HOME, 0700 unless -d $PICO_HOME;
        # Skip unveil when the mate home is not there yet. crewd-captain
        # creates it before this hub is started.
        $dir{$PICO_HOME} = 'rwc' if -d $PICO_HOME;
    }
    if ($ZHC_GATE) {
        if ($ZHC_SESS_DIR =~ m{\A/} && $ZHC_SESS_DIR !~ m{\.\.} && -d $ZHC_SESS_DIR) {
            $dir{$ZHC_SESS_DIR} = 'r';
        } else {
            die "ZHC session dir unavailable\n";
        }
        # Dev and qa are optional at startup. Prod keeps running if those
        # directories are not there yet. A request for a missing one is 401.
        for my $b (qw(dev qa)) {
            my $d = zhc_sess_dir_for($b);
            next unless defined $d && $d =~ m{\A/} && $d !~ m{\.\.} && -d $d;
            $dir{$d} = 'r';
        }
        if ($ZHC_DB =~ m{\A/} && $ZHC_DB !~ m{\.\.} && -f $ZHC_DB) {
            my $parent = _parent_dir($ZHC_DB);
            die "ZHC account db unavailable\n" unless $parent && -d $parent;
            $dir{$parent} = 'r' unless ($dir{$parent} // '') =~ /w/;
        } else {
            die "ZHC account db unavailable\n";
        }
    }
    # crew-queue is a directory under the state dir. Unveil is not recursive.
    {
        my $q = crew_queue_dir();
        if ($q =~ m{\A/} && $q !~ m{\.\.} && !exists $dir{$q}) {
            mkdir $q, 0700 unless -d $q;
            $dir{$q} = 'rwc' if -d $q;
        }
    }
    for my $d (sort keys %dir) {
        unveil($d, $dir{$d}) or die "unveil $d: $!\n";
    }
    unveil() or die "unveil lock: $!\n";
    # fattr: chmod 0600 on secrets. error: unveil/pledge misses return EPERM
    # instead of killing the daemon (that was the Continue HTML-500).
    pledge(qw(stdio rpath wpath cpath unix fattr error)) or die "pledge: $!\n";
}

# Chat transcript + local file blobs (MinIO/S3 later; same URL shape).
$CHAT_LOG    //= (_parent_dir($HUB_LOG) || '.') . '/chat.ndjson';
$FILE_DIR    //= (_parent_dir($HUB_LOG) || '.') . '/files';
$SETUP_FILE  //= (_parent_dir($HUB_LOG) || '.') . '/setup.json';
$SECRETS_DIR //= (_parent_dir($HUB_LOG) || '.') . '/secrets';
{
    my $state = _parent_dir($SETUP_FILE) || _parent_dir($HUB_LOG) || '.';
    $PRINCIPALS_FILE //= "$state/principals.json";
    $GRANTS_FILE     //= "$state/grants.json";
    $SESSIONS_FILE   //= "$state/sessions.json";
    $UID_MAP         //= "$state/uid-map.json";
}
if (!defined $SHARE_DIR || $SHARE_DIR eq '') {
    my $dev = "$FindBin::Bin/../share";
    $SHARE_DIR = (-d $dev) ? $dev : '/usr/local/share/picobus';
}
if (defined $SHARE_DIR && $SHARE_DIR =~ m{\.\.}) {
    require Cwd;
    my $abs = Cwd::abs_path($SHARE_DIR);
    $SHARE_DIR = $abs if defined $abs && $abs =~ m{\A/};
}
{
    my $state = _parent_dir($HUB_LOG);
    mkdir $state, 0755 if $state && !-d $state;
}
$PICO_HOME //= ($ENV{HOME} || '/root') . '/.picoclaw';
# umask is for the sockets. chmod restores the directory mode it would strip.
mkdir $FILE_DIR, 0755 unless -d $FILE_DIR;
chmod 0755, $FILE_DIR if -d $FILE_DIR;
# 0700 on purpose: session.key and llm secrets. Pico tokens must not
# live here. _picobus cannot search a 0700 parent, so picobus-pico
# dies at startup with "PICO_TOKEN_DIR required (Permission denied)".
# Tokens belong in $state/pico, a sibling of this directory.
mkdir $SECRETS_DIR, 0700 unless -d $SECRETS_DIR;
chmod 0700, $SECRETS_DIR if -d $SECRETS_DIR;
# Leave an existing picoclaw home alone. crewd-captain sets it 2750
# and owned by the gateway user; chmod 0700 would lock that user out
# of files this process creates on the next signup.
mkdir $PICO_HOME, 0700 unless -d $PICO_HOME;

my $sel = IO::Select->new($hub);

# agent_id => { sock => $fh, buf => '' }
my %agents;
# reverse: fileno => agent_id
my %fd2id;
# channel_id => { id, kind => 'dm'|'group'|'system', name, members => [] }
my %channels;
my $HUB_BROADCAST = ($ENV{HUB_BROADCAST} // '') eq '1';
$channels{all} = {
    id      => 'all',
    kind    => 'system',
    name    => 'system',
    members => [],
};
my @log;   # chat history (capped); browser paginates, does not hold all of it

# The signed-in account is the operator. "human" is only the placeholder
# from before that account exists. Two active accounts and no founder
# stays unresolved: guessing would attach the crew to the wrong person.
sub operator_id {
    my $p = load_principals();
    return '' unless $p && ref $p eq 'HASH' && keys %$p;
    my (@founder, @active);
    for my $id (sort keys %$p) {
        my $u = $p->{$id};
        next unless $u && ref $u eq 'HASH';
        my $st = $u->{status} // 'active';
        next if $st ne 'active';
        push @active, $id;
        push @founder, $id if $u->{founder};
    }
    return $founder[0] if @founder;
    return $active[0] if @active == 1;
    return '';
}

sub stamp_operator {
    my ($obj) = @_;
    return unless $obj && ref $obj eq 'HASH';
    my $op = operator_id();
    return unless $op;
    for my $k (qw(from to)) {
        $obj->{$k} = $op if defined $obj->{$k} && $obj->{$k} eq 'human';
    }
}

sub addressed_to_operator {
    my ($to) = @_;
    return 0 unless defined $to && $to ne '';
    return 1 if $to eq 'human';
    my $op = operator_id();
    return 1 if $op && $to eq $op;
}

# Past rows stored the placeholder. Rewrite them to the account id so the
# log and the chat agree. Unparseable lines stay byte for byte.
sub heal_operator_file {
    my ($path) = @_;
    my $op = operator_id();
    return [] unless $path && -f $path;
    open my $fh, '<', $path or return [];
    my (@lines, @objs, $changed);
    while (my $line = <$fh>) {
        chomp $line;
        next unless length $line;
        my $obj = eval { decode_json($line) };
        if (!$obj || ref $obj ne 'HASH') {
            push @lines, $line;
            next;
        }
        if ($op) {
            for my $k (qw(from to)) {
                next unless defined $obj->{$k} && $obj->{$k} eq 'human';
                $obj->{$k} = $op;
                $changed = 1;
            }
        }
        push @lines, encode_json($obj);
        push @objs, $obj;
    }
    close $fh;
    if ($changed) {
        open my $out, '>', $path or return \@objs;
        print $out $_, "\n" for @lines;
        close $out;
    }
    return \@objs;
}

sub load_chat_log {
    return unless $CHAT_LOG && -f $CHAT_LOG;
    my $rows = heal_operator_file($CHAT_LOG);
    if ($HUB_LOG && $HUB_LOG ne $CHAT_LOG && -f $HUB_LOG) {
        heal_operator_file($HUB_LOG);
    }
    push @log, @$rows;
    shift @log while @log > $MAX_LOG;
}

load_chat_log();

sub append_ndjson {
    my ($path, $obj) = @_;
    return unless $path;
    open my $fh, '>>', $path or return;
    print $fh encode_json($obj), "\n";
    close $fh;
}

sub log_msg {
    my ($obj) = @_;
    $obj->{ts} //= strftime("%Y-%m-%dT%H:%M:%SZ", gmtime);
    push @log, $obj;
    shift @log while @log > $MAX_LOG;
    append_ndjson($CHAT_LOG, $obj);
    append_ndjson($HUB_LOG, $obj) if !$CHAT_LOG || $HUB_LOG ne $CHAT_LOG;
}

sub send_json {
    my ($fh, $obj) = @_;
    my $line = encode_json($obj) . "\n";
    # non-blocking best-effort; real production would queue
    syswrite($fh, $line) or return;
}

sub fanout_to_members {
    my ($obj, $members) = @_;
    my $from = $obj->{from} // '';
    for my $id (@$members) {
        next if $id eq '' || $id eq 'human' || $id eq $from;
        next unless $agents{$id} && $agents{$id}{sock};
        send_json($agents{$id}{sock}, $obj);
    }
}

sub ensure_dm_channel {
    my ($id) = @_;
    return unless defined $id && $id ne '' && $id ne 'human' && $id ne 'all';
    $channels{$id} ||= {
        id      => $id,
        kind    => 'dm',
        name    => $id,
        members => [ 'human', $id ],
    };
}

sub ensure_group_channel {
    my ($id, $name, $members) = @_;
    $id =~ s/[^\w:.\-]+/_/g;
    $id = "g:$id" unless $id =~ /^g:/;
    my @m = ('human');
    my %seen = ( human => 1 );
    for my $x (@{ $members || [] }) {
        next unless defined $x && $x ne '';
        next if $seen{$x}++;
        push @m, $x;
    }
    $channels{$id} = {
        id      => $id,
        kind    => 'group',
        name    => ($name || $id),
        members => \@m,
    };
    return $channels{$id};
}

sub refresh_team_group {
    my @m = ('human');
    my %seen = ( human => 1 );
    for my $id (keys %agents) {
        next if $id =~ /^anon-/ || $id eq '';
        next if $seen{$id}++;
        push @m, $id;
    }
    ensure_group_channel('g:team', 'team', \@m);
}

sub route_message {
    my ($obj) = @_;
    $obj->{to} = normalize_to($obj->{to});
    stamp_operator($obj);
    log_msg($obj);

    my $to = $obj->{to} // '';
    # The operator reads the transcript. There is no socket for that account,
    # so a line addressed there is logged and not delivered.
    if (addressed_to_operator($to)) {
        return;
    }
    if (is_broadcast_to($to) || $to eq 'all') {
        # System log only. Work is never assigned via to=all unless lab flag.
        if ($HUB_BROADCAST) {
            fanout_to_members($obj, [ keys %agents ]);
        }
        return;
    }
    if (my $ch = $channels{$to}) {
        fanout_to_members($obj, $ch->{members} || []);
        return;
    }
    if (my $a = $agents{$to}) {
        ensure_dm_channel($to);
        send_json($a->{sock}, $obj);
        return;
    }
    send_json($agents{$obj->{from}}{sock}, {
        type => 'error', msg => "unknown target $to"
    }) if $obj->{from} && $agents{$obj->{from}};
}

sub handle_agent_line {
    my ($id, $line) = @_;
    my $obj = eval { decode_json($line) };
    return unless $obj && ref $obj eq 'HASH' && $obj->{type};

    if ($obj->{type} eq 'register') {
        $obj->{id} //= $id;
        bind_registered_agent($agents{$id}{sock}, $id, $obj->{id}, $agents{$id}{buf} // '');
        return;
    }
    if ($obj->{type} eq 'channel') {
        my $op = $obj->{op} // 'create';
        if ($op eq 'create') {
            my $ch = ensure_group_channel(
                $obj->{id} || ('g-' . int(time())),
                $obj->{name},
                $obj->{members} || [],
            );
            send_json($agents{$id}{sock}, { type => 'ack', channel => $ch->{id} })
                if $agents{$id};
        }
        return;
    }
    # Presence only. The connection id wins; a JSON from cannot spoof another berth.
    # Not fanned out and not written to the chat log.
    if (($obj->{type} // '') eq 'activity') {
        note_activity($id, $obj->{activity} // '');
        return;
    }
    # The chief's bridge files this. The connection id is the authority.
    # The model's chat line is not posted; the helper's result is.
    if (($obj->{type} // '') eq 'roster') {
        handle_roster($id, $obj);
        return;
    }
    # The program that creates a mate asks for one fixed line in that
    # mate's channel. The connection id is not the mate, so from on a
    # normal message cannot do this. Any other sentence is refused.
    if (($obj->{type} // '') eq 'hello') {
        crew_hello($id, $obj);
        return;
    }
    if (($obj->{type} // '') eq 'message') {
        my $body = $obj->{content} // '';
        $body =~ s/^\s+|\s+$//g;
        my $nfiles = 0;
        $nfiles = @{ $obj->{files} } if $obj->{files} && ref $obj->{files} eq 'ARRAY';
        return if $body eq '' && !$nfiles;
        $obj->{content} = $body;
    }
    $obj->{from} //= $id;
    route_message($obj);
}

# uid 0 is crewd-spawn. The hub's own uid is the throwaway test process.
sub crew_hello {
    my ($id, $obj) = @_;
    my $sock = $agents{$id} && $agents{$id}{sock};
    return unless $sock;
    my $uid = peer_uid($sock);
    my $peer_ok = defined $uid && $uid =~ /^\d+\z/ && ($uid == 0 || $uid == $>);
    my $alias = lc($obj->{alias} // '');
    my $content = $obj->{content} // '';
    my $body_ok = $alias =~ /^[a-z][a-z0-9]{0,15}\z/
        && $content eq 'whats up doc?';
    unless ($peer_ok && $body_ok) {
        send_json($sock, { type => 'ack', ok => JSON::PP::false, error => 'hello refused' });
        return;
    }
    if (hello_already($alias)) {
        send_json($sock, {
            type    => 'ack',
            ok      => JSON::PP::true,
            alias   => $alias,
            already => JSON::PP::true,
        });
        return;
    }
    my $line = {
        type    => 'message',
        from    => $alias,
        to      => 'human',
        content => 'whats up doc?',
    };
    stamp_operator($line);
    ensure_dm_channel($alias);
    log_msg($line);
    send_json($sock, { type => 'ack', ok => JSON::PP::true, alias => $alias });
}

sub hello_already {
    my ($alias) = @_;
    for my $m (@log) {
        next unless ($m->{type} // '') eq 'message';
        next unless ($m->{from} // '') eq $alias;
        return 1 if ($m->{content} // '') eq 'whats up doc?';
    }
    return 0;
}

# What the operator hears after a roster filing. The account is aboard only
# when the helper said so. No program names.
sub roster_words {
    my ($op, $alias, $work, $ans) = @_;
    $work = '' unless defined $work;
    $work =~ s/[\r\n\x00-\x1f"\\\[\]|]+/ /g;
    $work =~ s/\s+/ /g;
    $work =~ s/^\s+|\s+$//g;
    $work = substr($work, 0, 80);
    my $job = $work ne '' ? " ($work)" : '';
    my $asked = $op eq 'remove' ? "remove $alias" : "add $alias$job";
    if ($op eq 'remove' && $alias eq 'captain') {
        return 'The captain stays.';
    }
    if ($op eq 'remove' && $alias eq 'chief') {
        return 'The chief stays.';
    }
    my $ok = $ans && ref $ans eq 'HASH' && $ans->{ok};
    if ($ok) {
        return "I was asked to $asked. The account is gone." if $op eq 'remove';
        return "I was asked to $asked. The account exists.";
    }
    my $err = ($ans && ref $ans eq 'HASH') ? ($ans->{error} // '') : '';
    $err = 'the roster did not answer' if $err eq ''
        || $err =~ /Bearer|sk-or-|api_key|queue unavailable|crew helper timed out|bad helper reply/i;
    $err =~ s/crewd-spawn/the roster/g;
    $err =~ s/\bXvfb\b/a desktop/g;
    return 'The captain stays.' if $err eq 'the captain stays';
    return 'The chief stays.' if $err eq 'the chief stays';
    return "I was asked to $asked. The account already exists." if $err eq 'crew exists';
    return "I was asked to add $alias. That name is reserved." if $err eq 'reserved name';
    return "I was asked to remove $alias. Remove is not granted." if $err eq 'remove is not granted';
    return "I was asked to remove $alias. There is no such account." if $err eq 'no such crew';
    return "I was asked to $asked. They are still aboard. $err." if $op eq 'remove';
    return "I was asked to $asked. They are not aboard. $err.";
}

sub roster_target {
    my ($to) = @_;
    $to = '' unless defined $to;
    $to =~ s/^\s+|\s+$//g;
    return 'human' if $to eq '' || $to eq 'human';
    return $to if $to =~ /^[A-Za-z][A-Za-z0-9._-]{0,31}$/;
    return 'human';
}

sub emit_roster_result {
    my ($id, $obj, $text) = @_;
    my $to = roster_target($obj->{to});
    my $crew = $obj->{crew} ? 1 : 0;
    my $handoff = $obj->{handoff} ? 1 : 0;
    my $report = $obj->{report} ? 1 : 0;
    if ($crew && $handoff) {
        route_message({
            type => 'message', from => $id, to => 'human', content => $text,
        });
        if ($report && $to ne 'human') {
            route_message({
                type => 'message', from => $id, to => $to,
                content => $text, echo => 1,
            });
        }
        return;
    }
    if ($crew) {
        route_message({
            type => 'message', from => $id, to => $to,
            content => $text, reply => 1,
        });
        return;
    }
    route_message({
        type => 'message', from => $id, to => $to,
        content => $text, echo => 1,
    });
}

sub handle_roster {
    my ($id, $obj) = @_;
    return unless $id && $id eq 'chief';
    my $op = lc($obj->{op} // '');
    my $alias = lc($obj->{alias} // '');
    return unless $op eq 'add' || $op eq 'remove';
    return unless valid_crew_alias($alias);
    my $work = $obj->{work} // '';
    my $ans;
    if ($op eq 'remove' && ($alias eq 'captain' || $alias eq 'chief')) {
        $ans = {
            ok    => JSON::PP::false,
            error => $alias eq 'captain' ? 'the captain stays' : 'the chief stays',
        };
    }
    elsif ($op eq 'add' && $alias =~ /^(?:captain|chief|picobus|crewd|root|www)$/) {
        $ans = { ok => JSON::PP::false, error => 'reserved name' };
    }
    else {
        $ans = crew_call({ op => $op eq 'remove' ? 'remove' : 'create', alias => $alias, by => 'chief' });
    }
    emit_roster_result($id, $obj, roster_words($op, $alias, $work, $ans));
}

sub note_activity {
    my ($id, $state) = @_;
    return unless defined $id && exists $agents{$id};
    return unless $state eq 'thinking' || $state eq 'idle';
    $agents{$id}{activity}    = $state;
    $agents{$id}{activity_at} = time();
}

sub activity_now {
    my ($id) = @_;
    my $a = $agents{$id} or return 'idle';
    return 'idle' unless ($a->{activity} // '') eq 'thinking';
    my $at = $a->{activity_at} // 0;
    return 'idle' if time() - $at >= $ACTIVITY_STALE;
    return 'thinking';
}

sub expire_stale_activity {
    my $now = time();
    for my $id (keys %agents) {
        my $a = $agents{$id} or next;
        next unless ($a->{activity} // '') eq 'thinking';
        my $at = $a->{activity_at} // 0;
        if ($now - $at >= $ACTIVITY_STALE) {
            $a->{activity} = 'idle';
        }
    }
}

# Take the berth name for this socket. A second socket for an id that is
# already up replaces it quietly: no extra online line, and the retired
# socket's later close is not an offline.
sub bind_registered_agent {
    my ($fh, $old_id, $new, $buf) = @_;
    return unless $fh && defined $new && $new ne '' && $new !~ /^(?:anon|gone)-/;
    my $fn = fileno($fh);
    return unless defined $fn;
    if (!register_allowed($fh, $new)) {
        send_json($fh, { type => 'error', msg => 'register refused' });
        log_msg({ type => 'error', msg => 'register refused', id => $new });
        return 0;
    }
    if (defined $old_id && $old_id ne $new && $old_id =~ /^anon-/) {
        delete $agents{$old_id};
    }
    my $already = 0;
    if (my $prev = $agents{$new}) {
        my $ps = $prev->{sock};
        if ($ps && defined fileno($ps)) {
            $already = 1;
            my $oldfn = fileno($ps);
            $fd2id{$oldfn} = "gone-$oldfn" if defined $oldfn && $oldfn != $fn;
        }
    }
    my $activity = $already ? $agents{$new}{activity} : undef;
    my $activity_at = $already ? $agents{$new}{activity_at} : undef;
    $agents{$new} = { sock => $fh, buf => (defined $buf ? $buf : '') };
    $agents{$new}{activity} = $activity if defined $activity;
    $agents{$new}{activity_at} = $activity_at if defined $activity_at;
    $fd2id{$fn} = $new;
    ensure_dm_channel($new);
    refresh_team_group();
    log_msg({ type => 'register', id => $new }) unless $already;
    return 1;
}

sub close_agent {
    my ($fh) = @_;
    my $fn = fileno($fh);
    my $id = delete $fd2id{$fn};
    if (defined $id && $id =~ /^anon-/) {
        delete $agents{$id};
    } elsif (defined $id && $id !~ /^gone-/) {
        my $cur = $agents{$id};
        if ($cur && $cur->{sock} && defined fileno($cur->{sock}) && fileno($cur->{sock}) == $fn) {
            delete $agents{$id};
            log_msg({ type => 'disconnect', id => $id });
        }
    }
    $sel->remove($fh);
    close $fh;
}

sub setup_secret {
    mkdir $SECRETS_DIR, 0700 unless -d $SECRETS_DIR;
    my $p = "$SECRETS_DIR/session.key";
    if (!-f $p) {
        my $k = sprintf('%08x%08x%08x%08x', map { int(rand(2**32)) } 1 .. 4);
        open my $fh, '>', $p or return 'dev-setup-key';
        print $fh $k;
        close $fh;
        chmod 0600, $p;
    }
    open my $fh, '<', $p or return 'dev-setup-key';
    my $k = <$fh>;
    close $fh;
    chomp $k;
    return $k || 'dev-setup-key';
}

sub load_setup {
    return unless $SETUP_FILE && -f $SETUP_FILE;
    open my $fh, '<', $SETUP_FILE or return;
    local $/;
    return eval { decode_json(<$fh>) };
}

sub setup_complete {
    my $s = load_setup();
    return $s && $s->{complete};
}

sub llm_configured {
    my $s = load_setup() || {};
    return 1 if $s->{llm_key};
    return 1 if -f "$SECRETS_DIR/security.yml";
    return 1 if -f '/root/.picoclaw/.security.yml';
    return 0;
}

sub bcrypt_hash {
    my ($pw) = @_;
    my @c = ('.', '/', 0 .. 9, 'A' .. 'Z', 'a' .. 'z');
    my $salt = join '', map { $c[ int rand @c ] } 1 .. 22;
    return crypt($pw, '$2b$10$' . $salt);
}

sub bcrypt_ok {
    my ($pw, $hash) = @_;
    return 0 unless $hash && $pw;
    my $c = crypt($pw, $hash);
    return defined $c && $c eq $hash;
}

# ALTCHA-compatible PoW (same protocol as zhc-altcha.php / altcha.org).
sub pow_challenge {
    my $max  = 100000;
    my $n    = 1 + int(rand($max));
    my $salt = sprintf('%08x%08x', time(), int(rand(2**32)));
    my $challenge = sha256_hex($salt . $n);
    my $sig       = hmac_sha256_hex($challenge, setup_secret());
    return {
        algorithm => 'SHA-256',
        challenge => $challenge,
        salt      => $salt,
        signature => $sig,
        maxnumber => $max,
    };
}

sub pow_ok {
    my ($challenge, $salt, $number, $sig) = @_;
    return 0 unless $challenge && $salt && defined $number && $sig;
    return 0 unless hmac_sha256_hex($challenge, setup_secret()) eq $sig;
    return sha256_hex($salt . $number) eq $challenge;
}

# Official ALTCHA widget posts `altcha` as base64(JSON{algorithm,challenge,number,salt,signature}).
sub parse_altcha {
    my ($obj) = @_;
    $obj ||= {};
    my ($ch, $salt, $n, $sig) = @$obj{qw(challenge salt number signature)};
    my $raw = $obj->{altcha} // '';
    if (length $raw) {
        my $txt = $raw;
        if ($txt !~ /^\s*\{/) {
            $txt = eval { decode_base64($raw) } // '';
        }
        if ($txt =~ /^\s*\{/) {
            my $p = eval { decode_json($txt) } || {};
            $ch   = $p->{challenge} // $ch;
            $salt = $p->{salt}      // $salt;
            $n    = $p->{number}    // $n;
            $sig  = $p->{signature} // $sig;
        }
    }
    return ($ch, $salt, $n, $sig);
}

sub http_date {
    return strftime('%a, %d %b %Y %H:%M:%S GMT', gmtime($_[0] || time));
}

sub share_file {
    my ($name) = @_;
    return unless $name && $name =~ /^[A-Za-z0-9._-]+$/;
    for my $root ($SHARE_DIR, '/usr/local/share/picobus') {
        next unless $root && length $root;
        my $p = "$root/shared/$name";
        return $p if -f $p;
    }
    return;
}

# /dc/chrome.js, /dc/chrome.css, /dc/icons/<name>.svg. No dot segments.
sub dc_asset_rel {
    my ($path) = @_;
    return unless defined $path;
    return $1 if $path =~ m{\A/dc/(chrome\.js|chrome\.css|icons/[a-z0-9]+(?:-[a-z0-9]+)*\.svg)\z};
    return;
}

sub dc_asset_file {
    my ($rel) = @_;
    return unless defined $rel && $rel !~ m{\.\.};
    for my $root ($SHARE_DIR, '/usr/local/share/picobus') {
        next unless defined $root && length $root;
        my $p = "$root/dc/$rel";
        my @st = lstat($p);
        next unless @st;
        next if -l _;
        next unless -f _;
        next if ($st[7] // 0) <= 0 || $st[7] > 262144;
        return $p;
    }
    return;
}

sub serve_dc_asset {
    my ($path) = @_;
    my $rel = dc_asset_rel($path);
    return 0 unless defined $rel;
    my $file = dc_asset_file($rel);
    my $s = '';
    my $n = 0;
    if ($file && open my $fh, '<:raw', $file) {
        $n = read($fh, $s, 262144);
        close $fh;
    }
    if (!$n) {
        fcgi_print('text/plain; charset=utf-8', "not found\n", '404 Not Found');
        return 1;
    }
    my $ct = 'application/octet-stream';
    $ct = 'text/css; charset=utf-8' if $rel =~ /\.css\z/;
    $ct = 'text/javascript; charset=utf-8' if $rel =~ /\.js\z/;
    $ct = 'image/svg+xml' if $rel =~ /\.svg\z/;
    fcgi_print($ct, $s);
    return 1;
}

# Install assets. No session. The worker does not store a response.
my %PWA_ICON;

sub pwa_manifest {
    my $name = $PRODUCT;
    $name = 'picobus' unless defined $name && length $name;
    $name =~ s/[\x00-\x1f]//g;
    my $short = $name;
    $short = substr($short, 0, 12) if length($short) > 12;
    return encode_json({
        name             => $name,
        short_name       => $short,
        start_url        => '/',
        scope            => '/',
        display          => 'standalone',
        background_color => '#313338',
        theme_color      => '#313338',
        icons            => [
            { src => '/icon-192.png', sizes => '192x192', type => 'image/png', purpose => 'any' },
            { src => '/icon-512.png', sizes => '512x512', type => 'image/png', purpose => 'any' },
        ],
    });
}

sub pwa_worker {
    return <<'SW';
self.addEventListener('install', function () {
  self.skipWaiting();
});
self.addEventListener('activate', function (event) {
  event.waitUntil(self.clients.claim());
});
self.addEventListener('fetch', function (event) {
  event.respondWith(fetch(event.request));
});
SW
}

sub pwa_icon {
    my ($name) = @_;
    return $PWA_ICON{$name} if exists $PWA_ICON{$name};
    my $bytes;
    for my $root ($SHARE_DIR, '/usr/local/share/picobus') {
        next unless defined $root && length $root;
        my $p = "$root/pwa/$name";
        my @st = lstat($p);
        next unless @st;
        next if -l _;
        next unless -f _;
        next if ($st[7] // 0) <= 0 || $st[7] > 1048576;
        next unless open my $fh, '<:raw', $p;
        local $/;
        $bytes = <$fh>;
        close $fh;
        last if defined $bytes && length $bytes;
    }
    $PWA_ICON{$name} = $bytes;
    return $bytes;
}

sub serve_pwa {
    my ($path, $method) = @_;
    my $kind = '';
    $kind = 'manifest' if $path eq '/manifest.webmanifest';
    $kind = 'worker'   if $path eq '/sw.js';
    $kind = 'icon192'  if $path eq '/icon-192.png';
    $kind = 'icon512'  if $path eq '/icon-512.png';
    return 0 unless $kind;
    if ($method ne 'GET' && $method ne 'HEAD') {
        fcgi_print('text/plain; charset=utf-8', "method not allowed\n", '405 Method Not Allowed');
        return 1;
    }
    my ($ct, $body);
    if ($kind eq 'manifest') {
        $ct   = 'application/manifest+json';
        $body = pwa_manifest();
    } elsif ($kind eq 'worker') {
        $ct   = 'text/javascript; charset=utf-8';
        $body = pwa_worker();
    } else {
        $ct   = 'image/png';
        $body = pwa_icon($kind eq 'icon192' ? 'icon-192.png' : 'icon-512.png');
        if (!defined $body || $body eq '') {
            fcgi_print('text/plain; charset=utf-8', "not found\n", '404 Not Found');
            return 1;
        }
    }
    $body = '' if $method eq 'HEAD';
    fcgi_print($ct, $body);
    return 1;
}

sub write_llm_secrets {
    my ($base, $key, $mgmt) = @_;
    mkdir $SECRETS_DIR, 0700 unless -d $SECRETS_DIR;
    $base ||= 'https://openrouter.ai/api/v1';
    $base =~ s{/+$}{};
    my $alias = $ENV{PICOBUS_LLM_ALIAS} // 'default';
    my $model = 'nvidia/nemotron-3-ultra-550b-a55b:free';
    $key =~ s/\\/\\\\/g;
    $key =~ s/"/\\"/g;
    $mgmt =~ s/\\/\\\\/g;
    $mgmt =~ s/"/\\"/g;

    # Keep the pico token. Replacing the whole file used to drop
    # channel_list, and a symlink into secrets/ is unreadable by the
    # gateway user (that directory is 0700 root).
    my $channel = '';
    my $sec_path = "$PICO_HOME/.security.yml";
    my $sec_read = $sec_path;
    if (-l $sec_path) {
        my $rel = readlink $sec_path;
        $sec_read = ($rel =~ m{\A/}) ? $rel : "$PICO_HOME/$rel";
    }
    for my $cand ($sec_read, "$SECRETS_DIR/security.yml") {
        next unless defined $cand && -f $cand;
        open my $old, '<', $cand or next;
        local $/;
        my $txt = <$old> // '';
        close $old;
        if ($txt =~ /(^channel_list:\n(?:[ \t].*\n)*)/m) {
            $channel = $1;
            last;
        }
    }
    # The captain key is written onto the captain. A management key stays
    # in the secrets dir. With both, the other mates get unique keys.
    # With only the captain key, crewd-spawn copies it onto mates that
    # have none.
    my $yaml = "model_list:\n";
    $yaml .= "  $alias:\n    api_keys:\n      - \"$key\"\n" if $key ne '';
    $yaml .= "  openrouter-mgmt:\n    api_keys:\n      - \"$mgmt\"\n" if $mgmt ne '';
    $yaml .= $channel if $channel ne '';
    if (open my $fh, '>', "$SECRETS_DIR/security.yml") {
        print $fh $yaml;
        close $fh;
        chmod 0600, "$SECRETS_DIR/security.yml";
    }
    mkdir $PICO_HOME, 0700 unless -d $PICO_HOME;
    unlink $sec_path if -l $sec_path;
    if ($key ne '' && open my $pf, '>', $sec_path) {
        my $cap = "model_list:\n  $alias:\n    api_keys:\n      - \"$key\"\n";
        $cap .= $channel if $channel ne '';
        print $pf $cap;
        close $pf;
        chmod 0660, $sec_path;
    }
    my $cfg;
    if (open my $cf, '<', "$PICO_HOME/config.json") {
        local $/;
        $cfg = eval { decode_json(<$cf> // '') };
        close $cf;
    }
    if (ref $cfg ne 'HASH') {
        $cfg = {
            agents => {
                defaults => {
                    workspace             => "$PICO_HOME/workspace",
                    restrict_to_workspace => JSON::PP::true,
                    max_tokens            => 8192,
                },
            },
        };
    }
    $cfg->{agents}{defaults}{model_name} = $alias;
    $cfg->{agents}{defaults}{workspace} //= "$PICO_HOME/workspace";
    $cfg->{agents}{defaults}{restrict_to_workspace} = JSON::PP::true;
    $cfg->{agents}{defaults}{max_tokens} //= 8192;
    my $list = $cfg->{model_list};
    $list = [] unless ref $list eq 'ARRAY';
    my $found = 0;
    for my $row (@$list) {
        next unless ref $row eq 'HASH';
        my $n = $row->{model_name} // $row->{name} // '';
        next unless $n eq $alias;
        $row->{model_name} = $alias;
        delete $row->{name};
        delete $row->{api_key};
        delete $row->{api_keys};
        $row->{model}    ||= $model;
        $row->{api_base}   = $base;
        $row->{provider} ||= 'openrouter';
        $found = 1;
    }
    push @$list, {
        model_name => $alias,
        provider   => 'openrouter',
        model      => $model,
        api_base   => $base,
    } unless $found;
    $cfg->{model_list} = $list;
    if (open my $out, '>', "$PICO_HOME/config.json") {
        print $out encode_json($cfg);
        close $out;
    }
    if (open my $mf, '>', "$SECRETS_DIR/llm.json") {
        print $mf encode_json({
            api_base     => $base,
            shared_key   => ($key ne '' && $mgmt eq '') ? JSON::PP::true : JSON::PP::false,
            has_mgmt_key => ($mgmt ne '') ? JSON::PP::true : JSON::PP::false,
        });
        close $mf;
        chmod 0600, "$SECRETS_DIR/llm.json";
    }
    # Chief is created before this signup, so his home has no key yet.
    # A shared key is already on the captain; a missed copy can be retried.
    # Allocation is the signup when the only secret is a management key.
    my $ans = crew_call({ op => 'keys' });
    if ($mgmt ne '' && (ref $ans ne 'HASH' || !$ans->{ok})) {
        my $msg = (ref $ans eq 'HASH' ? ($ans->{error} // '') : '');
        $msg =~ s/[\r\n].*//s;
        $msg = 'could not allocate a key for each mate'
            if $msg eq '' || $msg =~ /Bearer|sk-or-|api_key/i;
        return { ok => JSON::PP::false, error => $msg };
    }
    return;
}

sub save_setup {
    my ($obj) = @_;
    mkdir _parent_dir($SETUP_FILE), 0755;
    open my $fh, '>', $SETUP_FILE or return 0;
    print $fh encode_json($obj);
    close $fh;
    chmod 0600, $SETUP_FILE;
    return 1;
}

# ---------- humans, roles, channel grants ----------
# One human (the setup manager) sees every channel. A second human turns
# grants on for everyone, including that manager. Role child is reserved.
# PICOBUS_ZHC_GATE keeps the site session and does not use these grants.

sub read_json_file {
    my ($path) = @_;
    return unless $path && -f $path;
    open my $fh, '<', $path or return;
    local $/;
    my $j = eval { decode_json(<$fh>) };
    close $fh;
    return ($j && ref $j eq 'HASH') ? $j : undef;
}

sub write_json_file {
    my ($path, $obj) = @_;
    return 0 unless $path;
    my $dir = _parent_dir($path);
    mkdir $dir, 0755 if $dir && !-d $dir;
    open my $fh, '>', $path or return 0;
    print $fh encode_json($obj);
    close $fh;
    chmod 0600, $path;
    return 1;
}

sub load_principals {
    my $p = read_json_file($PRINCIPALS_FILE);
    return $p if $p && keys %$p;
    my $s = load_setup() or return {};
    return {} unless $s->{complete} && $s->{user} && $s->{pass_hash};
    $p = {
        $s->{user} => {
            id        => $s->{user},
            role      => 'manager',
            status    => 'active',
            founder   => JSON::PP::true,
            pass_hash => $s->{pass_hash},
        },
    };
    write_json_file($PRINCIPALS_FILE, $p);
    return $p;
}

sub save_principals { write_json_file($PRINCIPALS_FILE, $_[0]) }

sub load_grants { read_json_file($GRANTS_FILE) || {} }
sub save_grants { write_json_file($GRANTS_FILE, $_[0]) }

sub load_sessions { read_json_file($SESSIONS_FILE) || {} }
sub save_sessions { write_json_file($SESSIONS_FILE, $_[0]) }

sub acl_strict {
    return 0 if zhc_gate();
    my $p = load_principals();
    return (scalar keys %$p) > 1;
}

sub principal_suspended {
    my ($u) = @_;
    return $u && ($u->{status} // '') eq 'suspended';
}

sub grant_row {
    my ($id, $chan) = @_;
    my $g = load_grants();
    return unless $g->{$chan} && ref $g->{$chan} eq 'HASH';
    return $g->{$chan}{$id};
}

sub can_read {
    my ($user, $chan) = @_;
    return 0 unless $user && ref $user eq 'HASH';
    return 0 if principal_suspended($user);
    return 1 unless acl_strict();
    my $row = grant_row($user->{id}, $chan) or return 0;
    return ($row->{read} || $row->{write}) ? 1 : 0;
}

sub can_write {
    my ($user, $chan) = @_;
    return 0 unless $user && ref $user eq 'HASH';
    return 0 if principal_suspended($user);
    return 1 unless acl_strict();
    my $row = grant_row($user->{id}, $chan) or return 0;
    return $row->{write} ? 1 : 0;
}

sub valid_user_id {
    my ($id) = @_;
    return $id && $id =~ /^[a-zA-Z][a-zA-Z0-9._-]{1,31}$/;
}

sub valid_crew_alias {
    my ($id) = @_;
    return $id && $id =~ /^[a-z][a-z0-9]{0,15}$/;
}

# A grant is 0 or 1. JSON true and false count. Anything else is refused.
sub grant_bit {
    my ($v) = @_;
    return 0 if !defined $v || $v eq '';
    if (ref $v) {
        return -1 unless JSON::PP::is_bool($v);
        return $v ? 1 : 0;
    }
    return 0 if $v eq '0';
    return 1 if $v eq '1';
    return -1;
}

sub crew_rows {
    my $path = '/var/picobus/crew.tab';
    my @rows;
    open my $fh, '<', $path or return \@rows;
    while (my $line = <$fh>) {
        chomp $line;
        my ($alias, $port, $net, $desk, $db) = split ' ', $line;
        next unless defined $db && valid_crew_alias($alias);
        push @rows, {
            alias   => $alias,
            port    => 0 + $port,
            network => ($net  eq '1') ? JSON::PP::true : JSON::PP::false,
            desktop => ($desk eq '1') ? JSON::PP::true : JSON::PP::false,
            db      => ($db   eq '1') ? JSON::PP::true : JSON::PP::false,
            dbname  => $alias,
        };
    }
    close $fh;
    return \@rows;
}

# Tests point this at a directory the hub is allowed to write. Production
# leaves it unset. A relative path or a .. segment is ignored.
sub crew_queue_dir {
    my $dir = $ENV{CREW_QUEUE} // '';
    if ($dir =~ m{\A/} && $dir !~ m{\.\.} && $dir =~ m{\A[-A-Za-z0-9_./]+\z} && length($dir) < 200) {
        return $dir;
    }
    return '/var/picobus/crew-queue';
}

# The hub is pledged and cannot useradd. crewd-spawn listen runs as root.
sub crew_call {
    my ($fields) = @_;
    my $dir = crew_queue_dir();
    mkdir $dir, 0700 unless -d $dir;
    my $id = sprintf('%d-%d-%d', time, $$, int(rand(100000)));
    my $tmp = "$dir/$id.tmp";
    my $req = "$dir/$id.req";
    my $res = "$dir/$id.res";
    open my $fh, '>', $tmp or return { ok => JSON::PP::false, error => 'queue unavailable' };
    for my $k (sort keys %$fields) {
        my $v = $fields->{$k} // '';
        $v =~ s/[\r\n=]//g;
        print $fh "$k=$v\n";
    }
    close $fh;
    rename $tmp, $req or do {
        unlink $tmp;
        return { ok => JSON::PP::false, error => 'queue unavailable' };
    };
    # useradd plus a key allocation can run past a short poll.
    for (1 .. 450) {
        if (-s $res) {
            open my $rf, '<', $res or last;
            local $/;
            my $txt = <$rf> // '';
            close $rf;
            unlink $req, $res;
            my $obj = eval { decode_json($txt) };
            return $obj if ref $obj eq 'HASH';
            return { ok => JSON::PP::false, error => 'bad helper reply' };
        }
        select undef, undef, undef, 0.2;
    }
    unlink $req, $tmp;
    return { ok => JSON::PP::false, error => 'crew helper timed out' };
}

sub role_ok {
    my ($role) = @_;
    return $role && ($role eq 'worker' || $role eq 'coworker' || $role eq 'manager');
}

sub session_cookie_name {
    my $p = $COOKIE_PREFIX;
    $p =~ s/[^A-Za-z0-9_]//g;
    $p = 'PICOBUS' unless length $p;
    return $p . '_SESS';
}

sub cookie_value {
    my ($name) = @_;
    my $c = $ENV{HTTP_COOKIE} // '';
    return unless $c =~ /(?:^|;\s*)\Q$name\E=([^;]*)/;
    my $v = $1;
    $v =~ s/^\s+|\s+$//g;
    return $v;
}

sub session_cookie_hdr {
    my ($token) = @_;
    my $name = session_cookie_name();
    if (!defined $token || $token eq '') {
        return "$name=; HttpOnly; SameSite=Lax; Path=/; Max-Age=0";
    }
    return "$name=$token; HttpOnly; SameSite=Lax; Path=/";
}

sub mint_session {
    my ($id) = @_;
    my $token = sprintf('%08x%08x%08x%08x', map { int(rand(2**32)) } 1 .. 4);
    my $all = load_sessions();
    my $now = time();
    for my $k (keys %$all) {
        delete $all->{$k} if ($all->{$k}{exp} // 0) < $now;
    }
    $all->{$token} = { user => $id, exp => $now + 14 * 24 * 3600 };
    save_sessions($all);
    return $token;
}

sub drop_user_sessions {
    my ($id) = @_;
    my $all = load_sessions();
    for my $k (keys %$all) {
        delete $all->{$k} if ($all->{$k}{user} // '') eq $id;
    }
    save_sessions($all);
}

sub session_principal {
    my $token = cookie_value(session_cookie_name());
    return unless $token;
    my $all = load_sessions();
    my $row = $all->{$token} or return;
    if (($row->{exp} // 0) < time()) {
        delete $all->{$token};
        save_sessions($all);
        return;
    }
    my $p = load_principals();
    my $u = $p->{ $row->{user} // '' } or return;
    return $u;
}

sub public_user {
    my ($u) = @_;
    return {
        id      => $u->{id},
        role    => $u->{role},
        status  => $u->{status} // 'active',
        founder => $u->{founder} ? JSON::PP::true : JSON::PP::false,
    };
}

sub arm_founder_grants {
    my ($founder_id) = @_;
    my $g = load_grants();
    for my $cid (keys %$g) {
        return if $g->{$cid} && $g->{$cid}{$founder_id};
    }
    for my $cid (keys %channels, 'all') {
        $g->{$cid}{$founder_id} = {
            read  => JSON::PP::true,
            write => JSON::PP::true,
        };
    }
    save_grants($g);
}

sub peer_uid {
    my ($sock) = @_;
    return unless $sock;
    my $cred = getsockopt($sock, SOL_SOCKET, 0x1022);
    return unless defined $cred && length($cred) >= 4;
    my ($uid) = unpack('L', $cred);
    return $uid;
}

sub uid_map {
    my $m = read_json_file($UID_MAP);
    return {} unless $m;
    my %out;
    for my $id (keys %$m) {
        my $uid = $m->{$id};
        next unless defined $uid && $uid =~ /^\d+$/;
        $out{$id} = 0 + $uid;
    }
    return \%out;
}

sub register_allowed {
    my ($sock, $id) = @_;
    return 0 if !defined $id || $id eq '' || $id eq 'human' || $id =~ /^anon-/;
    my $map = uid_map();
    return 1 unless $map && keys %$map;
    return 0 unless exists $map->{$id};
    my $uid = peer_uid($sock);
    return defined $uid && $uid == $map->{$id};
}

# ---------- FastCGI: Discord-alike UI + JSON API ----------
# POST: read CONTENT_LENGTH + STDIN (urlencoded forms AND JSON /api/send).
# QUERY_STRING still works for GET inject / ?format=json.

sub parse_urlencoded {
    my ($s) = @_;
    my %q;
    return \%q unless defined $s && length $s;
    for my $kv (split /[&;]/, $s) {
        next unless length $kv;
        my ($k, $v) = split /=/, $kv, 2;
        $v = '' unless defined $v;
        for ($k, $v) {
            tr/+/ /;
            s/%([0-9A-Fa-f]{2})/chr(hex($1))/ge;
        }
        $q{$k} = $v;
    }
    return \%q;
}

sub fcgi_path {
    my $uri = $ENV{REQUEST_URI} // '';
    $uri =~ s/\?.*//s;
    my $pi = $ENV{PATH_INFO}   // '';
    my $sn = $ENV{SCRIPT_NAME} // '';
    return $uri if $uri =~ m{/api/};
    return $pi  if $pi  =~ m{/api/};
    return $sn  if $sn  =~ m{/api/};
    return $uri if length $uri;
    return $pi  if length $pi;
    return length $sn ? $sn : '/';
}

# When set, handle_fcgi writes CGI bytes here instead of tied FCGI STDOUT.
my ($FCGI_BUF, $FCGI_STDIN_BUF);

sub fcgi_read_body {
    my ($cap) = @_;
    $cap ||= 65536;
    if (defined $FCGI_STDIN_BUF) {
        my $b = $FCGI_STDIN_BUF;
        $FCGI_STDIN_BUF = '';
        return $b;
    }
    my $len = $ENV{CONTENT_LENGTH};
    return '' unless defined $len && $len =~ /^\d+$/ && $len > 0;
    my $want = $len > $cap ? $cap : $len;
    my $buf = '';
    while (length($buf) < $want) {
        my $n = read(STDIN, my $chunk, $want - length($buf));
        last if !defined $n || $n == 0;
        $buf .= $chunk;
    }
    return $buf;
}

sub cgi_out {
    my ($headers, $body) = @_;
    $body //= '';
    if (zhc_gate() && $headers !~ /X-Content-Type-Options:/i) {
        $headers =~ s/\r\n\r\n/\r\nX-Content-Type-Options: nosniff\r\nX-Frame-Options: DENY\r\nReferrer-Policy: no-referrer\r\nX-Robots-Tag: noindex, nofollow\r\n\r\n/;
    }
    if (defined $FCGI_BUF) {
        $FCGI_BUF .= $headers . $body;
        return;
    }
    print $headers, $body;
}

sub fcgi_print {
    my ($ctype, $body, $status) = @_;
    $status //= '200 OK';
    cgi_out(
        "Status: $status\r\nCache-Control: no-store\r\nContent-Type: $ctype\r\n\r\n",
        $body
    );
}

sub json_out {
    my ($code, $obj, $hdr) = @_;
    $hdr ||= {};
    my %st = (
        200 => '200 OK',
        304 => '304 Not Modified',
        400 => '400 Bad Request',
        401 => '401 Unauthorized',
        403 => '403 Forbidden',
        404 => '404 Not Found',
        405 => '405 Method Not Allowed',
        413 => '413 Payload Too Large',
        503 => '503 Service Unavailable',
    );
    my $cc = $hdr->{cache} // 'no-store';
    my $extra = '';
    $extra .= 'ETag: "' . $hdr->{etag} . '"' . "\r\n" if $hdr->{etag};
    $extra .= 'Expires: ' . $hdr->{expires} . "\r\n" if $hdr->{expires};
    $extra .= 'Set-Cookie: ' . $hdr->{cookie} . "\r\n" if $hdr->{cookie};
    if ($code == 304) {
        cgi_out("Status: 304 Not Modified\r\nCache-Control: $cc\r\n${extra}\r\n");
        return;
    }
    my $body = encode_json($obj);
    cgi_out(
        "Status: " . ($st{$code} // "$code")
        . "\r\nCache-Control: $cc\r\n${extra}"
        . "Content-Type: application/json; charset=utf-8\r\n\r\n",
        $body
    );
}

sub normalize_to {
    my ($to) = @_;
    $to = '' unless defined $to;
    $to =~ s/^\s+|\s+$//g;
    my $lc = lc $to;
    return 'all' if $to eq '' || $lc eq 'all' || $lc eq 'broadcast'
        || $lc eq '#broadcast' || $lc eq 'everyone';
    $to =~ s/^@//;
    return $to;
}

sub inject_human_message {
    my ($from, $to, $content, $files) = @_;
    $from = 'human' unless defined $from && length $from;
    $content = '' unless defined $content;
    $content =~ s/^\s+|\s+$//g;
    $files = [] unless $files && ref $files eq 'ARRAY';
    return 0 unless length $content || @$files;
    my $obj = {
        type    => 'message',
        from    => $from,
        to      => normalize_to($to),
        content => $content,
        id      => 'h-' . time() . int(rand(1000)),
    };
    $obj->{files} = $files if @$files;
    route_message($obj);
    return 1;
}

sub hub_state_message {
    my ($m) = @_;
    my $out = {
        ts      => $m->{ts}      // '',
        type    => $m->{type}    // '',
        from    => $m->{from}    // '',
        to      => $m->{to}      // '',
        content => $m->{content} // $m->{msg} // '',
        id      => $m->{id}      // '',
    };
    if ($m->{files} && ref $m->{files} eq 'ARRAY' && @{$m->{files}}) {
        $out->{files} = $m->{files};
    }
    return $out;
}

sub is_broadcast_to {
    my ($to) = @_;
    $to = '' unless defined $to;
    $to =~ s/^@//;
    my $lc = lc $to;
    return 1 if $to eq '' || $lc eq 'all' || $lc eq 'broadcast'
        || $lc eq '#broadcast' || $lc eq 'everyone';
    return 0;
}

sub in_channel {
    my ($m, $chan) = @_;
    $chan ||= 'all';
    my $t   = $m->{type} // '';
    my $who = $m->{from} // '';
    my $to  = $m->{to}   // '';
    $to =~ s/^@//;
    if ($chan eq 'all') {
        return 1 if $t eq 'register' || $t eq 'disconnect' || $t eq 'error' || $t eq 'ack';
        return is_broadcast_to($to);
    }
    # Presence is a #system note, not a line in the berth transcript.
    return 0 if $t eq 'register' || $t eq 'disconnect';
    if (($channels{$chan}{kind} // '') eq 'group') {
        return 1 if $to eq $chan;
        return 0;
    }
    return 0 if ($channels{$to}{kind} // '') eq 'group';
    return 1 if $to eq $chan;
    return 1 if $who eq $chan && !is_broadcast_to($to);
    return 0;
}

# A file chip is always one line. Text wraps as newline count + 1, plus a meta line.
sub msg_lines {
    my ($m) = @_;
    my $n = 1;
    if ($m->{files} && ref $m->{files} eq 'ARRAY') {
        $n += scalar @{ $m->{files} };
    }
    my $c = $m->{content} // $m->{msg} // '';
    if (length $c) {
        $n += ($c =~ tr/\n//) + 1;
    }
    return $n < 1 ? 1 : $n;
}

# #system shows one online and one offline per real transition. A berth that
# re-registers while it is still up, and the old copies of that in the log,
# do not each get a line.
sub history_rows {
    my ($chan) = @_;
    $chan ||= 'all';
    my @rows = grep { in_channel($_, $chan) } @log;
    return @rows if $chan ne 'all';
    my %up;
    my @kept;
    for my $m (@rows) {
        my $t  = $m->{type} // '';
        my $id = $m->{id} // $m->{from} // '';
        if ($t eq 'register') {
            next if $id eq '' || $up{$id};
            $up{$id} = 1;
        } elsif ($t eq 'disconnect') {
            next if $id eq '' || !$up{$id};
            $up{$id} = 0;
        }
        push @kept, $m;
    }
    return @kept;
}

sub history_page {
    my ($chan, $page, $lines_per) = @_;
    $chan ||= 'all';
    $lines_per = 32 if !$lines_per || $lines_per < 8;
    $lines_per = 80 if $lines_per > 80;
    my @ch = history_rows($chan);
    my @lens = map { msg_lines($_) } @ch;

    # Pack whole messages (oldest = page 1). A message that does not fit the
    # room left on a page starts the next one, so leftover lines are wasted.
    # ceil(total_lines / budget) ignores that waste and is short by a page;
    # "last" and a click on the highest number then stay on the previous page.
    my @page_idx;
    my ($pno, $used) = (1, 0);
    for my $i (0 .. $#ch) {
        my $need = $lens[$i];
        if ($used && $used + $need > $lines_per) {
            $pno++;
            $used = 0;
        }
        push @{ $page_idx[$pno] }, $i;
        $used += $need;
    }
    my $pages = $pno;
    # page < 1 means last (the API passes -1 for an omitted page and "last").
    $page = $pages if !defined $page || $page < 1 || $page > $pages;
    my @slice = map { $ch[$_] } @{ $page_idx[$page] || [] };
    return {
        channel => $chan,
        page    => $page + 0,
        pages   => $pages + 0,
        lines   => $lines_per + 0,
        total   => scalar(@ch),
        seq     => scalar(@log),
        messages => [ map { hub_state_message($_) } @slice ],
    };
}

sub file_meta_path { "$FILE_DIR/$_[0].json" }
sub file_blob_path { "$FILE_DIR/$_[0].bin" }

sub new_file_id {
    my $id = sprintf('%08x%08x', time(), int(rand(2**32)));
    $id .= sprintf('%04x', int(rand(0x10000)));
    return $id;
}

sub file_visible {
    my ($user, $meta) = @_;
    return 0 unless $user;
    return 1 unless acl_strict();
    return 1 if ($meta->{owner} // '') ne '' && $meta->{owner} eq $user->{id};
    my $id = $meta->{id} // '';
    return 0 if $id eq '';
    for my $m (@log) {
        next unless $m->{files} && ref $m->{files} eq 'ARRAY';
        my $hit = 0;
        for my $f (@{ $m->{files} }) {
            $hit = 1 if $f && ref $f eq 'HASH' && ($f->{id} // '') eq $id;
        }
        next unless $hit;
        return 1 if can_read($user, normalize_to($m->{to} // ''));
    }
    return 0;
}

sub has_any_write {
    my ($user) = @_;
    return 0 unless $user;
    return 1 unless acl_strict();
    return 1 if can_write($user, 'all');
    for my $cid (keys %channels) {
        return 1 if can_write($user, $cid);
    }
    my $g = load_grants();
    for my $chan (keys %$g) {
        return 1 if can_write($user, $chan);
    }
    return 0;
}

sub save_upload {
    my ($name, $mime, $bytes, $owner) = @_;
    return unless defined $bytes && length $bytes;
    return if length($bytes) > $MAX_UPLOAD;
    $name = 'file' unless defined $name && $name =~ /\S/;
    $name =~ s{.*/}{};
    $name =~ s{[^\w.\- +()\[\]]+}{_}g;
    $name = substr($name, 0, 180);
    $mime ||= 'application/octet-stream';
    my $id = new_file_id();
    mkdir $FILE_DIR, 0755 unless -d $FILE_DIR;
    open my $bf, '>', file_blob_path($id) or return;
    binmode $bf;
    print $bf $bytes;
    close $bf;
    my $meta = {
        id    => $id,
        name  => $name,
        bytes => length($bytes),
        mime  => $mime,
        url   => (zhc_gate() ? zhc_req_prefix() . '/api/v1/dc/files/' : '/api/files/') . $id,
        owner => $owner // '',
    };
    if (open my $mf, '>', file_meta_path($id)) {
        print $mf encode_json($meta);
        close $mf;
    }
    return $meta;
}

sub load_file_meta {
    my ($id) = @_;
    return unless $id && $id =~ /^[0-9a-fA-F]{8,}$/;
    open my $mf, '<', file_meta_path($id) or return;
    local $/;
    my $j = eval { decode_json(<$mf>) };
    close $mf;
    return $j;
}

sub agent_record {
    my ($id, $live) = @_;
    return {
        id        => $id,
        name      => $id,
        connected => $live ? \1 : \0,
        activity  => ($live ? activity_now($id) : 'idle'),
    };
}

sub channel_visible {
    my ($user, $cid) = @_;
    return 1 if zhc_gate();
    return 0 if acl_strict() && !$user;
    return 1 unless acl_strict();
    return can_read($user, $cid);
}

sub hub_state {
    my ($user) = @_;
    my $strict = acl_strict();
    my %seen_agent;
    my @chlist;
    for my $cid (sort keys %channels) {
        next if $strict && !channel_visible($user, $cid);
        my $c = $channels{$cid};
        push @chlist, {
            id      => $c->{id},
            kind    => $c->{kind},
            name    => $c->{name},
            members => [ @{ $c->{members} || [] } ],
            write   => ($user && can_write($user, $cid)) ? JSON::PP::true : JSON::PP::false,
        };
        $seen_agent{$_} = 1 for @{ $c->{members} || [] };
        $seen_agent{$cid} = 1 if ($c->{kind} // '') eq 'dm';
    }
    my @agents;
    for my $id (sort keys %agents) {
        next if $id =~ /^anon-/ || $id eq 'human' || $id eq '';
        if ($strict) {
            next unless $user && ($seen_agent{$id} || can_read($user, $id));
        }
        push @agents, agent_record($id, 1);
    }
    my $me;
    if ($user) {
        $me = public_user($user);
        $me->{strict} = $strict ? JSON::PP::true : JSON::PP::false;
    }
    return {
        agents   => \@agents,
        seq      => scalar(@log),
        channels => \@chlist,
        me       => $me,
    };
}

sub zhc_gate { return $ZHC_GATE; }

sub zhc_ct_eq {
    my ($a, $b) = @_;
    return 0 if !defined $a || !defined $b || length($a) != length($b);
    my $d = 0;
    for (my $i = 0; $i < length($a); $i++) {
        $d |= ord(substr($a, $i, 1)) ^ ord(substr($b, $i, 1));
    }
    return $d == 0;
}

# Every value of this bucket's session cookie, plus a flag when one is malformed.
# Last-match would treat a leftover admin cookie as the sign-in.
sub zhc_cookie_sids {
    my ($cookie) = @_;
    $cookie = $ZHC_COOKIE unless defined $cookie;
    return ([], 1) if !defined $cookie || $cookie !~ /^[A-Za-z0-9_]{1,64}\z/;
    my $raw = $ENV{HTTP_COOKIE} // '';
    my @sids;
    my $bad = 0;
    for my $part (split /;\s*/, $raw) {
        my ($k, $v) = split /=/, $part, 2;
        next unless defined $k && defined $v;
        $k =~ s/^\s+|\s+$//g;
        $v =~ s/^\s+|\s+$//g;
        next unless $k eq $cookie;
        if ($v =~ /\A[A-Za-z0-9,-]{16,128}\z/) {
            push @sids, $v unless grep { $_ eq $v } @sids;
        } else {
            $bad = 1;
        }
    }
    return (\@sids, $bad);
}

# One PHP serialize value. Returns (node, rest) or an empty list.
sub zhc_php_take {
    my ($rest) = @_;
    return if !defined $rest || $rest eq '';
    if ($rest =~ /\Ai:(-?\d+);/s) {
        return ({ t => 'i', i => $1 + 0 }, substr($rest, length($&)));
    }
    if ($rest =~ /\A(?:b:[01];|N;|d:[^;]*;)/s) {
        return ({ t => 'x' }, substr($rest, length($&)));
    }
    if ($rest =~ /\As:(\d+):"/s) {
        my $len = $1 + 0;
        my $hdr = length($&);
        return if $hdr + $len + 2 > length($rest);
        my $val = substr($rest, $hdr, $len);
        my $after = substr($rest, $hdr + $len);
        return unless $after =~ /\A";/s;
        return ({ t => 's', s => $val }, substr($after, 2));
    }
    if ($rest =~ /\Aa:(\d+):\{/s) {
        my $n = $1 + 0;
        return if $n > 10000;
        my $cur = substr($rest, length($&));
        for (1 .. $n) {
            my ($k, $r1) = zhc_php_take($cur);
            return unless $k;
            my ($v, $r2) = zhc_php_take($r1);
            return unless $v;
            $cur = $r2;
        }
        return unless $cur =~ /\A\}/s;
        return ({ t => 'x' }, substr($cur, 1));
    }
    if ($rest =~ /\AO:(\d+):"/s) {
        my $nlen = $1 + 0;
        my $hdr = length($&);
        return if $hdr + $nlen + 2 > length($rest);
        my $after = substr($rest, $hdr + $nlen);
        return unless $after =~ /\A":(\d+):\{/s;
        my $n = $1 + 0;
        return if $n > 10000;
        my $cur = substr($after, length($&));
        for (1 .. $n) {
            my ($k, $r1) = zhc_php_take($cur);
            return unless $k;
            my ($v, $r2) = zhc_php_take($r1);
            return unless $v;
            $cur = $r2;
        }
        return unless $cur =~ /\A\}/s;
        return ({ t => 'x' }, substr($cur, 1));
    }
    return;
}

# PHP session file. () on any failure. user_id is a product profile, not the account.
sub zhc_session_claims {
    my ($sid, $sess_dir) = @_;
    $sess_dir = $ZHC_SESS_DIR unless defined $sess_dir;
    return if !defined $sid || $sid !~ /\A[A-Za-z0-9,-]{16,128}\z/;
    return if $sess_dir !~ m{\A/} || $sess_dir =~ m{\.\.};
    my $path = $sess_dir . '/sess_' . $sid;
    my @st = lstat($path);
    return unless @st;
    return if -l _;
    return unless -f _;
    return if ($st[7] // 0) <= 0 || $st[7] > 65536;
    open my $fh, '<', $path or return;
    my $data = '';
    my $n = read($fh, $data, 65536);
    close $fh;
    return unless $n;
    my %kv;
    my $rest = $data;
    my $guard = 0;
    while (length($rest) && $guard++ < 64) {
        return unless $rest =~ /\A([A-Za-z_][A-Za-z0-9_]*)\|/s;
        my $key = $1;
        my ($val, $next) = zhc_php_take(substr($rest, length($key) + 1));
        return unless $val;
        $kv{$key} = $val;
        $rest = $next;
    }
    return if length $rest;
    my $idv = $kv{zhc_user_id};
    return unless $idv;
    my $uid;
    if ($idv->{t} eq 'i') {
        $uid = $idv->{i};
    } elsif ($idv->{t} eq 's' && ($idv->{s} // '') =~ /\A\d+\z/) {
        $uid = $idv->{s} + 0;
    }
    return unless $uid && $uid > 0;
    my $sess_email;
    if (exists $kv{email}) {
        return unless $kv{email}{t} eq 's';
        $sess_email = $kv{email}{s};
    }
    return ($uid, $sess_email);
}

# ('ok', row) | ('miss') | ('err'). Read-only. Never interpolates the id into SQL.
sub zhc_user_row {
    my ($id) = @_;
    return ('err') if !defined $id || $id !~ /\A\d+\z/ || $id < 1;
    return ('err') if $ZHC_DB !~ m{\A/} || $ZHC_DB =~ m{\.\.} || $ZHC_DB =~ /[?#]/ || !-f $ZHC_DB;
    require DBI;
    require DBD::SQLite;
    # immutable=1 reads the file without a WAL lock, so pledge can keep the
    # account directory read-only. A checkpoint in flight fails this one call.
    my $dbh = DBI->connect(
        'dbi:SQLite:dbname=file://' . $ZHC_DB . '?immutable=1',
        '', '', {
            RaiseError => 0,
            PrintError => 0,
            sqlite_open_flags => DBD::SQLite::OPEN_READONLY() | DBD::SQLite::OPEN_URI(),
        }
    );
    return ('err') unless $dbh;
    $dbh->do('PRAGMA query_only = ON');
    my $sth = $dbh->prepare(
        'SELECT email, email_verified FROM zhc_users WHERE id = ?'
    );
    if (!$sth || !$sth->execute($id)) {
        $dbh->disconnect;
        return ('err');
    }
    my $row = $sth->fetchrow_hashref;
    $sth->finish;
    $dbh->disconnect;
    return $row ? ('ok', $row) : ('miss');
}

# admin is the only role this cut grants. The configured address is compared
# here and nowhere else. A later instance changes the address, not the checks.
sub zhc_roles_for_row {
    my ($row) = @_;
    return () unless $row && ref($row) eq 'HASH';
    my $verified = ($row->{email_verified} // 0) + 0;
    return () if $verified != 1;
    my $allow = lc($ZHC_EMAIL // '');
    $allow =~ s/^\s+|\s+$//g;
    return () if $allow eq '' || $allow !~ /\A[^\s@]+@[^\s@]+\z/;
    my $email = lc($row->{email} // '');
    $email =~ s/^\s+|\s+$//g;
    return () unless zhc_ct_eq(sha256_hex($email), sha256_hex($allow));
    return ('admin');
}

sub zhc_authorize_sid {
    my ($sid, $sess_dir) = @_;
    my ($uid, $sess_email) = zhc_session_claims($sid, $sess_dir);
    return { ok => 0, code => 401, error => 'sign in required' } unless $uid;
    my $allow = lc($ZHC_EMAIL // '');
    $allow =~ s/^\s+|\s+$//g;
    if ($allow eq '' || $allow !~ /\A[^\s@]+@[^\s@]+\z/) {
        return { ok => 0, code => 503, error => 'unavailable' };
    }
    my ($st, $row) = zhc_user_row($uid);
    return { ok => 0, code => 503, error => 'unavailable' } if $st eq 'err';
    return { ok => 0, code => 403, error => 'forbidden' } if $st ne 'ok';
    my $admin = grep { $_ eq 'admin' } zhc_roles_for_row($row);
    return { ok => 0, code => 403, error => 'forbidden' } unless $admin;
    # A copied email must be this row's email, not a second copy of the grant.
    if (defined $sess_email) {
        my $se = lc $sess_email;
        $se =~ s/^\s+|\s+$//g;
        my $row_email = lc($row->{email} // '');
        $row_email =~ s/^\s+|\s+$//g;
        return { ok => 0, code => 403, error => 'forbidden' }
            unless zhc_ct_eq(sha256_hex($se), sha256_hex($row_email));
    }
    return { ok => 1, code => 200 };
}

sub zhc_authorize {
    my ($path) = @_;
    my $bucket = zhc_bucket_of(defined $path ? $path : '/');
    my $cookie = zhc_cookie_for($bucket);
    my $sess_dir = zhc_sess_dir_for($bucket);
    if (!defined $cookie || !defined $sess_dir
        || $sess_dir !~ m{\A/} || $sess_dir =~ m{\.\.} || !-d $sess_dir) {
        return { ok => 0, code => 401, error => 'sign in required' };
    }
    my ($sids, $bad) = zhc_cookie_sids($cookie);
    return { ok => 0, code => 401, error => 'sign in required' } if $bad || !@$sids;
    my $decision;
    for my $sid (@$sids) {
        $decision = zhc_authorize_sid($sid, $sess_dir);
        return $decision if !$decision->{ok};
    }
    return $decision;
}

# /dev and /qa are doors. The configured names are the prod pair; swap the suffix.
sub zhc_bucket_of {
    my ($path) = @_;
    $path = '/' unless defined $path && length $path;
    return 'dev' if $path eq '/dev' || $path =~ m{\A/dev/};
    return 'qa'  if $path eq '/qa'  || $path =~ m{\A/qa/};
    return 'prod';
}

sub zhc_prefix_for {
    my ($bucket) = @_;
    return '/dev' if ($bucket // '') eq 'dev';
    return '/qa'  if ($bucket // '') eq 'qa';
    return '';
}

sub zhc_req_prefix {
    return '' unless $ZHC_GATE;
    return zhc_prefix_for($ZHC_REQ_BUCKET);
}

sub zhc_cookie_for {
    my ($bucket) = @_;
    return $ZHC_COOKIE if !defined $bucket || $bucket eq 'prod';
    return undef unless defined $ZHC_COOKIE && $ZHC_COOKIE =~ /_PROD\z/;
    my $suf = $bucket eq 'dev' ? '_DEV' : $bucket eq 'qa' ? '_QA' : undef;
    return undef unless defined $suf;
    (my $name = $ZHC_COOKIE) =~ s/_PROD\z/$suf/;
    return $name;
}

sub zhc_sess_dir_for {
    my ($bucket) = @_;
    return $ZHC_SESS_DIR if !defined $bucket || $bucket eq 'prod';
    return undef unless defined $ZHC_SESS_DIR && $ZHC_SESS_DIR =~ /-prod\z/;
    my $suf = $bucket eq 'dev' ? '-dev' : $bucket eq 'qa' ? '-qa' : undef;
    return undef unless defined $suf;
    (my $dir = $ZHC_SESS_DIR) =~ s/-prod\z/$suf/;
    return $dir;
}

# One leading bucket only. /developer and /quality stay untouched.
sub zhc_strip_bucket {
    my ($path) = @_;
    $path = '/' unless defined $path && length $path;
    return $path unless $path =~ m{\A/(?:dev|qa)(?=/|\z)};
    $path =~ s{\A/(?:dev|qa)}{};
    return $path eq '' ? '/' : $path;
}

# Page at /dc. Chrome and icons under /dc/. API at /api/v1/dc/{state,history,send,files}.
sub zhc_public_path {
    my ($path) = @_;
    $path = '/' unless defined $path && length $path;
    return '/' if $path eq '/dc' || $path eq '/dc/' || $path eq '/dc/index.html';
    if ($path =~ m{\A/dc/(chrome\.js|chrome\.css)\z}) {
        return '/dc/' . $1;
    }
    if ($path =~ m{\A/dc/icons/([a-z0-9]+(?:-[a-z0-9]+)*\.svg)\z}) {
        return '/dc/icons/' . $1;
    }
    if ($path =~ m{\A/api/v1/dc/(state|history|send)/?\z}i) {
        return '/api/' . lc($1);
    }
    if ($path =~ m{\A/api/v1/dc/files/?\z}i) {
        return '/api/files';
    }
    if ($path =~ m{\A/api/v1/dc/files/([0-9a-fA-F]+)(?:/.*)?\z}i) {
        return '/api/files/' . lc($1);
    }
    return undef;
}

# Plain on purpose. A later cut may style these status pages.
# They stay a status, not the crew UI, including when the account check is down.
sub zhc_deny {
    my ($d, $path) = @_;
    my $code = $d->{code} || 401;
    my $err  = $d->{error} || 'forbidden';
    if (($path // '') =~ m{/api/}) {
        json_out($code, { ok => \0, error => $err });
        return;
    }
    my $title = $code == 401 ? 'Sign in required'
        : $code == 403 ? 'Forbidden' : 'Unavailable';
    my $acct = zhc_req_prefix() . '/account/';
    my $extra = $code == 401
        ? "<p>Sign in required.</p>\n<p><a href=\"$acct\">Sign in</a></p>\n"
        : "<p>$title.</p>\n";
    my $status = $code == 401 ? '401 Unauthorized'
        : $code == 403 ? '403 Forbidden' : '503 Service Unavailable';
    fcgi_print(
        'text/html; charset=utf-8',
        "<!DOCTYPE html>\n<html lang=\"en\"><head><meta charset=\"utf-8\">"
        . "<title>$title</title></head><body>\n$extra</body></html>\n",
        $status
    );
}

sub zhc_not_ours {
    my ($path) = @_;
    if (($path // '') =~ m{/api/}) {
        json_out(404, { ok => \0, error => 'not found' });
        return;
    }
    fcgi_print('text/plain; charset=utf-8', "not found\n", '404 Not Found');
}

# A web send may name one connected berth. #system and groups are not destinations.
sub zhc_target_ok {
    my ($to) = @_;
    $to = normalize_to($to);
    return 0 if is_broadcast_to($to) || $to eq 'human' || $to =~ /^g:/;
    return 0 if $channels{$to} && ($channels{$to}{kind} // '') eq 'group';
    return 0 unless $agents{$to} && $agents{$to}{sock};
    return 1;
}

sub handle_fcgi {
    my ($req) = @_;
    my $method = uc($ENV{REQUEST_METHOD} // 'GET');
    my $path   = fcgi_path();
    my $ctype  = $ENV{CONTENT_TYPE} // '';
    my $clen   = $ENV{CONTENT_LENGTH} // 0;
    my $q = parse_urlencoded($ENV{QUERY_STRING} // '');
    if (zhc_gate()) {
        $ZHC_REQ_BUCKET = zhc_bucket_of($path);
        my $decision = zhc_authorize($path);
        if (!$decision->{ok}) {
            zhc_deny($decision, $path);
            return;
        }
        my $mapped = zhc_public_path(zhc_strip_bucket($path));
        if (!defined $mapped) {
            zhc_not_ours($path);
            return;
        }
        $path = $mapped;
        if ($path =~ m{\A/api/setup\b}i
            || ($q->{setup} // '') ne ''
            || ($q->{action} // '') eq 'altcha_challenge') {
            json_out(404, { ok => \0, error => 'not found' });
            return;
        }
    }
    if (serve_pwa($path, $method)) {
        return;
    }
    if (defined dc_asset_rel($path)) {
        if ($method ne 'GET' && $method ne 'HEAD') {
            fcgi_print('text/plain; charset=utf-8', "method not allowed\n", '405 Method Not Allowed');
            return;
        }
        serve_dc_asset($path);
        return;
    }
    my $is_upload = ($path =~ m{/api/files/?$}i && $method eq 'POST');
    my $max_body  = $is_upload ? $MAX_UPLOAD : 65536;
    if ($method eq 'POST' && $clen =~ /^\d+$/ && $clen > $max_body) {
        json_out(413, { ok => \0, error => 'payload too large' });
        return;
    }
    my $body = ($method eq 'POST' || $method eq 'PUT') ? fcgi_read_body($max_body) : '';
    if ($method eq 'POST' && $ctype !~ m{json}i) {
        my $pq = parse_urlencoded($body);
        $q->{$_} = $pq->{$_} for keys %$pq;
    }

    # Static chrome for the ZHC-like signup (also served from httpd /htdocs/shared).
    if ($path =~ m{^/shared/([A-Za-z0-9._-]+)$}) {
        my $file = share_file($1);
        if ($file && open my $fh, '<', $file) {
            local $/;
            my $s = <$fh>;
            close $fh;
            my $ct = 'application/octet-stream';
            $ct = 'text/css; charset=utf-8' if $file =~ /\.css$/i;
            $ct = 'text/javascript; charset=utf-8' if $file =~ /\.js$/i;
            $ct = 'text/plain; charset=utf-8' if $file =~ /\.txt$/i;
            cgi_out(
                "Status: 200 OK\r\nCache-Control: public, max-age=86400\r\nContent-Type: $ct\r\n\r\n",
                $s
            );
            return;
        }
        json_out(404, { ok => \0, error => 'missing shared file' }) if $path =~ m{\.json$}i;
        fcgi_print('text/plain; charset=utf-8', "not found\n", '404 Not Found');
        return;
    }

    if ($path =~ m{^/api/setup/challenge/?$}i
        || ($q->{setup} // '') eq 'challenge'
        || (($q->{action} // '') eq 'altcha_challenge' && $path =~ m{/api/}i)) {
        json_out(200, pow_challenge(), { expires => http_date(time + 600) });
        return;
    }
    if ($path =~ m{^/api/setup/status/?$}i) {
        json_out(200, {
            ok        => \1,
            complete  => setup_complete() ? \1 : \0,
            llm       => llm_configured() ? \1 : \0,
            need_setup => (setup_complete() && llm_configured()) ? \0 : \1,
        });
        return;
    }
    if ($path =~ m{^/api/setup/?$}i && $method eq 'POST'
        || (($q->{setup} // '') eq 'save' && $method eq 'POST')) {
        my $obj = {};
        if (($ctype || '') =~ /json/i) {
            $obj = eval { decode_json($body) } || {};
        } else {
            $obj = { %$q };
        }
        if (!pow_ok(parse_altcha($obj))) {
            json_out(400, { ok => \0, error => 'ALTCHA failed' });
            return;
        }
        my $user = $obj->{user} // '';
        my $pass = $obj->{password} // '';
        $user =~ s/^\s+|\s+$//g;
        if ($user !~ /^[a-zA-Z][a-zA-Z0-9._-]{1,31}$/) {
            json_out(400, { ok => \0, error => 'username: letters, 2–32 chars' });
            return;
        }
        if (length($pass) < 8) {
            json_out(400, { ok => \0, error => 'password at least 8 characters' });
            return;
        }
        my $base = $obj->{llm_base} || 'https://openrouter.ai/api/v1';
        $base =~ s{/+$}{};
        my $key  = $obj->{llm_key} // '';
        my $mgmt = $obj->{mgmt_key} // '';
        $key =~ s/\s+//g;
        $mgmt =~ s/\s+//g;
        if ($key eq '' && $mgmt eq '') {
            json_out(400, { ok => \0, error => 'Captain API key or a management key required' });
            return;
        }
        if ($mgmt ne '' && $base ne 'https://openrouter.ai/api/v1') {
            json_out(400, { ok => \0, error => 'A management key allocates OpenRouter keys. Use a captain key for another LLM URL.' });
            return;
        }
        my $share = write_llm_secrets($base, $key, $mgmt);
        if (ref $share eq 'HASH') {
            json_out(502, { ok => \0, error => $share->{error} // 'could not allocate a key for each mate' });
            return;
        }
        my $saved = save_setup({
            complete   => JSON::PP::true,
            user       => $user,
            pass_hash  => bcrypt_hash($pass),
            created    => strftime('%Y-%m-%dT%H:%M:%SZ', gmtime),
            llm_base   => $base,
            llm_key    => ($key ne '') ? \1 : \0,
            mgmt_key   => ($mgmt ne '') ? \1 : \0,
            shared_key => ($key ne '' && $mgmt eq '') ? \1 : \0,
        });
        if (!$saved) {
            json_out(500, { ok => \0, error => 'could not write setup.json' });
            return;
        }
        json_out(200, { ok => \1, shared_key => ($key ne '' && $mgmt eq '') ? \1 : \0 });
        return;
    }

    if (!zhc_gate() && $method eq 'POST' && !setup_complete()
        && $path =~ m{/api/(send|channels|files|login|users|grants|crew)}i) {
        json_out(503, { ok => \0, error => 'setup required' });
        return;
    }

    if (!zhc_gate() && $path =~ m{^/api/login/?$}i && $method eq 'POST') {
        my $obj = eval { decode_json($body) } || {};
        my $id = $obj->{user} // '';
        my $pw = $obj->{password} // '';
        $id =~ s/^\s+|\s+$//g;
        my $p = load_principals();
        my $u = $p->{$id};
        if (!$u || !bcrypt_ok($pw, $u->{pass_hash})) {
            json_out(401, { ok => \0, error => 'bad login' });
            return;
        }
        if (principal_suspended($u)) {
            json_out(403, { ok => \0, error => 'suspended' });
            return;
        }
        my $token = mint_session($id);
        json_out(200, { ok => \1, user => public_user($u) }, {
            cookie => session_cookie_hdr($token),
        });
        return;
    }

    my $me;
    my $needs_user = !zhc_gate() && setup_complete()
        && $path =~ m{^/api/(history|send|files|state|channels|users|grants|crew|me|logout)\b}i;
    if ($needs_user) {
        $me = session_principal();
        if (!$me) {
            json_out(401, { ok => \0, error => 'login required' });
            return;
        }
        if (principal_suspended($me)) {
            drop_user_sessions($me->{id});
            json_out(403, { ok => \0, error => 'suspended' }, {
                cookie => session_cookie_hdr(''),
            });
            return;
        }
    }

    if (!zhc_gate() && $path =~ m{^/api/logout/?$}i && $method eq 'POST') {
        my $token = cookie_value(session_cookie_name());
        if ($token) {
            my $all = load_sessions();
            delete $all->{$token};
            save_sessions($all);
        }
        json_out(200, { ok => \1 }, { cookie => session_cookie_hdr('') });
        return;
    }

    if (!zhc_gate() && $path =~ m{^/api/me/?$}i) {
        if (!$me) {
            json_out(401, { ok => \0, error => 'login required' });
            return;
        }
        json_out(200, {
            ok => \1,
            %{ public_user($me) },
            strict => acl_strict() ? JSON::PP::true : JSON::PP::false,
        });
        return;
    }

    if (!zhc_gate() && $path =~ m{^/api/users/?$}i) {
        if (!$me || ($me->{role} // '') ne 'manager') {
            json_out(403, { ok => \0, error => 'manager only' });
            return;
        }
        my $people = load_principals();
        if ($method eq 'GET') {
            json_out(200, {
                ok => \1,
                users => [ map { public_user($_) } sort { $a->{id} cmp $b->{id} } values %$people ],
            });
            return;
        }
        if ($method ne 'POST') {
            json_out(405, { ok => \0, error => 'GET or POST' });
            return;
        }
        my $obj = eval { decode_json($body) } || {};
        my $id = $obj->{id} // $obj->{user} // '';
        $id =~ s/^\s+|\s+$//g;
        my $role = $obj->{role} // 'worker';
        if ($role eq 'child') {
            json_out(400, { ok => \0, error => 'child is reserved for a later phase' });
            return;
        }
        if (!role_ok($role)) {
            json_out(400, { ok => \0, error => 'role must be worker, coworker, or manager' });
            return;
        }
        if ($role eq 'manager' && !$me->{founder}) {
            json_out(403, { ok => \0, error => 'only the setup manager can name another manager' });
            return;
        }
        if (!valid_user_id($id)) {
            json_out(400, { ok => \0, error => 'username: letters, 2–32 chars' });
            return;
        }
        if ($people->{$id}) {
            json_out(400, { ok => \0, error => 'user exists' });
            return;
        }
        my $pw = $obj->{password} // '';
        if (length($pw) < 8) {
            json_out(400, { ok => \0, error => 'password at least 8 characters' });
            return;
        }
        my $was_strict = acl_strict();
        $people->{$id} = {
            id        => $id,
            role      => $role,
            status    => 'active',
            founder   => JSON::PP::false,
            pass_hash => bcrypt_hash($pw),
        };
        save_principals($people);
        arm_founder_grants($me->{id}) unless $was_strict;
        json_out(200, { ok => \1, user => public_user($people->{$id}) });
        return;
    }

    if (!zhc_gate() && $path =~ m{^/api/users/([^/]+)/?$}i) {
        my $id = $1;
        if (!$me || ($me->{role} // '') ne 'manager') {
            json_out(403, { ok => \0, error => 'manager only' });
            return;
        }
        if ($method ne 'POST') {
            json_out(405, { ok => \0, error => 'POST required' });
            return;
        }
        my $people = load_principals();
        my $u = $people->{$id};
        if (!$u) {
            json_out(404, { ok => \0, error => 'no such user' });
            return;
        }
        my $obj = eval { decode_json($body) } || {};
        my $op = $obj->{op} // '';
        if ($op eq 'suspend') {
            if ($u->{founder}) {
                json_out(403, { ok => \0, error => 'the setup manager cannot be suspended' });
                return;
            }
            $u->{status} = 'suspended';
            $people->{$id} = $u;
            save_principals($people);
            drop_user_sessions($id);
            json_out(200, { ok => \1, user => public_user($u) });
            return;
        }
        if ($op eq 'restore') {
            $u->{status} = 'active';
            $people->{$id} = $u;
            save_principals($people);
            json_out(200, { ok => \1, user => public_user($u) });
            return;
        }
        if ($op eq 'role') {
            my $role = $obj->{role} // '';
            if ($role eq 'child') {
                json_out(400, { ok => \0, error => 'child is reserved for a later phase' });
                return;
            }
            if (!role_ok($role)) {
                json_out(400, { ok => \0, error => 'role must be worker, coworker, or manager' });
                return;
            }
            if ($u->{founder} && $role ne 'manager') {
                json_out(403, { ok => \0, error => 'the setup manager stays a manager' });
                return;
            }
            if ($role eq 'manager' && !$me->{founder}) {
                json_out(403, { ok => \0, error => 'only the setup manager can name another manager' });
                return;
            }
            $u->{role} = $role;
            $people->{$id} = $u;
            save_principals($people);
            json_out(200, { ok => \1, user => public_user($u) });
            return;
        }
        if ($op eq 'password') {
            my $pw = $obj->{password} // '';
            if (length($pw) < 8) {
                json_out(400, { ok => \0, error => 'password at least 8 characters' });
                return;
            }
            $u->{pass_hash} = bcrypt_hash($pw);
            $people->{$id} = $u;
            save_principals($people);
            drop_user_sessions($id);
            json_out(200, { ok => \1 });
            return;
        }
        json_out(400, { ok => \0, error => 'op must be suspend, restore, role, or password' });
        return;
    }

    if (!zhc_gate() && $path =~ m{^/api/grants/?$}i) {
        if (!$me || ($me->{role} // '') ne 'manager') {
            json_out(403, { ok => \0, error => 'manager only' });
            return;
        }
        if ($method eq 'GET') {
            json_out(200, { ok => \1, grants => load_grants() });
            return;
        }
        if ($method ne 'POST') {
            json_out(405, { ok => \0, error => 'GET or POST' });
            return;
        }
        my $obj = eval { decode_json($body) } || {};
        my $id = $obj->{user} // '';
        my $raw_chan = $obj->{channel} // '';
        $raw_chan =~ s/^\s+|\s+$//g;
        if (!valid_user_id($id) || $raw_chan eq '') {
            json_out(400, { ok => \0, error => 'user and channel required' });
            return;
        }
        my $chan = normalize_to($raw_chan);
        my $people = load_principals();
        if (!$people->{$id}) {
            json_out(404, { ok => \0, error => 'no such user' });
            return;
        }
        my $read = grant_bit($obj->{read});
        my $write = grant_bit($obj->{write});
        if ($read < 0 || $write < 0) {
            json_out(400, { ok => \0, error => 'grant must be 0 or 1' });
            return;
        }
        $read = 1 if $write;
        my $g = load_grants();
        if (!$read && !$write) {
            delete $g->{$chan}{$id} if $g->{$chan};
            delete $g->{$chan} if $g->{$chan} && !keys %{ $g->{$chan} };
        } else {
            $g->{$chan}{$id} = {
                read  => $read  ? JSON::PP::true : JSON::PP::false,
                write => $write ? JSON::PP::true : JSON::PP::false,
            };
        }
        save_grants($g);
        json_out(200, { ok => \1, grants => $g });
        return;
    }

    if (!zhc_gate() && $path =~ m{^/api/crew/?$}i) {
        if (!$me || ($me->{role} // '') ne 'manager') {
            json_out(403, { ok => \0, error => 'manager only' });
            return;
        }
        if ($method eq 'GET') {
            json_out(200, { ok => \1, crew => crew_rows() });
            return;
        }
        if ($method ne 'POST') {
            json_out(405, { ok => \0, error => 'GET or POST' });
            return;
        }
        my $obj = eval { decode_json($body) } || {};
        my $id = $obj->{alias} // '';
        $id =~ s/^\s+|\s+$//g;
        if (!valid_crew_alias($id)) {
            json_out(400, { ok => \0, error => 'alias: lowercase letter, then up to 15 letters or digits' });
            return;
        }
        my $ans = crew_call({ op => 'create', alias => $id });
        json_out($ans->{ok} ? 200 : 400, $ans);
        return;
    }

    if (!zhc_gate() && $path =~ m{^/api/crew/([^/]+)/?$}i) {
        my $id = $1;
        if (!$me || ($me->{role} // '') ne 'manager') {
            json_out(403, { ok => \0, error => 'manager only' });
            return;
        }
        if ($method ne 'POST') {
            json_out(405, { ok => \0, error => 'POST required' });
            return;
        }
        if (!valid_crew_alias($id)) {
            json_out(400, { ok => \0, error => 'alias: lowercase letter, then up to 15 letters or digits' });
            return;
        }
        my $obj = eval { decode_json($body) } || {};
        my $ans = crew_call({
            op      => 'grant',
            alias   => $id,
            network => $obj->{network} ? 1 : 0,
            desktop => $obj->{desktop} ? 1 : 0,
            db      => $obj->{db}      ? 1 : 0,
        });
        json_out($ans->{ok} ? 200 : 400, $ans);
        return;
    }

    if ($path =~ m{^/api/files/([0-9a-fA-F]+)(?:/.*)?$}i) {
        my $id = $1;
        if ($method ne 'GET' && $method ne 'HEAD') {
            json_out(405, { ok => \0, error => 'GET required' });
            return;
        }
        my $meta = load_file_meta($id);
        if (!$meta) {
            json_out(404, { ok => \0, error => 'no such file' });
            return;
        }
        if ($me && acl_strict() && !file_visible($me, $meta)) {
            json_out(404, { ok => \0, error => 'no such file' });
            return;
        }
        my $blob = file_blob_path($id);
        if (!-f $blob) {
            json_out(404, { ok => \0, error => 'missing blob' });
            return;
        }
        open my $bf, '<', $blob or do {
            json_out(404, { ok => \0, error => 'missing blob' });
            return;
        };
        binmode $bf;
        local $/;
        my $data = <$bf> // '';
        close $bf;
        my $name = $meta->{name} || 'file';
        $name =~ s/"//g;
        my $mime = $meta->{mime} || 'application/octet-stream';
        my $disp = ($q->{dl} || $q->{download}) ? 'attachment' : 'inline';
        cgi_out(
            "Status: 200 OK\r\nCache-Control: "
            . (zhc_gate() ? 'no-store' : 'private, max-age=3600') . "\r\n"
            . "Content-Type: $mime\r\n"
            . "Content-Length: " . length($data) . "\r\n"
            . "Content-Disposition: $disp; filename=\"$name\"\r\n\r\n",
            $data
        );
        return;
    }

    if ($path =~ m{^/api/files/?$}i && $method eq 'POST') {
        my $name = $q->{name} // '';
        if ($ctype =~ m{json}i) {
            json_out(400, { ok => \0, error => 'send raw file body, not json' });
            return;
        }
        if ($me && acl_strict() && !has_any_write($me)) {
            json_out(403, { ok => \0, error => 'read only' });
            return;
        }
        my $meta = save_upload($name, $q->{mime} || $ctype, $body, $me ? $me->{id} : '');
        if (!$meta) {
            json_out(400, { ok => \0, error => 'upload failed' });
            return;
        }
        json_out(200, { ok => \1, %$meta });
        return;
    }

    if ($path =~ m{^/api/channels/?$}i) {
        if ($method eq 'GET') {
            json_out(200, {
                ok       => \1,
                channels => [
                    map {
                        my $c = $channels{$_};
                        {
                            id      => $c->{id},
                            kind    => $c->{kind},
                            name    => $c->{name},
                            members => [ @{ $c->{members} || [] } ],
                            write   => ($me && can_write($me, $_)) ? JSON::PP::true : JSON::PP::false,
                        }
                    } grep { channel_visible($me, $_) } sort keys %channels
                ],
            });
            return;
        }
        if ($me && acl_strict() && ($me->{role} // '') ne 'manager') {
            json_out(403, { ok => \0, error => 'manager only' });
            return;
        }
        if ($method ne 'POST') {
            json_out(405, { ok => \0, error => 'GET or POST' });
            return;
        }
        my $obj = eval { decode_json($body) };
        if (!$obj || ref $obj ne 'HASH') {
            json_out(400, { ok => \0, error => 'invalid json' });
            return;
        }
        my $ch = ensure_group_channel($obj->{id}, $obj->{name}, $obj->{members});
        json_out(200, { ok => \1, channel => $ch });
        return;
    }

    if ($path =~ m{/api/history/?$}i) {
        my $chan  = normalize_to($q->{channel} // $q->{chan} // 'all');
        if ($me && !can_read($me, $chan)) {
            json_out(404, { ok => \0, error => 'not found' });
            return;
        }
        my $page  = $q->{page};
        $page = -1 if !defined $page || $page eq '' || $page eq 'last';
        $page = 0 + $page if $page =~ /^-?\d+$/;
        my $lines = 0 + ($q->{lines} || $q->{per} || 32);
        my $hist = history_page($chan, $page, $lines);
        my $etag = join('-', $hist->{seq}, $hist->{channel}, $hist->{page}, $hist->{pages}, $hist->{lines});
        my $inm  = $ENV{HTTP_IF_NONE_MATCH} // '';
        $inm =~ s/"//g;
        if ($inm && $inm eq $etag) {
            json_out(304, {}, {
                etag  => $etag,
                cache => ($hist->{page} < $hist->{pages}
                    ? 'private, max-age=86400'
                    : 'no-store'),
            });
            return;
        }
        json_out(200, $hist, {
            etag  => $etag,
            cache => ($hist->{page} < $hist->{pages}
                ? 'private, max-age=86400'
                : 'no-store'),
        });
        return;
    }

    my $want_json = ($path =~ m{/api/state/?$}i)
        || (($q->{format} // '') eq 'json');

    if (!zhc_gate() && $path =~ m{/api/send/?$}i
        && $method eq 'POST' && !setup_complete()) {
        json_out(503, { ok => \0, error => 'setup required' });
        return;
    }

    if ($path =~ m{/api/send/?$}i) {
        if ($method ne 'POST') {
            json_out(405, { ok => \0, error => 'POST required' });
            return;
        }
        my ($to, $content);
        if ($ctype =~ m{json}i) {
            my $obj = eval { decode_json($body) };
            if (!$obj || ref $obj ne 'HASH') {
                json_out(400, { ok => \0, error => 'invalid json' });
                return;
            }
            $to      = $obj->{to};
            $content = $obj->{content};
            if (zhc_gate() && !zhc_target_ok($to)) {
                json_out(400, { ok => \0, error => 'pick a live berth' });
                return;
            }
            my @files;
            if ($obj->{files} && ref $obj->{files} eq 'ARRAY') {
                for my $f (@{ $obj->{files} }) {
                    next unless $f && ref $f eq 'HASH' && $f->{id};
                    my $meta = load_file_meta($f->{id}) or next;
                    push @files, $meta;
                }
            }
            $to = normalize_to($to);
            if ($me && !can_write($me, $to)) {
                json_out(403, { ok => \0, error => 'read only' });
                return;
            }
            if (!inject_human_message($me ? $me->{id} : 'human', $to, $content, \@files)) {
                json_out(400, { ok => \0, error => 'content required' });
                return;
            }
            json_out(200, { ok => \1, to => $to });
            return;
        } else {
            $to      = $q->{to};
            $content = $q->{content};
            if (zhc_gate() && !zhc_target_ok($to)) {
                json_out(400, { ok => \0, error => 'pick a live berth' });
                return;
            }
        }
        $to = normalize_to($to);
        if ($me && !can_write($me, $to)) {
            json_out(403, { ok => \0, error => 'read only' });
            return;
        }
        if (!inject_human_message($me ? $me->{id} : 'human', $to, $content)) {
            json_out(400, { ok => \0, error => 'content required' });
            return;
        }
        json_out(200, { ok => \1, to => $to });
        return;
    }

    if ($q->{send} && defined $q->{content} && length $q->{content}) {
        if (zhc_gate() && !zhc_target_ok($q->{to})) {
            json_out(400, { ok => \0, error => 'pick a live berth' });
            return;
        }
        my $from = 'human';
        my $to = $q->{to};
        if (!zhc_gate() && setup_complete()) {
            my $who = $me || session_principal();
            if (!$who) {
                json_out(401, { ok => \0, error => 'login required' });
                return;
            }
            $to = normalize_to($to);
            if (!can_write($who, $to)) {
                json_out(403, { ok => \0, error => 'read only' });
                return;
            }
            $from = $who->{id};
        }
        inject_human_message($from, $to, $q->{content});
        if (!$want_json && $method eq 'POST') {
            my $loc = zhc_gate() ? zhc_req_prefix() . '/dc/' : '/';
            cgi_out("Status: 303 See Other\r\nLocation: $loc\r\nCache-Control: no-store\r\n\r\n");
            return;
        }
    }

    if ($want_json) {
        json_out(200, hub_state(zhc_gate() ? undef : ($me || session_principal())));
        return;
    }

    # /api/* is JSON only — never HTML (that was the "<!DOCTYPE" SyntaxError).
    if ($path =~ m{^/api/}i) {
        json_out(404, { ok => \0, error => 'not found' });
        return;
    }

    if (zhc_gate()) {
        fcgi_print('text/html; charset=utf-8', app_html());
        return;
    }

    if ($path =~ m{^/account/?$}i) {
        if (!setup_complete() || !llm_configured()) {
            fcgi_print('text/html; charset=utf-8', setup_html());
            return;
        }
        cgi_out("Status: 303 See Other\r\nLocation: /\r\nCache-Control: no-store\r\n\r\n");
        return;
    }

    if (!setup_complete() || !llm_configured()) {
        fcgi_print('text/html; charset=utf-8', setup_html());
        return;
    }
    fcgi_print('text/html; charset=utf-8', app_html());
}

sub apply_brand {
    my ($html) = @_;
    return '' unless defined $html;
    my $name = $PRODUCT;
    $name =~ s/&/&amp;/g;
    $name =~ s/</&lt;/g;
    $name =~ s/>/&gt;/g;
    my $cookie = $COOKIE_PREFIX;
    $cookie =~ s/[^A-Za-z0-9_]//g;
    $cookie = 'PICOBUS' unless length $cookie;
    my $pre  = $ZHC_GATE ? zhc_req_prefix() : '';
    my $api  = $ZHC_GATE ? $pre . '/api/v1/dc' : '/api';
    my $page = $ZHC_GATE ? $pre . '/dc/' : '/';
    my $acct = $pre . '/account/';
    $html =~ s/__PRODUCT__/$name/g;
    $html =~ s/__COOKIE__/$cookie/g;
    $html =~ s/__API__/$api/g;
    $html =~ s/__PAGE__/$page/g;
    $html =~ s/__ACCOUNT__/$acct/g;
    $html =~ s/__NEED_LOGIN__/$ZHC_GATE ? '0' : '1'/ge;
    return $html;
}

sub setup_html {
    for my $p (
        ($SHARE_DIR ? "$SHARE_DIR/setup.html" : ()),
        "$FindBin::Bin/../share/setup.html",
        "/usr/local/share/picobus/setup.html",
        "$FindBin::Bin/setup.html",
    ) {
        next unless $p && -f $p;
        open my $fh, '<', $p or next;
        local $/;
        my $s = <$fh>;
        close $fh;
        return apply_brand($s) if defined $s && length $s;
    }
    return apply_brand(<<'SETUP_HTML');
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="picobus-cookie" content="__COOKIE__">
<meta name="theme-color" content="#313338">
<title>Create account — __PRODUCT__</title>
<link rel="manifest" href="/manifest.webmanifest">
<link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192">
<link rel="stylesheet" href="/shared/zhc-prefs.css">
</head>
<body>
<header class="zhc-app-chrome"><nav class="zhc-product-nav" aria-label="Main"><a href="/">Home</a></nav><button type="button" id="install" hidden>Install</button><div id="zhc-theme-slot"></div></header>
<main>
<h1>Create account</h1>
<p class="note">Complete ALTCHA under the password, then Continue.</p>
<form class="auth" id="f" onsubmit="return false">
<label for="user">Username</label>
<input id="user" name="user" autocomplete="username" required>
<label for="password">Password</label>
<input id="password" name="password" type="password" autocomplete="new-password" required minlength="8">
<div id="altcha-wrap">
<altcha-widget id="altcha-widget" name="altcha" challengeurl="/api/setup/challenge" auto="off" hidefooter></altcha-widget>
</div>
<label for="llm_base">LLM HTTP URL</label>
<input id="llm_base" name="llm_base" type="url" value="https://openrouter.ai/api/v1">
<div class="key-fields" id="shared-fields">
<label for="llm_key">Captain API key</label>
<input id="llm_key" name="llm_key" type="password" autocomplete="off">
<p class="hint">Optional if you give a management key. Alone, every mate uses this key.</p>
</div>
<div class="key-fields" id="mgmt-fields">
<label for="mgmt_key">OpenRouter management key</label>
<input id="mgmt_key" name="mgmt_key" type="password" autocomplete="off">
<p class="hint">Optional if you give a captain key. The rest of the crew gets a unique key. This key is not given to a mate.</p>
</div>
<p id="err" class="err"></p>
<button type="button" class="btn" id="go">Continue</button>
</form>
</main>
<script src="/shared/altcha-http-shim.js"></script>
<script src="/shared/altcha-widget-v1.min.js" defer></script>
<script src="/shared/crew-prefs.js" defer></script>
<script>
if ('serviceWorker' in navigator) {
  navigator.serviceWorker.register('/sw.js').catch(function () {});
}
var installBtn = document.getElementById('install');
var deferred = null;
window.addEventListener('beforeinstallprompt', function (e) {
  e.preventDefault();
  deferred = e;
  if (installBtn) installBtn.hidden = false;
});
if (installBtn) {
  installBtn.addEventListener('click', function () {
    if (!deferred) return;
    var pending = deferred;
    deferred = null;
    pending.prompt();
    pending.userChoice.then(function () {
      installBtn.hidden = true;
    });
  });
}
window.addEventListener('appinstalled', function () {
  deferred = null;
  if (installBtn) installBtn.hidden = true;
});
</script>
<script>
(function(){
  var p='';
  function w(){ return document.getElementById('altcha-widget'); }
  function payload(){ var el=w(); return p || (el && el.value) || ''; }
  customElements.whenDefined('altcha-widget').then(function(){
    var el=w(); if(!el) return;
    el.addEventListener('verified', function(ev){ p=(ev.detail&&ev.detail.payload)||''; });
    el.addEventListener('statechange', function(ev){ if(ev.detail&&ev.detail.state==='verified'&&ev.detail.payload) p=ev.detail.payload; });
  });
  document.getElementById('go').onclick=function(){
    var err=document.getElementById('err'); err.textContent='';
    if(!payload()){ err.textContent='Complete the human check under your password first.'; return; }
    var f=document.getElementById('f');
    var llm=(f.llm_key.value||'').replace(/\s+/g,'');
    var mgmt=(f.mgmt_key.value||'').replace(/\s+/g,'');
    if(!llm && !mgmt){ err.textContent='Captain API key or a management key required'; return; }
    var mode=(llm && mgmt)?'both':(mgmt?'mgmt':'shared');
    fetch('/api/setup',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({
      user:f.user.value,password:f.password.value,llm_base:f.llm_base.value,key_mode:mode,llm_key:llm,mgmt_key:mgmt,altcha:payload()
    })}).then(function(r){
      var ct=r.headers.get('content-type')||'';
      if(ct.indexOf('json')===-1) throw new Error('setup API returned HTML');
      return r.json();
    }).then(function(j){ if(!j.ok) throw new Error(j.error||'setup failed'); location.href='/'; })
      .catch(function(e){ err.textContent=String(e); });
  };
})();
</script>
</body>
</html>
SETUP_HTML
}

