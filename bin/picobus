<script>
var installBtn = document.getElementById('install');
var deferred = null;
window.addEventListener('beforeinstallprompt', function (e) {
  e.preventDefault();
  deferred = e;
  if (installBtn) installBtn.hidden = false;
});
if (installBtn) {
  installBtn.addEventListener('click', function () {
    if (!deferred) return;
    var pending = deferred;
    deferred = null;
    pending.prompt();
    pending.userChoice.then(function () {
      installBtn.hidden = true;
    });
  });
}
window.addEventListener('appinstalled', function () {
  deferred = null;
  if (installBtn) installBtn.hidden = true;
});
</script>
<script>
(function () {
  var selected = "all";
  var needLogin = __NEED_LOGIN__;
  var currentUser = null;
  var pinned = false;
  var landed = false;
  var openMentions = {};
  var lastAgentsRaw = "";
  var lastData = { agents: [], scores: {}, seq: 0 };
  var stateGen = 0;
  var seenFrom = {};
  var holdFor = {};
  var primed = {};
  var paneMap = {};
  var pendingFiles = [];
  var pane, panesRoot, channels, head, toField, content, composer, sideFoot, pager, pendingEl, fileInput;

  function $(id) { return document.getElementById(id); }
  function esc(s) {
    return String(s == null ? "" : s).replace(/[&<>"']/g, function (c) {
      return { "&":"&amp;","<":"&lt;",">":"&gt;","\"":"&quot;","'":"&#39;" }[c];
    });
  }
  // Chat markdown is a closed set of tags. Escape first so a message cannot
  // introduce HTML. Fences and pipe tables emit only tags this page builds.
  // A marker that does not pair stays as text.
  function inlineMd(text) {
    var s = esc(text).replace(/\u0000/g, "");
    var codes = [];
    s = s.replace(/`([^`]+)`/g, function (m, c) {
      codes.push(c);
      return "\u0000" + (codes.length - 1) + "\u0000";
    });
    s = s.replace(/\*\*([^*\n]+)\*\*/g, "<strong>$1</strong>");
    s = s.replace(/(^|[^A-Za-z0-9*])\*([^*\n]+)\*/g, function (m, pre, t) {
      return pre + "<em>" + t + "</em>";
    });
    s = s.replace(/\u0000(\d+)\u0000/g, function (m, i) {
      return "<code>" + codes[+i] + "</code>";
    });
    return s;
  }
  function renderMd(src) {
    var lines = String(src == null ? "" : src).replace(/\u0000/g, "").replace(/\u0001/g, "").replace(/\r\n/g, "\n").replace(/\r/g, "\n").split("\n");
    var html = "";
    var para = [];
    var i = 0;
    function flushPara() {
      if (!para.length) return;
      html += "<p>" + para.join("<br>") + "</p>";
      para = [];
    }
    function blank(line) { return line.replace(/[ \t]+$/, "") === ""; }
    function ulLine(line) { var m = /^[-*] (.*)$/.exec(line); return m ? m[1] : null; }
    function olLine(line) {
      var m = /^(\d+)\. (.*)$/.exec(line);
      if (!m || m[1].length > 6) return null;
      return { n: +m[1], t: m[2] };
    }
    function fenceOpen(line) {
      var m = /^ {0,3}(`{3,})([^`]*)[ \t]*$/.exec(line);
      if (!m) return null;
      var lang = m[2].replace(/^[ \t]+|[ \t]+$/g, "").split(/[ \t]/)[0] || "";
      return { n: m[1].length, lang: lang };
    }
    function fenceClose(line, n) {
      var m = /^ {0,3}(`{3,})[ \t]*$/.exec(line);
      return !!(m && m[1].length >= n);
    }
    function fenceHtml(body, lang) {
      var cls = "";
      if (/^[A-Za-z0-9_+#.-]{1,32}$/.test(lang)) cls = " class=\"language-" + lang + "\"";
      return "<pre><code" + cls + ">" + esc(body) + "</code></pre>";
    }
    function splitRow(line) {
      var s = line.replace(/^[ \t]+|[ \t]+$/g, "");
      if (s.indexOf("|") < 0) return null;
      var codes = [];
      s = s.replace(/`[^`\n]*`/g, function (m) {
        codes.push(m);
        return "\u0001" + (codes.length - 1) + "\u0001";
      });
      if (s.charAt(0) === "|") s = s.slice(1);
      if (s.charAt(s.length - 1) === "|") s = s.slice(0, -1);
      var cells = s.split("|");
      for (var k = 0; k < cells.length; k++) {
        var c = cells[k].replace(/\u0001(\d+)\u0001/g, function (m, n) { return codes[+n]; });
        cells[k] = c.replace(/^[ \t]+|[ \t]+$/g, "");
      }
      return cells;
    }
    function colAlign(cell) {
      var s = cell.replace(/[ \t]/g, "");
      if (!/^:?-{3,}:?$/.test(s)) return "";
      var L = s.charAt(0) === ":";
      var R = s.charAt(s.length - 1) === ":";
      if (L && R) return "center";
      if (R) return "right";
      return "left";
    }
    function sepRow(line) {
      var cells = splitRow(line);
      if (!cells || !cells.length) return null;
      var aligns = [];
      for (var k = 0; k < cells.length; k++) {
        var a = colAlign(cells[k]);
        if (!a) return null;
        aligns.push(a);
      }
      return aligns;
    }
    function cellHtml(tag, text, align) {
      var cls = align === "center" ? " class=\"c\"" : align === "right" ? " class=\"r\"" : "";
      return "<" + tag + cls + ">" + inlineMd(text) + "</" + tag + ">";
    }
    function tableHtml(head, aligns, rows) {
      var h = "<div class=\"md-table\"><table><thead><tr>";
      var c;
      for (c = 0; c < head.length; c++) h += cellHtml("th", head[c], aligns[c] || "left");
      h += "</tr></thead>";
      if (rows.length) {
        h += "<tbody>";
        for (var r = 0; r < rows.length; r++) {
          h += "<tr>";
          var n = head.length > rows[r].length ? head.length : rows[r].length;
          for (c = 0; c < n; c++) {
            h += cellHtml("td", rows[r][c] || "", c < aligns.length ? aligns[c] : "left");
          }
          h += "</tr>";
        }
        h += "</tbody>";
      }
      return h + "</table></div>";
    }
    while (i < lines.length) {
      var line = lines[i];
      if (blank(line)) { flushPara(); i++; continue; }
      var fen = fenceOpen(line);
      if (fen) {
        flushPara();
        i++;
        var body = [];
        while (i < lines.length && !fenceClose(lines[i], fen.n)) {
          body.push(lines[i]);
          i++;
        }
        if (i < lines.length) i++;
        html += fenceHtml(body.join("\n"), fen.lang);
        continue;
      }
      if (i + 1 < lines.length) {
        var aligns = sepRow(lines[i + 1]);
        var headCells = aligns ? splitRow(line) : null;
        if (headCells && aligns && headCells.length === aligns.length && !sepRow(line)) {
          flushPara();
          i += 2;
          var rows = [];
          var row;
          while (i < lines.length && !blank(lines[i]) && (row = splitRow(lines[i]))) {
            rows.push(row);
            i++;
          }
          html += tableHtml(headCells, aligns, rows);
          continue;
        }
      }
      var hm = /^(#{1,6}) (.+)$/.exec(line);
      if (hm) {
        flushPara();
        html += "<h" + hm[1].length + ">" + inlineMd(hm[2]) + "</h" + hm[1].length + ">";
        i++;
        continue;
      }
      var item = ulLine(line);
      var ord = item == null ? olLine(line) : null;
      if (item != null || ord) {
        flushPara();
        if (ord) {
          html += ord.n === 1 ? "<ol>" : "<ol start=\"" + ord.n + "\">";
          while (i < lines.length && (ord = olLine(lines[i]))) {
            html += "<li>" + inlineMd(ord.t) + "</li>";
            i++;
          }
          html += "</ol>";
        } else {
          html += "<ul>";
          while (i < lines.length && (item = ulLine(lines[i])) != null) {
            html += "<li>" + inlineMd(item) + "</li>";
            i++;
          }
          html += "</ul>";
        }
        continue;
      }
      para.push(inlineMd(line));
      i++;
    }
    flushPara();
    return html;
  }
  function nearBottom(el) {
    return el.scrollHeight - el.scrollTop - el.clientHeight <= 64;
  }
  function fmtTs(ts) {
    var s = String(ts || "");
    var m = s.match(/T(\d{2}:\d{2}(?::\d{2})?)/);
    return m ? m[1] : s;
  }
  function dotClass(a) {
    var cls;
    var b = a.band || "";
    if (a.connected && a.activity === "thinking") cls = "dot on thinking";
    else if (b === "Green") cls = "dot green";
    else if (b === "Yellow") cls = "dot yellow";
    else if (b === "Red") cls = "dot red";
    else cls = a.connected ? "dot on" : "dot off";
    if (cls.indexOf("thinking") >= 0 && holdFor[a.id] === stateGen) cls += " hold";
    return cls;
  }
  function scoreTitle(a) {
    var bits = [a.connected ? "online" : "offline"];
    if (a.activity === "thinking") bits.push("thinking");
    if (a.band) bits.push(a.band);
    if (a.E != null) bits.push("E " + Number(a.E).toFixed(2));
    if (a.I != null) bits.push("I " + Number(a.I).toFixed(2));
    return bits.join(" · ");
  }
  function isBroadcastTo(to) {
    to = String(to || "").replace(/^@/, "");
    var lc = to.toLowerCase();
    return !to || lc === "all" || lc === "broadcast" || lc === "#broadcast" || lc === "everyone";
  }
  function inChannel(m, chan) {
    var t = m.type || "";
    var who = m.from || "";
    var to = m.to || "";
    var rid = m.id || "";
    if (chan === "all") {
      if (t === "register" || t === "disconnect" || t === "error" || t === "ack") return true;
      return isBroadcastTo(to);
    }
    if (t === "register" || t === "disconnect") return false;
    if (who === chan && !isBroadcastTo(to)) return true;
    if (to === chan || to === "@" + chan) return true;
    return false;
  }
  function linesPer() {
    var el = paneMap[selected] && paneMap[selected].el;
    var h = (el && el.clientHeight) ? el.clientHeight : 420;
    var n = Math.floor(h / 22);
    if (n < 16) n = 16;
    if (n > 80) n = 80;
    return n;
  }
  function humSize(n) {
    n = Number(n) || 0;
    if (n < 1024) return n + " bytes";
    if (n < 1024 * 1024) {
      var k = n / 1024;
      return (k < 10 ? k.toFixed(1) : String(Math.round(k))) + " k";
    }
    if (n < 1024 * 1024 * 1024) {
      var m = n / (1024 * 1024);
      return (m < 10 ? m.toFixed(1) : String(Math.round(m))) + " m";
    }
    var g = n / (1024 * 1024 * 1024);
    return g.toFixed(1) + " g";
  }
  function ensurePane(id) {
    id = id || "all";
    if (paneMap[id]) return paneMap[id];
    var el = document.createElement("div");
    el.className = "transcript";
    el.setAttribute("data-chan", id);
    el.hidden = id !== selected;
    if (panesRoot) panesRoot.appendChild(el);
    paneMap[id] = { el: el, page: 0, pages: 1, follow: true, seq: -1 };
    return paneMap[id];
  }
  function showPane(id) {
    id = id || "all";
    ensurePane(id);
    Object.keys(paneMap).forEach(function (k) {
      paneMap[k].el.hidden = k !== id;
    });
    pane = paneMap[id].el;
  }
  function groupLocked() {
    return !needLogin && selected.indexOf("g:") === 0;
  }
  function channelRec(id) {
    var chs = lastData.channels || [];
    for (var i = 0; i < chs.length; i++) if (chs[i].id === id) return chs[i];
    return null;
  }
  function channelWrite(id) {
    if (!needLogin) return true;
    var me = (lastData && lastData.me) || currentUser;
    if (!me || !me.strict) return true;
    var c = channelRec(id);
    return !!(c && c.write);
  }
  function showSystem() {
    if (!needLogin) return true;
    var me = (lastData && lastData.me) || currentUser;
    if (!me || !me.strict) return true;
    return !!channelRec("all");
  }
  function composeLock() {
    var structural = !selected || selected === "all" || groupLocked();
    var readonly = needLogin && !channelWrite(selected);
    var lock = structural || readonly;
    if (content) {
      content.disabled = lock;
      if (structural) content.placeholder = "Pick a berth";
      else if (readonly) content.placeholder = "Read only";
    }
    var hint = $("compose-hint");
    if (hint) hint.hidden = !lock;
    var btn = composer ? composer.querySelector("button[type=submit]") : null;
    if (btn) btn.disabled = lock;
  }
  function selectTarget(id, fromUser) {
    if (fromUser) pinned = true;
    selected = id || "all";
    if (toField) toField.value = selected;
    var label = channelLabel(selected);
    if (head) head.textContent = label;
    if (content && selected && selected !== "all" && !groupLocked()) {
      content.placeholder = "Message " + label;
    }
    showPane(selected);
    renderChannels(lastData.agents || []);
    loadHistory(selected);
    composeLock();
  }
  function channelLabel(id) {
    if (!id || id === "all") return "#system";
    var chs = lastData.channels || [];
    for (var i = 0; i < chs.length; i++) {
      if (chs[i].id === id) {
        if (chs[i].kind === "group") return "#" + (chs[i].name || id);
        return "@" + (chs[i].name || id);
      }
    }
    return id.indexOf("g:") === 0 ? "#" + id.slice(2) : "@" + id;
  }
  function renderChannels(agents) {
    var html = "";
    if (showSystem()) {
      html += '<button type="button" class="chan' + (selected === "all" ? " sel" : "")
        + '" data-id="all"><span class="hash">#</span>system</button>';
    }
    var online = 0;
    for (var i = 0; i < agents.length; i++) {
      var a = agents[i];
      if (a.connected) online++;
      var label = a.name || a.id;
      html += '<div class="chan'
        + (a.connected ? "" : " offline")
        + (selected === a.id ? " sel" : "")
        + '" data-id="' + esc(a.id) + '" title="' + esc(scoreTitle(a)) + '">'
        + '<span class="' + dotClass(a) + '"></span>'
        + '<span class="name">' + esc(label) + "</span>"
        + (a.connected ? "" : '<span class="tag">offline</span>')
        + "</div>";
    }
    var chs = lastData.channels || [];
    for (var j = 0; j < chs.length; j++) {
      var c = chs[j];
      if (c.kind !== "group") continue;
      html += '<button type="button" class="chan' + (selected === c.id ? " sel" : "")
        + '" data-id="' + esc(c.id) + '"><span class="hash">#</span>'
        + esc(c.name || c.id) + "</button>";
    }
    if (channels) channels.innerHTML = html;
    if (sideFoot) sideFoot.textContent = online + " online";
  }
  function isMateId(id) {
    id = String(id || "").replace(/^@/, "");
    if (!id || id === "human" || id === "all") return false;
    if (currentUser && id === currentUser.id) return false;
    var agents = lastData.agents || [];
    var i;
    for (i = 0; i < agents.length; i++) if (agents[i].id === id) return true;
    var chs = lastData.channels || [];
    for (i = 0; i < chs.length; i++) {
      if (chs[i].id === id && chs[i].kind === "dm") return true;
    }
    return false;
  }
  function isMatePing(m) {
    var t = m.type || "";
    if (t === "register" || t === "disconnect" || t === "error" || t === "ack") return false;
    var to = String(m.to || "").replace(/^@/, "");
    if (isBroadcastTo(to)) return false;
    return isMateId(m.from) && isMateId(to);
  }
  function mentionKey(m) {
    var s = String(m.ts || "") + "\n" + String(m.from || "") + "\n"
      + String(m.to || "") + "\n" + String(m.content || "");
    var h = 0;
    for (var i = 0; i < s.length; i++) h = ((h << 5) - h + s.charCodeAt(i)) | 0;
    return (h >>> 0).toString(16);
  }
  function messageHtml(m, chan, thinkKeys) {
    var t = m.type || "";
    if (t === "register") {
      return '<div class="msg sys">' + esc(m.id || m.from) + " online"
        + '<span class="ts">' + esc(fmtTs(m.ts)) + "</span></div>";
    }
    if (t === "disconnect") {
      return '<div class="msg sys">' + esc(m.id || m.from) + " offline"
        + '<span class="ts">' + esc(fmtTs(m.ts)) + "</span></div>";
    }
    if (t === "error" || t === "ack") {
      return '<div class="msg sys">' + esc(t) + ": " + esc(m.content)
        + '<span class="ts">' + esc(fmtTs(m.ts)) + "</span></div>";
    }
    var who = m.from || "unknown";
    var to = m.to || "all";
    var files = m.files || [];
    var chips = "";
    for (var i = 0; i < files.length; i++) chips += fileChip(files[i]);
    var body = m.content ? '<div class="body">' + renderMd(m.content) + "</div>" : "";
    if (isMatePing(m)) {
      var toId = String(to).replace(/^@/, "");
      var key = mentionKey(m);
      var label = (toId === chan) ? ("a message from " + who) : ("a message to " + toId);
      var spinning = thinkKeys && thinkKeys[toId] === key;
      var ball = spinning ? '<span class="dot on thinking" title="thinking"></span>' : "";
      var open = openMentions[key] ? " open" : "";
      return '<div class="msg mention' + open + '" data-key="' + esc(key) + '">'
        + '<div class="mention-line"><button type="button" class="mention-btn">'
        + ball
        + '<span class="who">' + esc(label) + "</span></button>"
        + '<span class="ts" title="' + esc(m.ts) + '">' + esc(fmtTs(m.ts)) + "</span></div>"
        + '<div class="mention-body">' + body + chips + "</div></div>";
    }
    var dest = isBroadcastTo(to) ? "#broadcast" : "@" + to;
    var mine = who === "human" || (currentUser && who === currentUser.id);
    return '<div class="msg' + (mine ? " me" : "") + '">'
      + '<div class="meta"><span class="who">' + esc(who) + "</span>"
      + '<span class="to">→ ' + esc(dest) + "</span>"
      + '<span class="ts" title="' + esc(m.ts) + '">' + esc(fmtTs(m.ts)) + "</span></div>"
      + body + chips + "</div>";
  }
  function fileChip(f) {
    var id = f.id || "";
    var name = f.name || "file";
    var href = "__API__/files/" + encodeURIComponent(id);
    var dl = href + "?dl=1";
    return '<div class="filechip" data-id="' + esc(id) + '" data-name="' + esc(name) + '" data-mime="' + esc(f.mime || "") + '" data-bytes="' + esc(f.bytes || 0) + '">'
      + '<a class="name" href="' + href + '" target="_blank" rel="noopener">' + esc(name) + "</a>"
      + '<button type="button" class="ico dl" title="download" data-act="dl">↓</button>'
      + '<button type="button" class="ico clip" title="copy file to clipboard" data-act="clip">⧉</button>'
      + '<span class="sz">' + esc(humSize(f.bytes)) + "</span></div>";
  }
  function emptyHtml(chan) {
    var label = chan === "all" ? "#broadcast" : "@" + chan;
    return '<div class="msg sys">No messages in ' + esc(label) + " yet.</div>";
  }
  function renderPager() {
    if (!pager) return;
    var st = paneMap[selected];
    if (!st) { pager.innerHTML = ""; return; }
    var pages = st.pages || 1;
    var cur = st.page || 1;
    var h = pager.clientHeight || 400;
    var btnH = 26;
    var slots = Math.floor((h - btnH * 7) / btnH);
    if (slots < 3) slots = 3;
    if (slots > 10) slots = 10;
    if (slots % 2 === 0) slots--;
    var half = Math.floor(slots / 2);
    var start = cur - half;
    var end = cur + half;
    if (start < 1) { end += 1 - start; start = 1; }
    if (end > pages) { start -= (end - pages); end = pages; }
    if (start < 1) start = 1;
    function b(cls, inner, title, go, dis) {
      return '<button type="button" class="' + cls + '" data-go="' + go + '" title="' + title + '"'
        + (dis ? " disabled" : "") + ">" + inner + "</button>";
    }
    var html = "";
    html += b("", '<span class="rot-up">|&lt;--</span>', "first page", "first", cur <= 1);
    html += b("", '<span class="rot-up">&lt;&lt;</span>', "back 10 pages", "-10", cur <= 1);
    html += b("", '<span class="rot-up">&lt;</span>', "previous page", "-1", cur <= 1);
    for (var n = start; n <= end; n++) {
      html += b(n === cur ? "cur" : "", String(n), "page " + n, String(n), false);
    }
    html += b("", '<span class="rot-dn">&gt;</span>', "next page", "+1", cur >= pages);
    html += b("", '<span class="rot-dn">&gt;&gt;</span>', "forward 10 pages", "+10", cur >= pages);
    html += b("", '<span class="rot-dn">--&gt;|</span>', "last page", "last", cur >= pages);
    pager.innerHTML = html;
  }
  function goPage(spec) {
    var st = paneMap[selected];
    if (!st) return;
    var cur = st.page || 1, pages = st.pages || 1, next = cur;
    if (spec === "first") next = 1;
    else if (spec === "last") next = pages;
    else if (spec === "-10") next = cur - 10;
    else if (spec === "+10") next = cur + 10;
    else if (spec === "-1") next = cur - 1;
    else if (spec === "+1") next = cur + 1;
    else next = parseInt(spec, 10) || cur;
    if (next < 1) next = 1;
    if (next > pages) next = pages;
    st.follow = (next >= pages);
    st.page = next;
    // A numbered click requests that page. Only the last-page control and
    // the follow poll ask for "last".
    loadHistory(selected, spec !== "last");
  }
  var pollTimer = 0;
  function bootOut(code) {
    if (pollTimer) { clearInterval(pollTimer); pollTimer = 0; }
    var title = code === 401 ? "Sign in required" : "Forbidden";
    var extra = code === 401
      ? "<p>Sign in required.</p><p><a href=\"__ACCOUNT__\">Sign in</a></p>"
      : "<p>Forbidden.</p>";
    document.open();
    document.write("<!DOCTYPE html><html lang=\"en\"><head><meta charset=\"utf-8\"><title>"
      + title + "</title></head><body>" + extra + "</body></html>");
    document.close();
  }
  function denied(r) {
    if (r && (r.status === 401 || r.status === 403)) {
      if (needLogin) { showLogin(); return true; }
      bootOut(r.status);
      return true;
    }
    return false;
  }
  function loadHistory(chan, exact) {
    chan = chan || selected;
    var st = ensurePane(chan);
    var page = (!exact && st.follow) ? "last" : String(st.page || "last");
    var url = "__API__/history?channel=" + encodeURIComponent(chan)
      + "&page=" + encodeURIComponent(page) + "&lines=" + linesPer();
    var isLast = st.follow || page === "last";
    fetch(url, { cache: isLast ? "no-store" : "default" }).then(function (r) {
      if (denied(r)) return null;
      if (r.status === 304) return null;
      return r.json();
    }).then(function (h) {
      if (!h) return;
      st.pages = h.pages || 1;
      st.page = h.page || 1;
      st.seq = h.seq || 0;
      var msgs = h.messages || [];
      var thinkKeys = {};
      var ti;
      for (ti = 0; ti < msgs.length; ti++) {
        if (!isMatePing(msgs[ti])) continue;
        var toId = String(msgs[ti].to || "").replace(/^@/, "");
        if (activityOf(toId) === "thinking") thinkKeys[toId] = mentionKey(msgs[ti]);
      }
      var html = "";
      for (var i = 0; i < msgs.length; i++) html += messageHtml(msgs[i], chan, thinkKeys);
      if (!html) html = emptyHtml(chan);
      st.el.innerHTML = html;
      notePainted(chan, msgs);
      if (st.follow) st.el.scrollTop = st.el.scrollHeight;
      if (chan === selected) renderPager();
    }).catch(function () {});
  }
  function activityOf(id) {
    var agents = lastData.agents || [];
    for (var i = 0; i < agents.length; i++) {
      if (agents[i].id === id) return agents[i].activity || "idle";
    }
    return "idle";
  }
  function notePainted(chan, msgs) {
    var first = !primed[chan];
    primed[chan] = true;
    var latest = {};
    var order = [];
    for (var i = 0; i < msgs.length; i++) {
      var m = msgs[i];
      var t = m.type || "";
      if (t === "register" || t === "disconnect" || t === "error" || t === "ack") continue;
      var who = m.from || "";
      if (!who || who === "human" || (currentUser && who === currentUser.id)) continue;
      var key = String(m.ts || "") + "\n" + String(m.content || "");
      if (!latest[who]) order.push(who);
      latest[who] = key;
    }
    var hold = false;
    for (var j = 0; j < order.length; j++) {
      var id = order[j];
      var key = latest[id];
      var prev = seenFrom[id];
      seenFrom[id] = key;
      if (first || prev === key) continue;
      if (activityOf(id) === "thinking") {
        holdFor[id] = stateGen;
        hold = true;
      }
    }
    if (hold) renderChannels(lastData.agents || []);
  }
  function applyAgents(data) {
    var prevGen = stateGen;
    stateGen++;
    var hadHold = false;
    for (var hid in holdFor) {
      if (holdFor[hid] === prevGen) hadHold = true;
    }
    var raw = JSON.stringify(data.agents || []);
    var seq = data.seq || 0;
    lastData = data;
    if (data.me) currentUser = data.me;
    if (needLogin && currentUser && currentUser.strict && selected === "all" && !showSystem()) {
      var nxt = "";
      var rosterCh = data.channels || [];
      for (var ci = 0; ci < rosterCh.length; ci++) {
        if (rosterCh[ci].id && rosterCh[ci].id !== "all") { nxt = rosterCh[ci].id; break; }
      }
      if (!nxt && data.agents && data.agents.length) nxt = data.agents[0].id;
      if (nxt) { selectTarget(nxt, false); return; }
    }
    if (!pinned && !landed && selected === "all") {
      var crew = data.agents || [];
      var hasCaptain = false;
      var hasZhc = false;
      for (var zi = 0; zi < crew.length; zi++) {
        if (crew[zi].id === "captain") hasCaptain = true;
        if (crew[zi].id === "zhc" && crew[zi].connected) hasZhc = true;
      }
      if (hasCaptain && !hasZhc) {
        landed = true;
        selectTarget("captain", false);
        return;
      }
    }
    if (raw !== lastAgentsRaw || hadHold) {
      lastAgentsRaw = raw;
      var agents = data.agents || [];
      for (var i = 0; i < agents.length; i++) ensurePane(agents[i].id);
      renderChannels(agents);
    }
    if (!pinned) {
      var roster = data.agents || [];
      for (var k = 0; k < roster.length; k++) {
        if (roster[k].id === "zhc" && roster[k].connected && selected !== "zhc") {
          selectTarget("zhc", false);
          return;
        }
      }
    }
    var st = paneMap[selected] || ensurePane(selected);
    if (st.seq !== seq) {
      if (st.follow) loadHistory(selected);
      else st.seq = seq;
    }
  }
  function tick() {
    fetch("__API__/state", { cache: "no-store" }).then(function (r) {
      if (denied(r)) return null;
      return r.json();
    }).then(function (data) { if (data) applyAgents(data); }).catch(function () {});
  }
  function refreshPending() {
    if (!pendingEl) return;
    if (!pendingFiles.length) { pendingEl.textContent = ""; return; }
    pendingEl.textContent = pendingFiles.map(function (f) {
      return f.name + " (" + humSize(f.bytes) + ")";
    }).join(" · ");
  }
  function uploadFile(file) {
    var q = "__API__/files?name=" + encodeURIComponent(file.name)
      + "&mime=" + encodeURIComponent(file.type || "application/octet-stream");
    return fetch(q, { method: "POST", body: file }).then(function (r) {
      if (denied(r)) return null;
      return r.json();
    }).then(function (j) {
      if (j && j.ok && j.id) pendingFiles.push(j);
      refreshPending();
    });
  }
  function send(ev) {
    if (ev) ev.preventDefault();
    if (!selected || selected === "all" || groupLocked()) return;
    if (needLogin && !channelWrite(selected)) return;
    var text = (content.value || "").replace(/^\s+|\s+$/g, "");
    if (!text && !pendingFiles.length) return;
    var to = selected || "all";
    var files = pendingFiles.map(function (f) {
      return { id: f.id, name: f.name, bytes: f.bytes, mime: f.mime };
    });
    fetch("__API__/send", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ to: to, content: text, files: files })
    }).then(function (r) {
      if (denied(r) || !r.ok) return;
      content.value = "";
      pendingFiles = [];
      refreshPending();
      var st = paneMap[selected];
      if (st) { st.follow = true; }
      tick();
    }).catch(function () {});
    content.focus();
  }
  function onChipClick(ev) {
    var btn = ev.target;
    if (!btn || !btn.getAttribute) return;
    var act = btn.getAttribute("data-act");
    if (!act) return;
    var chip = btn;
    while (chip && chip !== panesRoot && !(chip.className && chip.className.indexOf("filechip") >= 0)) {
      chip = chip.parentNode;
    }
    if (!chip || !chip.getAttribute) return;
    ev.preventDefault();
    var id = chip.getAttribute("data-id");
    var name = chip.getAttribute("data-name") || "file";
    var mime = chip.getAttribute("data-mime") || "application/octet-stream";
    var href = "__API__/files/" + encodeURIComponent(id);
    if (act === "dl") {
      var a = document.createElement("a");
      a.href = href + "?dl=1";
      a.download = name;
      a.click();
      return;
    }
    if (act === "clip") {
      var bytes = Number(chip.getAttribute("data-bytes") || 0);
      if (bytes >= 1024 * 1024 * 1024) {
        btn.title = "too large for clipboard";
        return;
      }
      fetch(href).then(function (r) { return r.blob(); }).then(function (blob) {
        var type = mime.indexOf("/") > 0 ? mime : "application/octet-stream";
        if (navigator.clipboard && window.ClipboardItem) {
          var item = {};
          item[type] = blob;
          return navigator.clipboard.write([new ClipboardItem(item)]).catch(function () {
            return navigator.clipboard.writeText(location.origin + href);
          });
        }
        return navigator.clipboard.writeText(location.origin + href);
      }).catch(function () {});
    }
  }
  function init() {
    panesRoot = $("panes");
    pager = $("pager");
    pendingEl = $("pending");
    fileInput = $("file-input");
    var existing = panesRoot ? panesRoot.querySelector('[data-chan="all"]') : null;
    if (existing) {
      paneMap.all = { el: existing, page: 0, pages: 1, follow: true, seq: -1 };
      pane = existing;
    } else {
      ensurePane("all");
    }
    showPane("all");
    channels = $("channels");
    head = $("head");
    toField = $("to-field");
    content = $("content");
    composer = $("composer");
    sideFoot = $("side-foot");
    channels.addEventListener("click", function (e) {
      var el = e.target;
      while (el && el !== channels && !(el.getAttribute && el.getAttribute("data-id"))) el = el.parentNode;
      if (el && el.getAttribute && el.getAttribute("data-id")) selectTarget(el.getAttribute("data-id"), true);
    });
    if (pager) pager.addEventListener("click", function (e) {
      var el = e.target;
      while (el && el !== pager && !el.getAttribute("data-go")) el = el.parentNode;
      if (el && el.getAttribute("data-go")) goPage(el.getAttribute("data-go"));
    });
    if (panesRoot) panesRoot.addEventListener("click", function (ev) {
      onChipClick(ev);
      var el = ev.target;
      while (el && el !== panesRoot) {
        if (el.className && String(el.className).indexOf("mention-btn") >= 0) break;
        el = el.parentNode;
      }
      if (!el || el === panesRoot || !el.parentNode) return;
      var row = el.parentNode;
      while (row && row !== panesRoot && !(row.getAttribute && row.getAttribute("data-key"))) {
        row = row.parentNode;
      }
      if (!row || row === panesRoot) return;
      var key = row.getAttribute ? (row.getAttribute("data-key") || "") : "";
      var cls = String(row.className || "");
      if (cls.indexOf(" open") >= 0) {
        row.className = cls.replace(" open", "");
        delete openMentions[key];
      } else {
        row.className = cls + " open";
        openMentions[key] = 1;
      }
    });
    composer.addEventListener("submit", send);
    content.addEventListener("keydown", function (e) {
      if (e.key === "Enter" && !e.shiftKey) { e.preventDefault(); send(); }
    });
    if (fileInput) fileInput.addEventListener("change", function () {
      var files = fileInput.files || [];
      var chain = Promise.resolve();
      for (var i = 0; i < files.length; i++) {
        (function (f) { chain = chain.then(function () { return uploadFile(f); }); })(files[i]);
      }
      chain.then(function () { fileInput.value = ""; });
    });
    window.addEventListener("resize", function () { renderPager(); loadHistory(selected); });
    composeLock();
    tick();
    pollTimer = setInterval(tick, 1500);
    var open = $("acct-open");
    var crewOpen = $("crew-open");
    if (currentUser && currentUser.role === "manager") {
      if (open) open.hidden = false;
      if (crewOpen) crewOpen.hidden = false;
    }
  }
  function showLogin() {
    var box = $("login");
    if (box) box.hidden = false;
  }
  function hideLogin() {
    var box = $("login");
    if (box) box.hidden = true;
  }
  function boot() {
    var form = $("login-form");
    if (form) form.addEventListener("submit", function (ev) {
      ev.preventDefault();
      var err = $("login-err");
      fetch("__API__/login", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          user: ($("login-user").value || "").replace(/^\s+|\s+$/g, ""),
          password: $("login-pass").value || ""
        })
      }).then(function (r) { return r.json().then(function (j) { return { status: r.status, body: j }; }); })
        .then(function (res) {
          if (res.status === 403) {
            if (err) err.textContent = "suspended";
            return;
          }
          if (!res.body || !res.body.ok) {
            if (err) err.textContent = "bad login";
            return;
          }
          currentUser = res.body.user;
          if (err) err.textContent = "";
          hideLogin();
          init();
        }).catch(function () { if (err) err.textContent = "bad login"; });
    });
    var open = $("acct-open");
    if (open) open.addEventListener("click", function () {
      var box = $("acct");
      if (box) box.hidden = false;
      fetch("__API__/users", { cache: "no-store" }).then(function (r) { return r.json(); }).then(function (j) {
        var list = $("acct-list");
        if (list) list.textContent = JSON.stringify((j && j.users) || [], null, 2);
      }).catch(function () {});
    });
    function hideBox(id) {
      var box = $(id);
      if (box) box.hidden = true;
    }
    var closeBtn = $("acct-close");
    if (closeBtn) closeBtn.addEventListener("click", function () { hideBox("acct"); });
    var acctX = $("acct-x");
    if (acctX) acctX.addEventListener("click", function () { hideBox("acct"); });
    var crewX = $("crew-x");
    if (crewX) crewX.addEventListener("click", function () { hideBox("crew"); });
    document.addEventListener("keydown", function (e) {
      if (e.key !== "Escape") return;
      hideBox("acct");
      hideBox("crew");
    });
    var crewList = [];
    var crewIdx = 0;
    function showCrewAt() {
      var name = $("crew-name");
      var c = crewList[crewIdx];
      if (!c) {
        if (name) name.textContent = "—";
        return;
      }
      if (name) name.textContent = c.alias;
      var net = $("crew-net"), desk = $("crew-desk"), db = $("crew-db");
      if (net) net.checked = !!c.network;
      if (desk) desk.checked = !!c.desktop;
      if (db) db.checked = !!c.db;
    }
    function loadCrew(selectAlias) {
      return fetch("__API__/crew", { cache: "no-store" }).then(function (r) { return r.json(); }).then(function (j) {
        crewList = (j && j.crew) || [];
        if (selectAlias) {
          for (var i = 0; i < crewList.length; i++) {
            if (crewList[i].alias === selectAlias) crewIdx = i;
          }
        }
        if (crewIdx >= crewList.length) crewIdx = 0;
        showCrewAt();
        return j;
      });
    }
    var crewOpen = $("crew-open");
    if (crewOpen) crewOpen.addEventListener("click", function () {
      var box = $("crew");
      if (box) box.hidden = false;
      var err = $("crew-err");
      if (err) err.textContent = "";
      loadCrew().catch(function () { if (err) err.textContent = "could not list crew"; });
    });
    var prev = $("crew-prev"), next = $("crew-next");
    if (prev) prev.addEventListener("click", function () {
      if (!crewList.length) return;
      crewIdx = (crewIdx - 1 + crewList.length) % crewList.length;
      showCrewAt();
    });
    if (next) next.addEventListener("click", function () {
      if (!crewList.length) return;
      crewIdx = (crewIdx + 1) % crewList.length;
      showCrewAt();
    });
    var crewForm = $("crew-form");
    if (crewForm) crewForm.addEventListener("submit", function (ev) {
      ev.preventDefault();
      var err = $("crew-err");
      var alias = ($("crew-alias").value || "").replace(/^\s+|\s+$/g, "");
      fetch("__API__/crew", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ alias: alias })
      }).then(function (r) { return r.json(); }).then(function (j) {
        if (err) err.textContent = j && j.ok ? "" : ((j && j.error) || "failed");
        if (j && j.ok) loadCrew(alias);
      }).catch(function () { if (err) err.textContent = "failed"; });
    });
    var crewSave = $("crew-save");
    if (crewSave) crewSave.addEventListener("click", function () {
      var err = $("crew-err");
      var c = crewList[crewIdx];
      if (!c) { if (err) err.textContent = "no crew"; return; }
      fetch("__API__/crew/" + encodeURIComponent(c.alias), {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          network: $("crew-net").checked,
          desktop: $("crew-desk").checked,
          db: $("crew-db").checked
        })
      }).then(function (r) { return r.json(); }).then(function (j) {
        if (err) err.textContent = j && j.ok ? "" : ((j && j.error) || "failed");
        if (j && j.ok) loadCrew(c.alias);
      }).catch(function () { if (err) err.textContent = "failed"; });
    });
    var acct = $("acct-form");
    if (acct) acct.addEventListener("submit", function (ev) {
      ev.preventDefault();
      fetch("__API__/users", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          id: ($("acct-user").value || "").replace(/^\s+|\s+$/g, ""),
          password: $("acct-pass").value || "",
          role: $("acct-role").value
        })
      }).then(function (r) { return r.json(); }).then(function (j) {
        var err = $("acct-err");
        if (err) err.textContent = j && j.ok ? "" : ((j && j.error) || "failed");
      }).catch(function () {});
    });
    var grant = $("acct-grant");
    if (grant) grant.addEventListener("click", function () {
      fetch("__API__/grants", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          user: ($("acct-user").value || "").replace(/^\s+|\s+$/g, ""),
          channel: ($("acct-chan").value || "").replace(/^\s+|\s+$/g, ""),
          read: $("acct-read").checked,
          write: $("acct-write").checked
        })
      }).then(function (r) { return r.json(); }).then(function (j) {
        var err = $("acct-err");
        if (err) err.textContent = j && j.ok ? "" : ((j && j.error) || "failed");
      }).catch(function () {});
    });
    if (!needLogin) { init(); return; }
    fetch("__API__/me", { cache: "no-store" }).then(function (r) {
      if (r.status === 401) { showLogin(); return null; }
      return r.json();
    }).then(function (me) {
      if (!me || !me.ok) return;
      currentUser = me;
      hideLogin();
      init();
    }).catch(function () { showLogin(); });
  }
  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", boot);
  else boot();
})();
</script>
</body>
</html>
CHAT_HTML
}

# FastCGI records for the hub-owned listen socket. FCGI.pm Accept() plus
# IO::Select on the same listen fd busy-loops (select says ready, Accept
# never calls accept(2)), so we speak the protocol ourselves.
sub fcgi_readn {
    my ($fh, $n) = @_;
    my $buf = '';
    while (length($buf) < $n) {
        my $r = read($fh, my $chunk, $n - length($buf));
        return undef if !defined $r || $r == 0;
        $buf .= $chunk;
    }
    return $buf;
}

sub fcgi_read_record {
    my ($fh) = @_;
    my $hdr = fcgi_readn($fh, 8);
    return unless defined $hdr;
    my ($ver, $type, $id, $clen, $pad) = unpack('CCnnC', $hdr);
    my $content = $clen ? fcgi_readn($fh, $clen) : '';
    return unless defined $content;
    fcgi_readn($fh, $pad) if $pad;
    return ($type, $id, $content);
}

sub fcgi_write_record {
    my ($fh, $type, $id, $content) = @_;
    $content //= '';
    my $clen = length $content;
    my $pad  = (8 - ($clen % 8)) % 8;
    print $fh pack('CCnnCC', 1, $type, $id, $clen, $pad, 0),
        $content, ("\0" x $pad);
}

sub fcgi_nv_decode {
    my ($s) = @_;
    my %h;
    my $off = 0;
    my $len = length($s);
    while ($off < $len) {
        last if $off + 1 > $len;
        my $nlen = unpack('C', substr($s, $off, 1));
        if ($nlen & 0x80) {
            last if $off + 4 > $len;
            $nlen = unpack('N', substr($s, $off, 4)) & 0x7fffffff;
            $off += 4;
        } else {
            $off += 1;
        }
        last if $off + 1 > $len;
        my $vlen = unpack('C', substr($s, $off, 1));
        if ($vlen & 0x80) {
            last if $off + 4 > $len;
            $vlen = unpack('N', substr($s, $off, 4)) & 0x7fffffff;
            $off += 4;
        } else {
            $off += 1;
        }
        last if $off + $nlen + $vlen > $len;
        my $k = substr($s, $off, $nlen); $off += $nlen;
        my $v = substr($s, $off, $vlen); $off += $vlen;
        $h{$k} = $v;
    }
    return \%h;
}

sub fcgi_serve_conn {
    my ($fh) = @_;
    $fh->blocking(1);
    $fh->autoflush(1);
    my %env;
    my $stdin = '';
    my $reqid = 1;
    my $got_begin = 0;
    eval {
        local $SIG{ALRM} = sub { die "fcgi timeout\n" };
        alarm 15;
        while (1) {
            my ($type, $id, $content) = fcgi_read_record($fh);
            last unless defined $type;
            $reqid = $id if $id;
            if ($type == 1) { $got_begin = 1; next }          # BEGIN_REQUEST
            if ($type == 4) {                                 # PARAMS
                %env = (%env, %{ fcgi_nv_decode($content) }) if length $content;
                next;
            }
            if ($type == 5) {                                 # STDIN
                $stdin .= $content if length $content;
                my $need = $env{CONTENT_LENGTH} // '';
                last if !length $content
                    || ($need =~ /^\d+$/ && length($stdin) >= $need);
                next;
            }
        }
        alarm 0;
    };
    alarm 0;
    return unless $got_begin;

    local %ENV = (%ENV, %env);
    $FCGI_STDIN_BUF = $stdin;
    $FCGI_BUF = '';
    eval { handle_fcgi(undef) };
    if ($@) {
        warn "fcgi handler: $@";
        $FCGI_BUF = '';
        json_out(500, { ok => \0, error => 'hub error' });
    } elsif (!length($FCGI_BUF // '') && ($ENV{REQUEST_URI} // '') =~ m{/api/}) {
        json_out(500, { ok => \0, error => 'empty api response' });
    }
    my $out = $FCGI_BUF // '';
    $FCGI_BUF = undef;
    $FCGI_STDIN_BUF = undef;

    my $off = 0;
    while ($off < length($out)) {
        my $chunk = substr($out, $off, 65535);
        $off += length $chunk;
        fcgi_write_record($fh, 6, $reqid, $chunk);            # STDOUT
    }
    fcgi_write_record($fh, 6, $reqid, '');                    # end STDOUT
    fcgi_write_record($fh, 3, $reqid, pack('NCCCC', 0, 0, 0, 0, 0));  # END_REQUEST
    close $fh;
}

# ---------- main loop ----------
# FCGI.pm's XS layer uses alarm() as an accept timeout when no web server
# manages the listen socket; without a handler SIGALRM's default action
# kills the process. Ignore it — Accept() then just returns -1 and the
# select loop below services agents. The hub-owned FCGI socket is handled
# with IO::Socket + fcgi_serve_conn instead.
$SIG{ALRM} = 'IGNORE';
$SIG{PIPE} = 'IGNORE';
# FCGI installs a TERM handler that does not exit. rcctl stop sends TERM.
$SIG{TERM} = sub { exit 0 };
$SIG{INT}  = sub { exit 0 };

# FCGI stdin is a unix socket when httpd/slowcgi is in front. A tty or
# /dev/null makes Accept() block and starves the agent socket — skip it.
# Otherwise bind FCGI_SOCK ourselves so httpd can talk to this daemon.
my $DO_FCGI = ($ENV{HUB_NOFCGI} // '') ne '1'
    && defined fileno(STDIN) && stat(STDIN) && -S _;
my $request;
my $fcgi_listen_fh;
if ($DO_FCGI) {
    $request = FCGI::Request();
    fcntl(STDIN, F_GETFL, my $flags = 0);
    fcntl(STDIN, F_SETFL, $flags | O_NONBLOCK);
} elsif (($ENV{HUB_NOFCGI} // '') ne '1' && $FCGI_SOCK) {
    my $d = _parent_dir($FCGI_SOCK);
    mkdir $d, 0755 unless -d $d;
    unlink $FCGI_SOCK if -e $FCGI_SOCK;
    $fcgi_listen_fh = IO::Socket::UNIX->new(
        Local  => $FCGI_SOCK,
        Type   => SOCK_STREAM,
        Listen => 32,
    ) or die "fcgi listen $FCGI_SOCK: $!\n";
    $fcgi_listen_fh->blocking(0);
    my $fmode = $ENV{PICOBUS_FCGI_MODE} // '0666';
    chmod oct($fmode), $FCGI_SOCK;
    if (defined $ENV{PICOBUS_FCGI_GROUP} && $ENV{PICOBUS_FCGI_GROUP} ne '') {
        my $gid = getgrnam($ENV{PICOBUS_FCGI_GROUP});
        die "PICOBUS_FCGI_GROUP $ENV{PICOBUS_FCGI_GROUP}: unknown group\n"
            unless defined $gid;
        my $uid = (stat $FCGI_SOCK)[4];
        chown $uid, $gid, $FCGI_SOCK or die "chown $FCGI_SOCK: $!\n";
    }
    $sel->add($fcgi_listen_fh);
    $DO_FCGI = 1;
}

if ($ZHC_GATE) {
    require DBI;
    require DBD::SQLite;
}
hub_sandbox();

print STDERR "picobus listening agents=$HUB_SOCK fcgi=", ($DO_FCGI ? ($FCGI_SOCK // 'stdin') : 'off'), "\n";

while (1) {
    expire_stale_activity();
    # STDIN-style FCGI (slowcgi): poll. Own listen socket: handled in select.
    if ($DO_FCGI && $request && !$fcgi_listen_fh && $request->Accept() >= 0) {
        handle_fcgi($request);
        $request->Finish();
    }

    # 2. Unix side
    my @ready = $sel->can_read($SELECT_TO);
    for my $fh (@ready) {
        if ($fcgi_listen_fh && defined(fileno($fh)) && defined(fileno($fcgi_listen_fh))
            && fileno($fh) == fileno($fcgi_listen_fh)) {
            my $c = $fcgi_listen_fh->accept;
            fcgi_serve_conn($c) if $c;
            next;
        }
        if (defined(fileno($fh)) && fileno($fh) == fileno($hub)) {
            my $client = $hub->accept or next;
            $client->blocking(0);
            $sel->add($client);
            # temporary id until register
            my $tmp = "anon-" . fileno($client);
            $agents{$tmp} = { sock => $client, buf => '' };
            $fd2id{fileno($client)} = $tmp;
            next;
        }

        # data from an agent
        my $fn = fileno($fh);
        my $id = $fd2id{$fn} or do { close_agent($fh); next };
        my $bufref = \$agents{$id}{buf};

        my $n = sysread($fh, my $chunk, 8192);
        if (!defined $n) {
            next if $!{EAGAIN} || $!{EWOULDBLOCK};
            close_agent($fh);
            next;
        }
        if ($n == 0) {
            close_agent($fh);
            next;
        }
        $$bufref .= $chunk;

        while ($$bufref =~ s/^(.*?)\n//) {
            my $line = $1;
            next unless length $line;
            # first line may be a register that changes the id
            if ($line =~ /"type"\s*:\s*"register"/) {
                my $obj = eval { decode_json($line) };
                if ($obj && $obj->{id}) {
                    if (bind_registered_agent($fh, $id, $obj->{id}, $$bufref)) {
                        $id = $obj->{id};
                        $bufref = \$agents{$id}{buf} if $agents{$id};
                    }
                    next;
                }
            }
            handle_agent_line($id, $line);
        }
    }
}

# cleanup on exit (rarely reached)
END {
    unlink $HUB_SOCK if $HUB_SOCK && -e $HUB_SOCK;
}
