#!/usr/bin/perl
# picobus-pico — translate picobus hub NDJSON <-> PicoClaw native WebSocket.
#
# PicoClaw never speaks hub NDJSON. talkd, the web UI, and hubctl stay on
# hub.sock. This process is the only thing that holds a Pico WS.
#
# Env:
#   HUB_SOCK        UNIX hub (default /var/run/picoclaw/hub.sock)
#   PICO_AGENTS     comma list of id=host:port (required)
#   PICO_TOKEN_DIR  directory of files named by agent id (required)
#   PICO_IDLE_FLUSH seconds after last non-thought content (default 8)
#
# Requires Mojolicious (pkg_add p5-Mojolicious). Do not hand-roll WS frames.

use strict;
use warnings;
use JSON::PP qw(encode_json decode_json);
use Mojo::IOLoop;
use Mojo::UserAgent;

my $HUB_SOCK   = $ENV{HUB_SOCK}      // '/var/run/picoclaw/hub.sock';
my $TOKEN_DIR  = $ENV{PICO_TOKEN_DIR} // '';
my $IDLE_FLUSH = $ENV{PICO_IDLE_FLUSH} // 8;
my $SPEC       = $ENV{PICO_AGENTS}    // '';

$| = 1;

sub logmsg {
    print STDERR "[picobus-pico] @_\n";
}

die "PICO_AGENTS required (id=host:port,...)\n" unless length $SPEC;
if (!length $TOKEN_DIR) {
    die "PICO_TOKEN_DIR required (unset)\n";
}
if (!-d $TOKEN_DIR) {
    # -d is false for a missing path, a file, and EACCES on a parent.
    # The hub chmod 0700s /var/picobus/secrets on every start. Tokens
    # must not live under that directory or this is "Permission denied".
    my $err = $!;
    if (-e $TOKEN_DIR) {
        $err = 'not a directory';
    }
    elsif (!$err) {
        $err = 'not a directory';
    }
    die "PICO_TOKEN_DIR required ($err)\n";
}

my @agents;
for my $part (split /,/, $SPEC) {
    $part =~ s/^\s+|\s+$//g;
    next unless length $part;
    if ($part =~ /^([A-Za-z0-9_.-]+)=([^:]+):(\d+)$/) {
        push @agents, { id => $1, host => $2, port => 0 + $3 };
    }
    else {
        die "bad PICO_AGENTS entry '$part' (want id=host:port)\n";
    }
}
die "PICO_AGENTS parsed empty\n" unless @agents;

for my $a (@agents) {
    my $p = "$TOKEN_DIR/$a->{id}";
    open my $fh, '<', $p or die "token $p: $!\n";
    my $tok = <$fh> // '';
    close $fh;
    $tok =~ s/\s+//g;
    die "token $p: empty\n" unless length $tok;
    $a->{token}      = $tok;
    $a->{q}          = {};      # sid => [queued pico frames]
    $a->{ws}         = {};      # sid => Mojo::Transaction::WebSocket
    $a->{ws_pending} = {};
    $a->{sessions}   = {};      # sid => { from, content, flushed, echo }
    $a->{await}      = {};      # mate id => session that asked them
    $a->{n}          = 0;
    $a->{hbuf}       = '';
}

my $ua = Mojo::UserAgent->new;
$ua->connect_timeout(10);
$ua->request_timeout(0);
$ua->inactivity_timeout(90);
$ua->max_redirects(0);

# Card file lives under dir/, not the state root. /var/picobus is root-owned
# and not writable by _picobus; secrets sit beside it. dir/ is 0750 _picobus:_picobus.
my $DIR_FILE = $ENV{PICO_DIRECTORY} // '/var/picobus/dir/directory.json';
my $POLL     = $ENV{PICO_POLL}      // 20;
my $HUB_LOG  = $ENV{HUB_LOG}        // '/var/picobus/hub-events.ndjson';
# Flags sit beside the directory file. /var/picobus itself is not writable
# by _picobus; dir/ is.
my $GREET_DIR = $ENV{PICO_GREET_DIR} // do {
    my $d = $DIR_FILE;
    $d =~ s{/[^/]+\z}{};
    $d = '.' if $d eq $DIR_FILE;
    "$d/greet";
};
my $GREET_RETRY = $ENV{PICO_GREET_RETRY} // 600;
$GREET_RETRY = 600 if $GREET_RETRY !~ /^\d+\z/ || $GREET_RETRY < 1;
my $GREET_TIMEOUT = $ENV{PICO_GREET_TIMEOUT} // 90;
$GREET_TIMEOUT = 90 if $GREET_TIMEOUT !~ /^\d+\z/ || $GREET_TIMEOUT < 1;
# The model already has these files in its prompt. Ask once; do not loop.
my $GREET_PROMPT = 'This is your one-time introduction. '
    . 'Study IDENTITY.md, SOUL.md, USER.md, AGENT.md, and the skills '
    . 'already in your workspace. Reply with one sentence about what you '
    . 'expect to be doing. Do not ask a question.';
$POLL = 20 if !$POLL || $POLL < 1;

my %cards;
my $digest = '';

sub iso_now {
    my @t = gmtime;
    sprintf("%04d-%02d-%02dT%02d:%02d:%02dZ",
        $t[5] + 1900, $t[4] + 1, $t[3], $t[2], $t[1], $t[0]);
}

sub control_sid {
    my ($agent) = @_;
    return 'pb.' . $agent->{id};
}

sub card_digest {
    my @parts;
    for my $id (sort keys %cards) {
        my $c = $cards{$id};
        push @parts, join("\t", $id, $c->{nick} // '', $c->{role} // '');
    }
    return join("\n", @parts);
}

sub endpoint_list {
    my @out;
    for my $id (sort keys %cards) {
        my $c = $cards{$id};
        push @out, {
            id       => $id,
            nick     => $c->{nick},
            role     => $c->{role},
            host     => $c->{host} // '',
            port     => 0 + ($c->{port} // 0),
            health   => $c->{health} // 'unknown',
            ready    => $c->{ready} // 'unknown',
            pid      => $c->{pid},
            seen     => $c->{seen} // '',
            presence => $c->{presence} // 'down',
        };
    }
    return \@out;
}

sub save_directory {
    my $body = encode_json({
        digest    => $digest,
        endpoints => endpoint_list(),
    });
    my $tmp = "$DIR_FILE.tmp.$$";
    if (open my $fh, '>', $tmp) {
        print $fh $body, "\n";
        close $fh;
        if (rename $tmp, $DIR_FILE) {
            chmod 0640, $DIR_FILE;
            if (my $gid = getgrnam('_picobus')) {
                chown -1, $gid, $DIR_FILE;
            }
        }
        else {
            logmsg("directory rename: $!");
        }
    }
    else {
        logmsg("directory write $tmp: $!");
    }
}

sub load_directory {
    return unless -f $DIR_FILE;
    open my $fh, '<', $DIR_FILE or return;
    local $/;
    my $raw = <$fh> // '';
    close $fh;
    my $obj = eval { decode_json($raw) } or return;
    for my $ep (@{ $obj->{endpoints} || [] }) {
        next unless $ep && ref $ep eq 'HASH' && ($ep->{id} // '') ne '';
        $cards{$ep->{id}} = { %$ep };
    }
    $digest = card_digest();
}

sub send_directory_frame {
    my ($agent) = @_;
    my $sid = control_sid($agent);
    pico_send($agent, $sid, {
        type       => 'directory',
        session_id => $sid,
        payload    => {
            digest    => $digest,
            endpoints => endpoint_list(),
        },
    });
}

sub note_digest {
    my $new = card_digest();
    my $changed = $new ne $digest;
    $digest = $new;
    save_directory();
    return unless $changed;
    logmsg("directory digest changed");
    send_directory_frame($_) for @agents;
}

sub is_our_berth {
    my ($id) = @_;
    return grep { $_->{id} eq $id } @agents;
}

sub skip_peer_id {
    my ($id) = @_;
    return 1 if !defined $id || $id eq '' || $id eq 'all' || $id eq 'human';
    return 1 if $id =~ /^hubctl-\d+$/;
    return 1 if $id =~ /^anon-/;
    return 1 if is_our_berth($id);
    return 0;
}

sub refresh_hub_peers {
    return unless -f $HUB_LOG;
    open my $fh, '<', $HUB_LOG or return;
    my %st;
    while (my $line = <$fh>) {
        my $o = eval { decode_json($line) } or next;
        my $t = $o->{type} // '';
        my $id = $o->{id} // next;
        if ($t eq 'register')    { $st{$id} = 'up' }
        elsif ($t eq 'disconnect') { $st{$id} = 'down' }
    }
    close $fh;
    for my $id (keys %st) {
        next if skip_peer_id($id);
        my $c = $cards{$id} ||= {
            id   => $id,
            nick => $id,
            role => 'human',
            host => '',
            port => 0,
        };
        $c->{presence} = $st{$id};
        $c->{seen} = iso_now();
    }
    note_digest();
}

sub bus_reply {
    my ($agent, $id, $type, $payload) = @_;
    pico_send($agent, control_sid($agent), {
        type       => $type,
        id         => $id,
        session_id => control_sid($agent),
        payload    => $payload,
    });
}

# $tx->result dies when the TCP connect fails. That exception is thrown
# inside an I/O watcher, so Mojo::Reactor::EV exits the whole process.
# One gateway being down must only mark that card down.
sub tx_res {
    my ($tx) = @_;
    return unless $tx;
    my $err = eval { $tx->error };
    if ($err && ref $err eq 'HASH' && !defined $err->{code}) {
        return;
    }
    my $res = eval { $tx->result };
    return if $@ || !$res;
    return $res;
}

sub poll_agent {
    my ($agent) = @_;
    my $base = "http://$agent->{host}:$agent->{port}";
    my $card = $cards{$agent->{id}} ||= {
        id       => $agent->{id},
        host     => $agent->{host},
        port     => 0 + $agent->{port},
        nick     => undef,
        role     => undef,
        presence => 'down',
    };
    $card->{host} = $agent->{host};
    $card->{port} = 0 + $agent->{port};
    $ua->get("$base/health" => sub {
        my ($ua, $tx) = @_;
        my $res = tx_res($tx);
        if ($res && $res->is_success) {
            my $j = eval { decode_json($res->body) } || {};
            $card->{health}   = $j->{status} // 'ok';
            $card->{pid}      = $j->{pid} if defined $j->{pid};
            $card->{presence} = 'up';
        }
        else {
            $card->{health}   = 'down';
            $card->{presence} = 'down';
            $card->{seen}     = iso_now();
            note_digest();
            return;
        }
        $card->{seen} = iso_now();
        $ua->get("$base/ready" => sub {
            my ($ua, $tx) = @_;
            my $res = tx_res($tx);
            if ($res && $res->is_success) {
                my $j = eval { decode_json($res->body) } || {};
                $card->{ready} = $j->{status} // 'ready';
            }
            else {
                $card->{ready} = 'unknown';
            }
            $ua->get("$base/beacon" => sub {
                my ($ua, $tx) = @_;
                my $res = tx_res($tx);
                if ($res && $res->is_success) {
                    my $j = eval { decode_json($res->body) } || {};
                    if (!defined $j->{id} || $j->{id} eq $agent->{id}) {
                        $card->{nick} = $j->{nick} if defined $j->{nick} && $j->{nick} ne '';
                        $card->{role} = $j->{role} if defined $j->{role} && $j->{role} ne '';
                    }
                }
                elsif ($res && ($res->code // 0) == 404) {
                    $card->{nick} = undef;
                    $card->{role} = undef;
                }
                note_digest();
            });
        });
    });
}

sub endpoint_up {
    my ($id) = @_;
    refresh_hub_peers() unless is_our_berth($id);
    my $c = $cards{$id} or return 0;
    return 0 unless ($c->{presence} // '') eq 'up';
    if (is_our_berth($id)) {
        return ($c->{health} // '') eq 'ok';
    }
    return 1;
}

sub sid_for {
    my ($from) = @_;
    $from = 'anon' unless defined $from && $from ne '';
    $from =~ s/[^A-Za-z0-9_.-]+/_/g;
    return "pb.$from";
}

sub greet_sid {
    my ($agent) = @_;
    return 'pb.greet.' . $agent->{id};
}

sub greet_flag {
    my ($agent) = @_;
    return "$GREET_DIR/$agent->{id}";
}

sub greet_done {
    my ($agent) = @_;
    return -f greet_flag($agent);
}

# A missing key or a parroted prompt is not an introduction.
sub greet_bad {
    my ($s) = @_;
    return 1 if $s =~ /one-time introduction/;
    return 1 if $s =~ /api[_ ]key|not configured|no model|unauthorized|model not found/i;
    return 0;
}

sub greet_clear_timer {
    my ($agent) = @_;
    if ($agent->{greet_timer}) {
        Mojo::IOLoop->remove($agent->{greet_timer});
        $agent->{greet_timer} = undef;
    }
}

sub greet_mark {
    my ($agent) = @_;
    mkdir $GREET_DIR, 0750 unless -d $GREET_DIR;
    my $path = greet_flag($agent);
    if (open my $fh, '>', $path) {
        print $fh "1\n";
        close $fh;
        chmod 0640, $path;
        logmsg("$agent->{id} greet recorded");
        return 1;
    }
    logmsg("$agent->{id} greet flag: $!");
    return 0;
}

# Failure leaves the flag unset. The next try is one later turn, not a loop.
sub greet_fail {
    my ($agent, $why) = @_;
    return unless $agent->{greet_inflight};
    $agent->{greet_inflight} = 0;
    greet_clear_timer($agent);
    logmsg("$agent->{id} greet not sent ($why)");
    return if greet_done($agent);
    return if $agent->{greet_wait};
    $agent->{greet_wait} = Mojo::IOLoop->timer($GREET_RETRY => sub {
        $agent->{greet_wait} = undef;
        maybe_greet($agent);
    });
}

sub maybe_greet {
    my ($agent) = @_;
    return unless $agent->{hub};
    return unless $agent->{ws}{ control_sid($agent) };
    return if greet_done($agent);
    return if $agent->{greet_inflight};
    return if $agent->{greet_wait};
    $agent->{greet_inflight} = 1;
    my $sid = greet_sid($agent);
    my $st = $agent->{sessions}{$sid} ||= {};
    $st->{from}    = 'human';
    $st->{greet}   = 1;
    $st->{echo}    = 0;
    $st->{content} = '';
    $st->{flushed} = '';
    pico_send($agent, $sid, {
        type       => 'message.send',
        id         => 'pb-greet-' . $agent->{id},
        session_id => $sid,
        payload    => { content => $GREET_PROMPT },
    });
    greet_clear_timer($agent);
    $agent->{greet_timer} = Mojo::IOLoop->timer($GREET_TIMEOUT => sub {
        greet_fail($agent, 'timeout');
    });
    logmsg("$agent->{id} greet once");
}

sub thoughtish {
    my ($pl) = @_;
    return 1 unless $pl && ref $pl eq 'HASH';
    return 1 if $pl->{placeholder};
    my $kind = lc($pl->{kind} // '');
    return 1 if $kind eq 'thought' || $kind eq 'tool_calls';
    return 1 if $pl->{thought};
    return 0;
}

sub hub_write {
    my ($agent, $obj) = @_;
    my $stream = $agent->{hub} or return;
    eval { $stream->write(encode_json($obj) . "\n") };
}

sub pico_send {
    my ($agent, $sid, $hash) = @_;
    if (my $tx = $agent->{ws}{$sid}) {
        $tx->send({ json => $hash });
        return;
    }
    my $q = $agent->{q}{$sid} ||= [];
    push @$q, $hash;
    shift @$q while @$q > 20;
    connect_ws($agent, $sid);
}

sub flush_session {
    my ($agent, $sid, $why) = @_;
    my $st = $agent->{sessions}{$sid} or return;
    my $content = $st->{content} // '';
    return unless length $content;
    return if ($st->{flushed} // '') eq $content;
    # A reply to an echoed reply would ping-pong. Drop it. The model still
    # saw the inbound text. bus.send does not set echo, so a new question
    # still gets one answer.
    if ($st->{echo}) {
        $st->{flushed} = $content;
        logmsg("$agent->{id} drop echo reply -> " . ($st->{from} // '') . " ($why)");
        return;
    }
    # One introduction. Later chunks of the same turn are not a second hello.
    if ($st->{greet}) {
        return if greet_done($agent);
        unless ($agent->{hub}) {
            greet_fail($agent, 'hub down');
            return;
        }
        if (greet_bad($content)) {
            $st->{flushed} = $content;
            greet_fail($agent, 'model');
            return;
        }
        hub_write($agent, {
            type    => 'message',
            from    => $agent->{id},
            to      => 'human',
            content => $content,
        });
        $st->{flushed} = $content;
        $agent->{greet_inflight} = 0;
        greet_clear_timer($agent);
        # A failed flag write is retried on the next bridge start.
        greet_mark($agent);
        logmsg("$agent->{id} greet -> human ($why) bytes=" . length($content));
        return;
    }
    my $to = $st->{from} // '';
    return unless length $to;
    if ($st->{crew}) {
        # Work the operator handed across the crew is spoken for the operator.
        # The mate who passed it on gets a copy only when they asked for one.
        if ($st->{handoff}) {
            hub_write($agent, {
                type    => 'message',
                from    => $agent->{id},
                to      => 'human',
                content => $content,
            });
            if ($st->{report}) {
                hub_write($agent, {
                    type    => 'message',
                    from    => $agent->{id},
                    to      => $to,
                    content => $content,
                    echo    => 1,
                });
                logmsg("$agent->{id} report -> $to ($why) bytes=" . length($content));
            }
            $st->{flushed} = $content;
            logmsg("$agent->{id} reply -> operator ($why) bytes=" . length($content));
            return;
        }
        # A shipmate asked. The answer goes to that shipmate. reply stops
        # their bridge from opening another round off this answer.
        hub_write($agent, {
            type    => 'message',
            from    => $agent->{id},
            to      => $to,
            content => $content,
            reply   => 1,
        });
        $st->{flushed} = $content;
        logmsg("$agent->{id} reply -> $to ($why) bytes=" . length($content));
        return;
    }
    hub_write($agent, {
        type    => 'message',
        from    => $agent->{id},
        to      => $to,
        content => $content,
        echo    => 1,
    });
    $st->{flushed} = $content;
    logmsg("$agent->{id} reply -> $to ($why) bytes=" . length($content));
}

sub mate_label {
    my ($id) = @_;
    return 'a shipmate' unless defined $id && $id ne '';
    my $nick = '';
    if (my $c = $cards{$id}) {
        $nick = $c->{nick} // '';
    }
    return $nick if $nick ne '';
    return ucfirst $id;
}

# "tell chief to …" / "ask the chief to …" / "have chief …" / "get chief to …".
# Returns the other mate's id, or the empty string.
sub delegation_target {
    my ($agent, $content) = @_;
    return '' unless defined $content;
    return '' unless $content =~ /\b(?:tell|ask|have|get)\s+(?:the\s+)?([A-Za-z][A-Za-z0-9]{0,15})\b/i;
    my $id = lc $1;
    return '' if $id eq $agent->{id} || $id eq 'me';
    return '' unless is_our_berth($id);
    return $id;
}

# handoff: "tell|ask|have|get <mate> to <work>", and have/get without "to".
# The worker states the result for the operator.
# converse: "ask <mate> for|about|what …". The preposition is the question.
# The other mate receives one sentence and answers the asker.
# Words before the wrapper ("are you there yet?") are not the work.
sub delegation_plan {
    my ($agent, $content) = @_;
    my $mate = delegation_target($agent, $content);
    return () unless $mate ne '';
    my $task = $content // '';
    return () unless $task =~ /\b(tell|ask|have|get)\s+(?:the\s+)?\Q$mate\E\b\s*(.*)\z/is;
    my $verb = lc $1;
    my $rest = $2 // '';
    $rest =~ s/\A\s+|\s+\z//g;
    my $infinitive = ($rest =~ s/\Ato\s+//i) ? 1 : 0;
    $rest =~ s/\A\s+//;
    return () if $rest eq '';
    my $kind = ($verb eq 'have' || $verb eq 'get' || $infinitive) ? 'handoff' : 'converse';
    if ($kind eq 'converse') {
        my $who = mate_label($agent->{id});
        my $q = $rest;
        $q =~ s/[.?!]+\z//;
        if ($q =~ /\A(?:who|what|when|where|why|how|whether|which)\b/i) {
            $rest = $q . '?';
        } else {
            $rest = "$who asks: $q.";
        }
    }
    return ($kind, $mate, $rest);
}

sub handle_pico {
    my ($agent, $msg) = @_;
    return unless $msg && ref $msg eq 'HASH';
    my $type = $msg->{type} // '';
    my $sid  = $msg->{session_id} // '';
    if ($type eq 'activity') {
        my $pl = $msg->{payload};
        $pl = {} unless $pl && ref $pl eq 'HASH';
        my $st = $pl->{state} // '';
        return unless $st eq 'thinking' || $st eq 'idle';
        hub_write($agent, { type => 'activity', activity => $st });
        return;
    }
    if ($type eq 'bus.send') {
        my $pl      = $msg->{payload} || {};
        my $to      = $pl->{to} // '';
        my $content = $pl->{content} // '';
        my $mid     = $msg->{id} // '';
        if ($to eq '' || $to eq $agent->{id} || !length $content) {
            bus_reply($agent, $mid, 'bus.error', { to => $to, error => 'bad request' });
            return;
        }
        unless (endpoint_up($to)) {
            bus_reply($agent, $mid, 'bus.error', { to => $to, error => 'unreachable' });
            logmsg("$agent->{id} bus.send to=$to unreachable");
            return;
        }
        hub_write($agent, {
            type    => 'message',
            from    => $agent->{id},
            to      => $to,
            content => $content,
        });
        bus_reply($agent, $mid, 'bus.ack', { to => $to });
        logmsg("$agent->{id} bus.send to=$to bytes=" . length($content));
        return;
    }
    if ($type eq 'error') {
        my $pl = $msg->{payload} || {};
        logmsg("$agent->{id} pico error: " . ($pl->{message} // $pl->{code} // '?'));
        greet_fail($agent, 'pico') if $sid ne '' && $sid eq greet_sid($agent);
        return;
    }
    if ($type eq 'typing.stop') {
        flush_session($agent, $sid, 'typing.stop') if $sid;
        return;
    }
    return unless $type eq 'message.create' || $type eq 'message.update';
    my $pl = $msg->{payload} || {};
    return if thoughtish($pl);
    my $content = $pl->{content} // '';
    return unless length $content;
    return unless $sid;
    my $st = $agent->{sessions}{$sid} ||= {};
    $st->{content} = $content;    # Pico streams full accumulated text
    if ($agent->{idle}{$sid}) {
        Mojo::IOLoop->remove($agent->{idle}{$sid});
    }
    $agent->{idle}{$sid} = Mojo::IOLoop->timer($IDLE_FLUSH => sub {
        delete $agent->{idle}{$sid};
        flush_session($agent, $sid, 'idle');
    });
}

sub handle_hub_line {
    my ($agent, $line) = @_;
    return unless length $line;
    my $obj = eval { decode_json($line) };
    return unless $obj && ref $obj eq 'HASH';
    my $type = $obj->{type} // '';
    return if $type eq 'register' || $type eq 'disconnect' || $type eq 'ack';
    if ($type eq 'error') {
        logmsg("$agent->{id} hub error: " . ($obj->{msg} // '?'));
        return;
    }
    return unless $type eq 'message';
    my $from = $obj->{from} // '';
    return if $from eq '' || $from eq $agent->{id};
    my $content = $obj->{content} // $obj->{body} // '';
    return unless length $content;
    my $sid = sid_for($from);
    # The answer to a question this mate asked. File it in the session that
    # asked, and do not open another round. The chat line is already addressed
    # to this mate.
    if ($obj->{reply} && is_our_berth($from)) {
        my $back = delete $agent->{await}{$from};
        my $dest = (defined $back && $back ne '') ? $back : $sid;
        my $w = $agent->{sessions}{$dest} ||= {};
        if ($agent->{idle}{$dest}) {
            Mojo::IOLoop->remove($agent->{idle}{$dest});
            delete $agent->{idle}{$dest};
        }
        $w->{echo}    = 1;
        $w->{greet}   = 0;
        $w->{crew}    = 0;
        $w->{handoff} = 0;
        $w->{report}  = 0;
        $w->{content} = '';
        $w->{flushed} = '';
        my $who = mate_label($from);
        pico_send($agent, $dest, {
            type       => 'message.send',
            id         => 'pb-' . $agent->{id} . '-' . ++$agent->{n},
            session_id => $dest,
            payload    => {
                content => "[bus from=$from] $who answered you. "
                    . "Keep this for your next order. "
                    . "Do not send a reply to this line.\n\n"
                    . $content,
            },
        });
        logmsg("$agent->{id} heard $from bytes=" . length($content));
        return;
    }
    my $st = $agent->{sessions}{$sid} ||= {};
    if ($agent->{idle}{$sid}) {
        Mojo::IOLoop->remove($agent->{idle}{$sid});
        delete $agent->{idle}{$sid};
    }
    # New inbound owns this session. Drop any unflushed text from the
    # previous turn so it cannot ship under the new echo bit.
    $st->{from}    = $from;
    $st->{echo}    = $obj->{echo} ? 1 : 0;
    $st->{content} = '';
    $st->{flushed} = '';
    $st->{greet}   = 0;
    $st->{crew}    = is_our_berth($from) ? 1 : 0;
    $st->{handoff} = ($st->{crew} && $obj->{handoff}) ? 1 : 0;
    $st->{report}  = ($st->{handoff} && $content =~ /report the answer back/i) ? 1 : 0;
    my $spoken = $content;
    if ($st->{crew}) {
        my $who = mate_label($from);
        if ($st->{handoff}) {
            $spoken = "$who passed on work from the operator. "
                . "State what was asked and your answer for the operator. "
                . "This reply is for the operator. "
                . ($st->{report}
                    ? "They asked you to report the answer back, so include the full answer. "
                    : "Do not address the reply to $who. ")
                . "Name the work, not a program.\n\n"
                . $content;
        } else {
            $spoken = "$who asked you this. Answer $who, by name, as a shipmate. "
                . "This reply is for $who. "
                . "Name the work, not a program.\n\n"
                . $content;
        }
    }
    elsif (my ($kind, $mate, $task) = delegation_plan($agent, $content)) {
        if ($kind eq 'handoff'
            && $content =~ /\b(?:tell me|let me know|report back|bring me|want the answer)\b/i
            && $task !~ /report the answer back/i) {
            $task .= "\nReport the answer back.";
        }
        my $out = {
            type    => 'message',
            from    => $agent->{id},
            to      => $mate,
            content => $task,
        };
        $out->{handoff} = 1 if $kind eq 'handoff';
        hub_write($agent, $out);
        logmsg("$agent->{id} pass to $mate $kind bytes=" . length($task));
        my $who = mate_label($mate);
        if ($kind eq 'converse') {
            $agent->{await}{$mate} = $sid;
            $spoken = "You asked $who a question. "
                . "Reply with one short sentence that you asked them. "
                . "They will answer you. Do not invent their answer.\n\n"
                . $task;
        } else {
            $spoken = "The operator asked you to have $who do this. "
                . "Reply with one short sentence that you asked them. "
                . "Do not quote an answer. Do not invent a result. "
                . "They state the result in their own chat.\n\n"
                . $task;
        }
    }
    # Pico binds the WS connection to ?session_id=; replies go only to
    # connections in that session. Message session_id must match.
    pico_send($agent, $sid, {
        type       => 'message.send',
        id         => 'pb-' . $agent->{id} . '-' . ++$agent->{n},
        session_id => $sid,
        payload    => { content => "[bus from=$from] $spoken" },
    });
    logmsg("$agent->{id} inject from=$from sid=$sid bytes=" . length($content));
}

sub connect_hub {
    my ($agent) = @_;
    if ($agent->{hub}) {
        eval { $agent->{hub}->close };
        $agent->{hub} = undef;
    }
    unless (-S $HUB_SOCK) {
        Mojo::IOLoop->timer(1 => sub { connect_hub($agent) });
        return;
    }
    Mojo::IOLoop->client(path => $HUB_SOCK => sub {
        my ($loop, $err, $stream) = @_;
        if ($err || !$stream) {
            logmsg("$agent->{id} hub connect: " . ($err // 'no stream'));
            Mojo::IOLoop->timer(2 => sub { connect_hub($agent) });
            return;
        }
        $agent->{hub}  = $stream;
        $agent->{hbuf} = '';
        $stream->timeout(0);
        $stream->write(encode_json({ type => 'register', id => $agent->{id} }) . "\n");
        $stream->on(read => sub {
            my ($stream, $bytes) = @_;
            $agent->{hbuf} .= $bytes;
            while ($agent->{hbuf} =~ s/^(.*?)\n//) {
                handle_hub_line($agent, $1);
            }
        });
        $stream->on(close => sub {
            logmsg("$agent->{id} hub closed");
            $agent->{hub} = undef;
            Mojo::IOLoop->timer(1 => sub { connect_hub($agent) });
        });
        $stream->on(error => sub {
            my ($stream, $err) = @_;
            logmsg("$agent->{id} hub error $err");
        });
        logmsg("$agent->{id} registered on hub");
        maybe_greet($agent);
    });
}

sub connect_ws {
    my ($agent, $sid) = @_;
    $sid ||= 'pb.' . $agent->{id};
    return if $agent->{ws}{$sid} || $agent->{ws_pending}{$sid};
    $agent->{ws_pending}{$sid} = 1;
    my $url = "ws://$agent->{host}:$agent->{port}/pico/ws?session_id=$sid";
    $ua->websocket(
        $url => { Authorization => "Bearer $agent->{token}" } => sub {
            my ($ua, $tx) = @_;
            delete $agent->{ws_pending}{$sid};
            unless ($tx->is_websocket) {
                my $code = $tx->res->code // 0;
                logmsg("$agent->{id} ws upgrade failed sid=$sid code=$code");
                Mojo::IOLoop->timer(3 => sub { connect_ws($agent, $sid) });
                return;
            }
            $agent->{ws}{$sid} = $tx;
            logmsg("$agent->{id} pico ws up sid=$sid");
            if ($sid eq control_sid($agent)) {
                send_directory_frame($agent);
                maybe_greet($agent);
            }
            while (my $hash = shift @{ $agent->{q}{$sid} || [] }) {
                $tx->send({ json => $hash });
            }
            $tx->on(json => sub {
                my ($tx, $hash) = @_;
                $hash->{session_id} ||= $sid if $hash && ref $hash eq 'HASH';
                handle_pico($agent, $hash);
            });
            $tx->on(finish => sub {
                my ($tx, $code) = @_;
                logmsg("$agent->{id} ws finished sid=$sid code=" . ($code // ''));
                delete $agent->{ws}{$sid};
                if ($sid eq greet_sid($agent)) {
                    greet_fail($agent, 'ws closed');
                }
                if ($agent->{ping}{$sid}) {
                    Mojo::IOLoop->remove($agent->{ping}{$sid});
                    delete $agent->{ping}{$sid};
                }
                Mojo::IOLoop->timer(1 => sub { connect_ws($agent, $sid) });
            });
            $agent->{ping}{$sid} = Mojo::IOLoop->recurring(25 => sub {
                my $w = $agent->{ws}{$sid} or return;
                $w->send({ json => { type => 'ping', id => 'pb-ping' } });
            });
        }
    );
}

load_directory();

for my $a (@agents) {
    connect_hub($a);
    connect_ws($a, control_sid($a));
    poll_agent($a);
}

Mojo::IOLoop->recurring($POLL => sub {
    poll_agent($_) for @agents;
    refresh_hub_peers();
});

logmsg("watching " . join(',', map { $_->{id} } @agents));
Mojo::IOLoop->start;
